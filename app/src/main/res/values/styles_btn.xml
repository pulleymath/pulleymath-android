<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="L">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">160dp</item>
    </style>

    <style name="M">
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_width">120dp</item>
    </style>

    <style name="Primary.L" parent="L">
        <item name="android:textSize">@dimen/sp16</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>

    <style name="Primary.M" parent="M">
        <item name="android:textSize">@dimen/sp16</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>


    <style name="Btn_Blue.Primary.L" parent="Primary.L">
        <item name="android:background">@drawable/bg_purple_300_round_ripple</item>
    </style>


    <style name="Btn_Orange.Primary.M" parent="Primary.M">
        <item name="android:background">@drawable/bg_yellow_300_round</item>
    </style>


    <style name="Secondary.L" parent="Primary.L"/>


    <style name="Btn_Grey.Secondary.L" parent="Secondary.L">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textColor">@color/gray_800</item>
        <item name="android:background">@drawable/bg_gray_200_round_ripple</item>
    </style>

</resources>