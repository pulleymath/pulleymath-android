    </style>

    <style name="Border_Black_4c4c4c_Vertical">
        <item name="android:background">@color/black_4c4c4c</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>
    <style name="Border_Black_4c4c4c_Horizontal">
        <item name="android:background">@color/black_4c4c4c</item>
        <item name="android:layout_height">1dp</item>
