    </style>

    <style name="Border_Grey_3d3d3d_Horizontal">
        <item name="android:background">@color/grey_3d3d3d</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Border_Grey_3d3d3d_Vertical">
        <item name="android:background">@color/grey_3d3d3d</item>
        <item name="android:layout_height">match_parent</item>
