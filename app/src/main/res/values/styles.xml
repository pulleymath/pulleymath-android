<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlHighlight">@color/controlHighlight</item>

        <item name="android:textViewStyle">@style/DefaultTextViewStyle</item>
        <item name="android:buttonStyle">@style/DefaultButtonStyle</item>
        <item name='android:checkboxStyle'>@style/DefaultCheckBoxStyle</item>
        <item name='android:radioButtonStyle'>@style/DefaultRadioButtonStyle</item>
        <item name="android:switchStyle">@style/Switch</item>

<!--        <item name="alertDialogTheme">@style/DialogTheme</item>-->
<!--        <item name="android:alertDialogTheme">?alertDialogTheme</item>-->
<!--        <item name="dialogTheme">@style/DialogTheme</item>-->
<!--        <item name="android:dialogTheme">@style/DialogTheme</item>-->
    </style>

    <style name="DialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
<!--    <style name="DialogTheme" parent="Theme.AppCompat.DayNight.Dialog.MinWidth">-->
<!--        <item name="android:buttonStyle">@style/DefaultButtonStyle2</item>-->
    </style>

    <style name="CalenderViewCustom" parent="Theme.AppCompat">
        <item name="colorAccent">@color/purple_300</item>
        <item name="colorPrimary">@color/gray_800</item>
        <item name="android:textColorPrimary">@color/gray_800</item>
        <item name="colorControlActivated">@color/purple_100</item>
        <item name="android:textColorPrimaryInverse">@color/red_300</item>
    </style>

    <style name="CalenderViewDateCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/gray_800</item>
        <item name="android:headerYearTextAppearance">@color/gray_800</item>
    </style>

    <style name="CalenderViewWeekCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/gray_800</item>
    </style>

    <style name ="DefaultTextViewStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/sp18</item>
    </style>

    <style name="DefaultButtonStyle" parent="android:Widget.Holo.Button">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/sp18</item>
    </style>
<!--        <item name="android:textColor">@color/purple_6D6DFF</item>-->

    <style name="DefaultCheckBoxStyle" parent="android:Widget.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:button">@drawable/checkbox_blue</item>
    </style>

    <style name="DefaultRadioButtonStyle" parent="android:Widget.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:button">@drawable/radio_default</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="AppTheme.Toolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:background">@color/grey_e0e0e0</item>
        <item name="android:elevation">15dp</item>
    </style>

    <style name="AppTheme.Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textColor">@color/black_4c4c4c</item>
    </style>

    <style name="AppTheme.TabToolbar" parent="android:Theme.Holo">
        <item name="android:layout_height">@dimen/dp56</item>
        <item name="android:background">@color/black_200</item>
        <item name="android:elevation">8dp</item>
    </style>

    <style name="AppTheme.TabBar">
    </style>

    <style name="AppTheme.TabBar.TabText">
        <item name="android:textSize">@dimen/sp16</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="AppTheme.TabBar.TabText.18">
        <item name="android:textSize">@dimen/sp18</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--OMR 관련-->
    <style name="OMR_horizontal_border">
        <item name="android:layout_height">@dimen/omr_answer_borderWidth</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@color/red_ffc6bc</item>
    </style>

    <style name="OMR_Vertical_border">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">@dimen/omr_answer_borderWidth</item>
        <item name="android:background">@color/red_ffc6bc</item>
    </style>

    <style name="Keypad_btn" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_gray_200_round</item>
        <item name="android:textColor">@color/grey_818181</item>
        <item name="android:textSize">@dimen/sp24</item>
    </style>

    <style name="Cooking_Keypad_btn" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_gray_200_round</item>
        <item name="android:textColor">@color/gray_700</item>
        <item name="android:textSize">@dimen/sp24</item>
        <item name="android:fontFamily">@font/font_pretendard_regular</item>
    </style>

    <style name="OMR_radio_button" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="colorAccent">@color/purple_ACACFF</item>
        <item name="android:colorControlNormal">#f8f8f8</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat</item>
    </style>


    <style name="Border_Grey_e8e8e8_Horizontal">
        <item name="android:background">@color/grey_e8e8e8</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>
    <style name="Border_Gray_400_Horizontal">
        <item name="android:background">@color/gray_400</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Border_Grey_e8e8e8_Vertical">
        <item name="android:background">@color/grey_e8e8e8</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>

    <style name="Border_Grey_818181_Vertical">
        <item name="android:background">@color/grey_818181</item>
        <item name="android:layout_height">match_parent</item>
