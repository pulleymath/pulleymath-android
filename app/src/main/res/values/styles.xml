    </style>

    <style name="Border_Blue_30a4ff_Horizontal">
        <item name="android:background">@color/purple_6D6DFF</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="CustomBackgroundDialog" parent="android:Theme.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textOff">""</item>
        <item name="android:textOn">""</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
    </style>

    <style name="Switch.Light" parent="Switch">
        <item name="android:textOff">""</item>
        <item name="android:textOn">""</item>
        <item name="android:track">@drawable/switch_track_light</item>
        <item name="android:thumb">@drawable/switch_thumb_light</item>
    </style>

    <style name="Switch.Grey" parent="Switch">
        <item name="android:textOff">""</item>
        <item name="android:textOn">""</item>
        <item name="android:track">@drawable/switch_track_grey</item>
        <item name="android:thumb">@drawable/switch_thumb_light</item>
    </style>
<!--        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>-->

    <style name="Theme.Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textViewStyle">@style/DefaultTextViewStyle</item>
        <item name="android:buttonStyle">@style/DefaultButtonStyle</item>
        <item name='android:checkboxStyle'>@style/DefaultCheckBoxStyle</item>
        <item name='android:radioButtonStyle'>@style/DefaultRadioButtonStyle</item>
        <item name="android:switchStyle">@style/Switch</item>
        <item name="android:windowFullscreen">true</item>
    </style>
<!--    <style name="LoginTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">-->
    <style name="ThemeOverlay.AppTheme.TextInputEditText.Outlined" parent="">

<!--                <item name="colorPrimary">#6d6dff</item>-->
<!--                <item name="colorControlActivated">#6d6dff</item>-->

        <!--테두리 색상-->
        <item name="colorPrimary">@color/purple_6D6DFF</item>
<!--        <item name="boxStrokeColor">@color/purple_6D6DFF</item>-->
        <!--cursor 색.-->
        <item name="colorControlActivated">@color/purple_6D6DFF</item>
<!--        <item name="android:textCursorDrawable">@drawable/text_input_layout_cursor</item>-->
        <!--Counter-->
        <item name="counterTextAppearance">@style/CounterTextAppearance</item>
        <!--EditText에 있을때의 Hint-->
        <item name="android:textColorHint">@color/grey_c0c0c0</item>
        <!--상단에 있을때의 Hint-->
        <item name="hintTextColor">@color/purple_6D6DFF</item>
        <item name="hintTextAppearance">@style/HintTextAppearance</item>
        <!--Helper-->
        <item name="helperTextTextAppearance">@style/HelperTextAppearance</item>
        <!--Error-->
        <item name="errorEnabled">false</item>
        <item name="colorError">@color/red_300</item>
        <item name="errorIconDrawable">@android:color/transparent</item>
        <item name="errorTextAppearance">@style/ErrorTextAppearance</item>

        <item name="boxCornerRadiusBottomEnd">5dp</item>
        <item name="boxCornerRadiusTopEnd">5dp</item>
        <item name="boxCornerRadiusBottomStart">5dp</item>
        <item name="boxCornerRadiusTopStart">5dp</item>

    </style>

    <style name="ErrorTextAppearance">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HintTextAppearance">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HelperTextAppearance">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">1sp</item>
    </style>

    <style name="CounterTextAppearance">
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextInputEditTextStyle">
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black_4c4c4c </item>
    </style>

    <style name="TransparentFragmentDialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
