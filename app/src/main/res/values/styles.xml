<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textViewStyle">@style/DefaultTextViewStyle</item>
        <item name="android:buttonStyle">@style/DefaultButtonStyle</item>
        <item name='android:checkboxStyle'>@style/DefaultCheckBoxStyle</item>
        <item name='android:radioButtonStyle'>@style/DefaultRadioButtonStyle</item>
        <item name="android:switchStyle">@style/Switch</item>
    </style>

    <style name ="DefaultTextViewStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/font_nanum_square</item>
    </style>

    <style name="DefaultButtonStyle" parent="android:Widget.Holo.Button">
        <item name="android:fontFamily">@font/font_nanum_square</item>
        <item name="android:textColor">@color/purple_6D6DFF</item>
    </style>

    <style name="DefaultCheckBoxStyle" parent="android:Widget.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/font_nanum_square</item>
        <item name="android:button">@drawable/checkbox_blue</item>
    </style>

    <style name="DefaultRadioButtonStyle" parent="android:Widget.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/font_nanum_square</item>
        <item name="android:button">@drawable/radio_default</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="AppTheme.Toolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:background">@color/grey_e0e0e0</item>
        <item name="android:elevation">15dp</item>
    </style>

    <style name="AppTheme.Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/font_nanum_square_extra_bold</item>
        <item name="android:textColor">@color/black_4c4c4c</item>
    </style>

    <style name="AppTheme.TabToolbar" parent="android:Theme.Holo">
        <item name="android:layout_height">@dimen/dp56</item>
        <item name="android:background">@color/black_333333</item>
        <item name="android:elevation">8dp</item>
    </style>

    <style name="AppTheme.TabBar">
    </style>

    <style name="AppTheme.TabBar.TabText">
        <item name="android:textSize">@dimen/sp16</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="AppTheme.TabBar.TabText.18">
        <item name="android:textSize">@dimen/sp18</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--OMR 관련-->
    <style name="OMR_horizontal_border">
        <item name="android:layout_height">@dimen/omr_answer_borderWidth</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@color/red_ffc6bc</item>
    </style>

    <style name="OMR_Vertical_border">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">@dimen/omr_answer_borderWidth</item>
        <item name="android:background">@color/red_ffc6bc</item>
    </style>

    <style name="Keypad_btn" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_grey_f2f2f2_round</item>
        <item name="android:textColor">@color/grey_818181</item>
        <item name="android:textSize">@dimen/sp24</item>
    </style>

    <style name="OMR_radio_button" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="colorAccent">@color/purple_ACACFF</item>
        <item name="android:colorControlNormal">#f8f8f8</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat</item>
    </style>

    <style name="Border_Grey_cccccc_Vertical">
        <item name="android:background">@color/grey_cccccc</item>
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="Border_Grey_cccccc_Horizontal">
        <item name="android:background">@color/grey_cccccc</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Border_Grey_f2f2f2_Horizontal">
        <item name="android:background">@color/grey_f2f2f2</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Border_Grey_e8e8e8_Horizontal">
        <item name="android:background">@color/grey_e8e8e8</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Border_Grey_e8e8e8_Vertical">
        <item name="android:background">@color/grey_e8e8e8</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>

    <style name="Border_Grey_818181_Vertical">
        <item name="android:background">@color/grey_818181</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>

    <style name="Border_Purple_6e6cff_Vertical">
        <item name="android:background">@color/purple_6e6cff</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>

    <style name="Border_Grey_c0c0c0_Vertical">
        <item name="android:background">@color/grey_c0c0c0</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>

    <style name="Border_Grey_c0c0c0_Horizontal">
        <item name="android:background">@color/grey_c0c0c0</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Border_Black_4c4c4c_Vertical">
        <item name="android:background">@color/black_4c4c4c</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>
    <style name="Border_Black_4c4c4c_Horizontal">
        <item name="android:background">@color/black_4c4c4c</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>
    
    <style name="Border_Grey_3d3d3d_Horizontal">
        <item name="android:background">@color/grey_3d3d3d</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Border_Grey_3d3d3d_Vertical">
        <item name="android:background">@color/grey_3d3d3d</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">1dp</item>
    </style>

    <style name="Border_Blue_30a4ff_Horizontal">
        <item name="android:background">@color/purple_6D6DFF</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="CustomBackgroundDialog" parent="android:Theme.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textOff">""</item>
        <item name="android:textOn">""</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
    </style>

    <style name="Switch.Light" parent="Switch">
        <item name="android:textOff">""</item>
        <item name="android:textOn">""</item>
        <item name="android:track">@drawable/switch_track_light</item>
        <item name="android:thumb">@drawable/switch_thumb_light</item>
    </style>

    <style name="Switch.Grey" parent="Switch">
        <item name="android:textOff">""</item>
        <item name="android:textOn">""</item>
        <item name="android:track">@drawable/switch_track_grey</item>
        <item name="android:thumb">@drawable/switch_thumb_light</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textViewStyle">@style/DefaultTextViewStyle</item>
        <item name="android:buttonStyle">@style/DefaultButtonStyle</item>
        <item name='android:checkboxStyle'>@style/DefaultCheckBoxStyle</item>
        <item name='android:radioButtonStyle'>@style/DefaultRadioButtonStyle</item>
        <item name="android:switchStyle">@style/Switch</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/white_ffffff</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.FDialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
