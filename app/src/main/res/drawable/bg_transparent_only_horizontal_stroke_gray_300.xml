<?xml version="1.0" encoding="utf-8"?>

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gray_300">

    <item
        android:bottom="-2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="-2dp">
        <shape android:shape="rectangle" >
            <stroke
                android:width="1dp"
                android:color="@color/gray_300" />

            <solid android:color="@color/white" />
        </shape>
    </item>

</ripple>

