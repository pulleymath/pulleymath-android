<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="90" android:endColor="@color/white" android:startColor="@color/white" android:type="linear" />
                    <stroke android:width="1dp" android:color="#4c4c4c" />
                    <corners android:radius="5dp" />
                    <padding android:bottom="0dp" android:left="3dp" android:right="3dp" android:top="0dp" />
                </shape>
            </item>
            <item
                android:right="@dimen/dp20"
                android:gravity="center_vertical|right"
                android:drawable="@drawable/arrow_bottom_arduous_spinner">
            </item>
        </layer-list>
    </item>
</selector>