<?xml version="1.0" encoding="UTF-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >
    <item android:width="50dp" android:height="10dp" android:right="6dp"
        android:left="5dp">
        <shape>
            <solid android:color="@color/purple_100"/>
        </shape>
    </item>

    <item android:width="7dp" android:height="7dp"
        android:left="50dp">
        <rotate android:fromDegrees="45"
            android:pivotX="0"
            android:pivotY="0">
            <shape>
                <solid android:color="@color/purple_100"/>
            </shape>
        </rotate>
    </item>

    <item android:width="7dp" android:height="7dp"
        android:left="0dp">
        <rotate android:fromDegrees="45"
            android:pivotX="0"
            android:pivotY="0">
            <shape>
                <solid android:color="@color/purple_300"/>
            </shape>
        </rotate>
    </item>

    <item android:width="7dp" android:height="7dp">
        <rotate
            android:fromDegrees="-45"
            android:toDegrees="45"
            android:pivotX="0%"
            android:pivotY="0%" >

            <shape
                android:shape="rectangle" >

                <solid
                    android:color="@color/purple_100"/>
            </shape>
        </rotate>
    </item>

    <item android:width="7dp" android:height="7dp" android:bottom="10dp">
        <rotate
            android:fromDegrees="270"
            android:toDegrees="315"
            android:pivotX="0%"
            android:pivotY="0%" >

            <shape
                android:shape="rectangle" >

                <solid
                    android:color="@color/green_300"/>
            </shape>
        </rotate>
    </item>

</layer-list>