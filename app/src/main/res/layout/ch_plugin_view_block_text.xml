<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/ch_textBlockPrefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/ch_txt_black_darkest"
        android:textSize="@dimen/ch_chat_message_text_size"
        tools:text="• "
        tools:visibility="gone" />

    <com.zoyi.channel.plugin.android.view.textview.EllipsizeTextView
        android:id="@+id/ch_textBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:bufferType="spannable"
        android:ellipsize="end"
        android:textColor="@color/ch_txt_black_darkest"
        android:textSize="@dimen/ch_chat_message_text_size"
        tools:text="asdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasd️" />
</LinearLayout>
