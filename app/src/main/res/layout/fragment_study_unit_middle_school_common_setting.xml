<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white_fafafa"
        android:clickable="true"
        tools:context=".activities.mypage.MySignUpInfoFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white_ffffff">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_toolbar_back"
                android:paddingTop="@dimen/dp32"
                android:paddingStart="@dimen/dp32"
                android:paddingEnd="@dimen/dp32"
                android:paddingBottom="@dimen/dp24"
                android:background="@null"
                app:tint="@color/black_4c4c4c"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View style="@style/Border_Grey_e8e8e8_Horizontal"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/dp24">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                tools:context="com.freewheelin.pulley.activities.learning.tabFragment.main.mypage.StudyCommonUnitSettingFragment">

                <TextView
                    android:id="@+id/titleLabel"
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="풀고 싶은 대단원을 선택해주세요!\n문제를 추천해드릴게요 :)"
                    android:textSize="@dimen/sp18"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lineHeight="@dimen/sp24" />


                <TextView
                    android:id="@+id/guideBottomLabel"
                    style="@style/b2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="일정량의 학습 데이터가 쌓일 때까지 선택한대로 추천됩니다!"
                    android:textColor="@color/purple_300"
                    app:layout_constraintStart_toStartOf="@+id/titleLabel"
                    app:layout_constraintTop_toBottomOf="@+id/titleLabel" />


                <LinearLayout
                    android:id="@+id/selectionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp24"
                    android:layout_marginEnd="@dimen/dp24"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/guideBottomLabel">

                    <com.freewheelin.pulley.revision2023.ui.view.MiddleSchoolUnitSelection
                        android:id="@+id/middle11Selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:unitType="m1-1" />

                    <com.freewheelin.pulley.revision2023.ui.view.MiddleSchoolUnitSelection
                        android:id="@+id/middle12Selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:unitType="m1-2" />
                    <com.freewheelin.pulley.revision2023.ui.view.MiddleSchoolUnitSelection
                        android:id="@+id/middle21Selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:unitType="m2-1" />
                    <com.freewheelin.pulley.revision2023.ui.view.MiddleSchoolUnitSelection
                        android:id="@+id/middle22Selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:unitType="m2-2" />
                    <com.freewheelin.pulley.revision2023.ui.view.MiddleSchoolUnitSelection
                        android:id="@+id/middle31Selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:unitType="m3-1" />
                    <com.freewheelin.pulley.revision2023.ui.view.MiddleSchoolUnitSelection
                        android:id="@+id/middle32Selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:unitType="m3-2" />

                </LinearLayout>



                <com.freewheelin.pulley.views.buttons.PrimaryButton
                    android:id="@+id/modifyBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp56"
                    android:layout_marginStart="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginEnd="@dimen/dp24"
                    android:text="@string/text_change"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/selectionContainer" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </LinearLayout>
</layout>