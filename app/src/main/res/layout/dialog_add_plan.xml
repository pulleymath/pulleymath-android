<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_gray_100_round_ripple"
    app:cardCornerRadius="5dp">


    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="@dimen/dialog_addPlan_width"
        android:layout_height="@dimen/dialog_addPlan_height"
        android:background="@drawable/bg_gray_100_ripple"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <TextView
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="플랜 추가하기"
            android:textColor="@color/gray_800"
            android:textStyle="bold"
            android:textSize="@dimen/sp18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/xBtnContainer"
            android:layout_width="64dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/titleBorder">

            <ImageView
                style="@style/Widget.AppCompat.Button.Borderless"
                android:id="@+id/xBtn"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/ic_x_grey_24dp"
                android:background="@null"
                android:scaleType="fitCenter"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <View style="@style/Border_Gray_300_Horizontal"
            android:layout_width="match_parent"
            android:id="@+id/titleBorder"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"/>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leftRv"
            android:layout_width="216dp"
            android:layout_height="0dp"
            android:paddingTop="16dp"
            android:clipToPadding="false"
            android:background="@color/white"
            android:scrollbars="vertical"
            android:scrollbarStyle="insideOverlay"
            android:scrollbarThumbVertical="@drawable/width_8_bg_grey_e0e0e0_round_padding_r_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleBorder"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/gray_300"
            app:layout_constraintTop_toBottomOf="@+id/titleBorder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/leftRv"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rightRv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/titleBorder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/leftRv"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
