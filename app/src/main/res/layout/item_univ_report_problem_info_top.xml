<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gray_300_round_top_only">

    <TextView
        android:id="@+id/problemNumTv"
        android:layout_width="@dimen/dp56"
        android:layout_height="@dimen/dp48"
        android:text="1"
        android:gravity="center"
        style="@style/b2"
        android:textColor="@color/gray_600"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/subjectTv"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:text="코사인 법칙"
        android:paddingStart="16dp"
        android:gravity="center_vertical"
        style="@style/b2"
        android:textColor="@color/gray_600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/scoreTv"
        app:layout_constraintStart_toEndOf="@id/problemNumTv"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/scoreTv"
        android:layout_width="@dimen/dp56"
        android:layout_height="@dimen/dp48"
        android:text="배점"
        android:gravity="center"
        style="@style/b2"
        android:textColor="@color/gray_600"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/reportResultTv"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/reportResultTv"
        android:layout_width="@dimen/dp56"
        android:layout_height="@dimen/dp48"
        android:text="결과"
        android:gravity="center"
        style="@style/b2"
        android:textColor="@color/gray_600"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />



</androidx.constraintlayout.widget.ConstraintLayout>
