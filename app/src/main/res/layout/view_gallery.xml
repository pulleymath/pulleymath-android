<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_200"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/galleryHeaderView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp64"
        android:background="@color/white"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/TextGray_600.Bold"
            android:id="@+id/galleryHeaderTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp16"
            android:text="전체 nn(+n)문항"
            android:layout_marginStart="@dimen/dp32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            style="@style/TextGray_600.Bold"
            android:id="@+id/filterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp16"
            android:text="틀린 문제만 보기"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/filterSwitch"/>

        <Switch
            style="@style/Switch.Light"
            android:id="@+id/filterSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp24"
            android:focusable="false"
            app:layout_constraintEnd_toStartOf="@+id/foldBtn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/foldBtn"
            android:layout_width="@dimen/dp36"
            android:layout_height="@dimen/dp36"
            android:background="@null"
            android:layout_marginEnd="@dimen/dp24"
            android:src="@drawable/ic_doubly_left_arrow"
            android:focusable="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            style="@style/Border_Gray_300_Horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="@dimen/dp28"
        android:paddingStart="@dimen/dp24"
        android:paddingEnd="@dimen/dp32"
        android:paddingBottom="@dimen/dp28"
        android:clipToPadding="false"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@+id/galleryHeaderView"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/emptyFilterContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/gray_200"
        android:visibility="gone"
        android:focusable="false"
        app:layout_constraintStart_toStartOf="@+id/recyclerView"
        app:layout_constraintTop_toTopOf="@+id/recyclerView"
        app:layout_constraintEnd_toEndOf="@+id/recyclerView"
        app:layout_constraintBottom_toBottomOf="@+id/recyclerView">

        <ImageView
            android:id="@+id/emptyIv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/rect_gray_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/emptyTv"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView
            style="@style/TextGray_500.Bold"
            android:id="@+id/emptyTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp16"
            android:text="와! 틀린 문제가 없네요 :)"
            android:layout_marginTop="@dimen/dp24"
            android:focusable="false"
            app:layout_constraintTop_toBottomOf="@+id/emptyIv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>