<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".revision2023.ui.activity.PurchaseGuideActivity"
    >

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.PurchaseGuideViewModel"/>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerCl"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_arrow_l1_left"
                android:background="@null"
                android:layout_gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/headerTv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="16dp"
                style="@style/h5"
                android:text="풀리수학+ 구독제 상품"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/compareTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/h6"
                android:background="@drawable/bg_gray_300_round_5_ripple"
                android:layout_marginEnd="24dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="구독제 상품 비교"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bodyCl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/gradient_purchase_guide_header"
            app:layout_constraintTop_toBottomOf="@id/headerCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/premiumIv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/purchase_grand_open_premium"
                app:layout_constraintHeight_percent="0.485"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/basicCIv"
                />
            <View
                android:id="@+id/premiumClickView"
                android:layout_width="500dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@+id/premiumIv"
                app:layout_constraintStart_toStartOf="@+id/premiumIv"
                app:layout_constraintEnd_toEndOf="@+id/premiumIv"
                app:layout_constraintBottom_toBottomOf="@+id/premiumIv"/>
            <ImageView
                android:id="@+id/basicCIv"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/purchase_basic_c"
                android:adjustViewBounds="true"
                android:layout_marginStart="36dp"
                app:layout_constraintTop_toBottomOf="@+id/premiumIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/basicPIv"
                app:layout_constraintBottom_toTopOf="@+id/bottomDummyView"
                app:layout_constraintHorizontal_chainStyle="packed"
                />
            <ImageView
                android:id="@+id/basicPIv"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/purchase_basic_p"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toBottomOf="@id/premiumIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/bottomDummyView"
                />
            <ImageView
                android:id="@+id/standardIv"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/purchase_standard"
                android:adjustViewBounds="true"
                android:layout_marginEnd="36dp"
                app:layout_constraintTop_toBottomOf="@id/premiumIv"
                app:layout_constraintStart_toEndOf="@id/basicPIv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/bottomDummyView"
                />
            <View
                android:id="@+id/bottomDummyView"
                android:layout_width="0dp"
                android:layout_height="75dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* 스타트 챌린지 리워드 쿠폰은 챌린지에 참여해 모든 미션을 완료해야 받을 수 있습니다. 리워드 쿠폰은 구독제 구매 시 적용 가능합니다."
                style="@style/mo_b2r"
                android:textColor="@color/purple_200"
                app:layout_constraintTop_toBottomOf="@+id/basicPIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/mobileScrollRoot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/headerCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mobileBodyCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/backgroundTopView"
                    android:layout_width="0dp"
                    android:layout_height="558dp"
                    android:background="@drawable/gradient_purchase_guide_header"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <View
                    android:id="@+id/backgroundBottomView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#40408C"
                    app:layout_constraintTop_toBottomOf="@id/backgroundTopView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/dummyBottomView"/>
                <ImageView
                    android:id="@+id/mobilePremiumIv"
                    android:layout_width="0dp"
                    android:layout_height="360dp"
                    android:layout_marginTop="36dp"
                    android:src="@drawable/purchase_grand_open_premium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <View
                    android:id="@+id/mobilePremiumClickView"
                    android:layout_width="400dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@+id/mobilePremiumIv"
                    app:layout_constraintStart_toStartOf="@+id/mobilePremiumIv"
                    app:layout_constraintEnd_toEndOf="@+id/mobilePremiumIv"
                    app:layout_constraintBottom_toBottomOf="@+id/mobilePremiumIv"/>
                <ImageView
                    android:id="@+id/mobileBasicCIv"
                    android:layout_width="252dp"
                    android:layout_height="232dp"
                    android:src="@drawable/purchase_basic_c"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/mobilePremiumIv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/mobileBasicPIv"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    />
                <ImageView
                    android:id="@+id/mobileBasicPIv"
                    android:layout_width="252dp"
                    android:layout_height="232dp"
                    android:src="@drawable/purchase_basic_p"
                    android:layout_marginHorizontal="36dp"
                    app:layout_constraintTop_toBottomOf="@id/mobilePremiumIv"
                    app:layout_constraintStart_toEndOf="@id/mobileBasicCIv"
                    app:layout_constraintEnd_toStartOf="@+id/mobileStandardIv"
                    />
                <ImageView
                    android:id="@+id/mobileStandardIv"
                    android:layout_width="252dp"
                    android:layout_height="232dp"
                    android:src="@drawable/purchase_standard"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintTop_toBottomOf="@id/mobilePremiumIv"
                    app:layout_constraintStart_toEndOf="@id/mobileBasicPIv"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* 스타트 챌린지 리워드 쿠폰은 챌린지에 참여해 모든 미션을 완료해야 받을 수 있습니다. 리워드 쿠폰은 구독제 구매 시 적용 가능합니다."
                    android:textColor="@color/purple_200"
                    app:layout_constraintTop_toBottomOf="@+id/mobileBasicPIv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <View
                    android:id="@+id/dummyBottomView"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    app:layout_constraintTop_toBottomOf="@id/mobileStandardIv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/compareFl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/gray_200"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerCl"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/compareIv"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/subscribe_guide"
                android:adjustViewBounds="true"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/compareScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/gray_200"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerCl"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:id="@+id/compareScrollLl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="32dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/compareScrollIv"
                    android:layout_width="wrap_content"
                    android:layout_height="600dp"
                    android:src="@drawable/subscribe_guide"
                    android:layout_gravity="center"
                    />
            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>