<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        android:paddingBottom="@dimen/dp48"
        android:paddingTop="@dimen/dp32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainAnalysisContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:background="@drawable/shadow">

                <TextView
                    android:id="@+id/mainCurationTv"
                    style="@style/TextBlack_4c4c4c.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp48"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/sp12"
                    android:text="제대로 공부하고 있군요?\n여기 큐레이션이 들어가요."
                    android:textSize="@dimen/sp24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <com.freewheelin.pulley.views.TextViews.AnalysisCompareTextView
                    android:id="@+id/percentCompareTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp48"
                    app:AnalysisCompareTextView_BottomLabel="전일대비"
                    app:AnalysisCompareTextView_TopLabel="오늘의 백분위"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintEnd_toStartOf="@+id/timeCompareTv"
                    app:layout_constraintStart_toEndOf="@+id/cntCompareTv"
                    app:layout_constraintTop_toBottomOf="@+id/mainCurationTv" />

                <com.freewheelin.pulley.views.TextViews.AnalysisCompareTextView
                    android:id="@+id/cntCompareTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp48"
                    android:layout_marginEnd="@dimen/dp32"
                    app:AnalysisCompareTextView_BottomLabel="전일대비"
                    app:AnalysisCompareTextView_TopLabel="오늘 푼 문제"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/percentCompareTv"
                    app:layout_constraintTop_toBottomOf="@+id/mainCurationTv" />

                <com.freewheelin.pulley.views.TextViews.AnalysisCompareTextView
                    android:id="@+id/timeCompareTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp48"
                    app:AnalysisCompareTextView_BottomLabel="순공시간"
                    app:AnalysisCompareTextView_TopLabel="오늘 공부한 시간"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/percentCompareTv"
                    app:layout_constraintTop_toBottomOf="@+id/mainCurationTv" />

                <com.freewheelin.pulley.views.Buttons.PrimaryButton
                    android:id="@+id/mainAnalysisBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp56"
                    android:layout_marginStart="@dimen/dp48"
                    android:layout_marginTop="@dimen/dp64"
                    android:layout_marginEnd="@dimen/dp48"
                    android:layout_marginBottom="@dimen/dp48"
                    android:text="내 전체 분석 보기"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/percentCompareTv" />

                <ImageButton
                    android:id="@+id/shareBtn"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginEnd="@dimen/dp24"
                    android:background="@drawable/bg_white_fafafa_grey_stroke_grey_e8e8e8_circle"
                    android:src="@drawable/ic_share"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/timeAnalysisContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:background="@drawable/shadow">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/timeCountChart"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/dp56"
                    android:layout_marginBottom="@dimen/dp80"
                    android:layout_marginEnd="@dimen/dp24"
                    android:layout_marginStart="@dimen/dp36"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    style="@style/TextGrey_9f9f9f.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp14"
                    android:text="이번 주 푼 문제 그래프"
                    android:layout_marginTop="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/timeCountChart"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>


        <com.freewheelin.pulley.activities.learning.tabFragment.analysis.component.AnalysisRecommendStudyView
            android:id="@+id/recommendStudyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@drawable/shadow" />

        <com.freewheelin.pulley.activities.learning.tabFragment.analysis.component.AnalysisStudyRateView
            android:id="@+id/studyRateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@drawable/shadow" />

        <com.freewheelin.pulley.activities.learning.tabFragment.analysis.component.AnalysisTodayStudyListView
            android:id="@+id/todayStudyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shadow"/>
    </LinearLayout>
</ScrollView>
