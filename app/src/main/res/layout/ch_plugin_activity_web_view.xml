<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_white"
    android:orientation="vertical">

    <!--toolbar-->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ch_buttonWebViewBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/chevron_left_dark" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/ch_buttonWebViewBack"
            android:layout_toRightOf="@id/ch_buttonWebViewBack"
            android:layout_marginEnd="42dp"
            android:paddingLeft="14dp"
            android:layout_marginRight="42dp"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/ch_textWebViewLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ch_grey900"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="채널 - 고객과 팀을 위한 채팅 - Channel.io" />

            <LinearLayout
                android:id="@+id/ch_layoutWebViewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ch_textWebViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ch_grey900"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="채널 - 고객과 팀을 위한 채팅 - Channel.io" />

                <TextView
                    android:id="@+id/ch_textWebViewUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/ch_grey900"
                    android:textSize="12sp"
                    tools:text="channel.io" />

            </LinearLayout>

        </FrameLayout>

        <ImageView
            android:id="@+id/ch_buttonWebViewMore"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/webview_open" />

        <ProgressBar
            android:id="@+id/ch_progressWebView"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_alignParentBottom="true"
            android:visibility="gone"
            android:progressTint="@color/ch_grey900"/>

    </RelativeLayout>

    <WebView
        android:id="@+id/ch_webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingTop="12dp">

        <ImageView
            android:id="@+id/ch_layoutButtonWebViewPreviousPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/webview_backward" />


        <ImageView
            android:id="@+id/ch_layoutButtonWebViewNextPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/webview_forward" />

        <ImageView
            android:id="@+id/ch_layoutButtonWebViewRefresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/webview_refresh" />

        <ImageView
            android:id="@+id/ch_layoutButtonWebViewShareUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/webview_share" />

    </LinearLayout>
</LinearLayout>