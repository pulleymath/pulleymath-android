<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/problemMiddle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_gray_100_ripple">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dp32"
            android:background="@drawable/bg_gray_300_stroke_middle_only"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:id="@+id/problemMiddleLl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_gray_300_stroke_top_gray"
                android:layout_marginHorizontal="@dimen/dp40"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNum"
                    style="@style/TextGray_800"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="@dimen/sp14" />

                <TextView
                    android:id="@+id/tvSubject"
                    style="@style/TextGray_800"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="수학1"
                    android:textSize="@dimen/sp14" />


                <TextView
                    android:id="@+id/tvBigUnit"
                    style="@style/TextGray_800"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="집합과 명제"
                    android:textSize="@dimen/sp14" />


                <TextView
                    android:id="@+id/tvType"
                    style="@style/TextGray_800"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="로그함수와 지수함수"
                    android:textSize="@dimen/sp14" />


                <TextView
                    android:id="@+id/tvPoint"
                    style="@style/TextGray_800"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1점"
                    android:textSize="@dimen/sp14" />


                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/ivKiller"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_red_300_circle" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_mock_report_result_o" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>