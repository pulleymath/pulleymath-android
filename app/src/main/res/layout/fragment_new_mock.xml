<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activities.learning.tabFragment.mockExam.NewMockFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_shadow_top"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.freewheelin.pulley.views.ArduousSpinner
                android:id="@+id/yearFilter"
                android:layout_width="160dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/dp48"
                android:layout_marginTop="16dp"
                app:defaultStr="출제 연도 전체"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.freewheelin.pulley.views.ArduousSpinner
                android:id="@+id/monthFilter"
                android:layout_width="136dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/dp16"
                app:defaultStr="출제월 전체"
                app:layout_constraintBottom_toBottomOf="@+id/yearFilter"
                app:layout_constraintStart_toEndOf="@+id/yearFilter"
                app:layout_constraintTop_toTopOf="@+id/yearFilter" />

            <com.freewheelin.pulley.views.ArduousSpinner
                android:id="@+id/gradeFilter"
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/dp16"
                app:defaultStr="학년 전체"
                app:layout_constraintBottom_toBottomOf="@+id/yearFilter"
                app:layout_constraintStart_toEndOf="@+id/monthFilter"
                app:layout_constraintTop_toTopOf="@+id/yearFilter" />


            <com.freewheelin.pulley.views.ArduousSpinner
                android:id="@+id/typeFilter"
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/dp16"
                app:defaultStr="계열 전체"
                app:layout_constraintBottom_toBottomOf="@+id/yearFilter"
                app:layout_constraintStart_toEndOf="@+id/gradeFilter"
                app:layout_constraintTop_toTopOf="@+id/yearFilter" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/yearSl"
                style="@style/TextGrey_9f9f9f.Bold"
                android:layout_width="@dimen/dp60"
                android:layout_height="@dimen/dp56"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:paddingEnd="@dimen/dp12"
                android:text="연도"
                android:textAlignment="center"
                android:textSize="@dimen/sp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/yearFilter" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/monthSl"
                style="@style/TextGrey_9f9f9f.Bold"
                android:layout_width="@dimen/dp56"
                android:layout_height="@dimen/dp56"
                android:layout_marginStart="@dimen/dp20"
                android:gravity="center"
                android:paddingEnd="@dimen/dp12"
                android:text="월"
                android:textAlignment="center"
                android:textSize="@dimen/sp16"
                app:layout_constraintBottom_toBottomOf="@+id/yearSl"
                app:layout_constraintStart_toEndOf="@+id/yearSl"
                app:layout_constraintTop_toTopOf="@+id/yearSl" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/gradeSl"
                style="@style/TextGrey_9f9f9f.Bold"
                android:layout_width="@dimen/dp56"
                android:layout_height="@dimen/dp56"
                android:layout_marginStart="@dimen/dp16"
                android:gravity="center"
                android:paddingEnd="@dimen/dp12"
                android:text="학년"
                android:textAlignment="center"
                android:textSize="@dimen/sp16"
                app:layout_constraintBottom_toBottomOf="@+id/yearSl"
                app:layout_constraintStart_toEndOf="@+id/monthSl"
                app:layout_constraintTop_toTopOf="@+id/yearSl" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/typeSl"
                style="@style/TextGrey_9f9f9f.Bold"
                android:layout_width="@dimen/dp56"
                android:layout_height="@dimen/dp56"
                android:layout_marginStart="@dimen/dp20"
                android:gravity="center"
                android:paddingEnd="@dimen/dp12"
                android:text="계열"
                android:textAlignment="center"
                android:textSize="@dimen/sp16"
                app:layout_constraintBottom_toBottomOf="@+id/yearSl"
                app:layout_constraintStart_toEndOf="@+id/gradeSl"
                app:layout_constraintTop_toTopOf="@+id/yearSl" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/titleSl"
                style="@style/TextGrey_9f9f9f.Bold"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:layout_marginStart="@dimen/dp16"
                android:gravity="center"
                android:paddingEnd="@dimen/dp12"
                android:text="제목"
                android:textAlignment="center"
                android:textSize="@dimen/sp16"
                app:layout_constraintBottom_toBottomOf="@+id/yearSl"
                app:layout_constraintStart_toEndOf="@+id/typeSl"
                app:layout_constraintTop_toTopOf="@+id/yearSl" />

            <View
                android:id="@+id/view2"
                style="@style/Border_Grey_e8e8e8_Horizontal"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/typeSl" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mockRv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"
            tools:listitem="@layout/item_new_test" />

        <ImageView
            android:id="@+id/scrollShadow"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:src="@drawable/gradient_shadow_under_list_header"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header" />

        <LinearLayout
            android:id="@+id/emptyGuideContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/mockRv"
            app:layout_constraintEnd_toEndOf="@+id/mockRv"
            app:layout_constraintStart_toStartOf="@+id/mockRv"
            app:layout_constraintTop_toTopOf="@+id/mockRv">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/ic_empty" />

            <TextView
                style="@style/TextGrey_c0c0c0.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="@string/guide_empty_mock"
                android:textSize="@dimen/sp14" />
        </LinearLayout>


        <FrameLayout
            android:id="@+id/loadingContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFFFFF"
            app:layout_constraintTop_toTopOf="@+id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                app:lottie_speed="1"
                app:lottie_repeatMode="restart"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_fileName="circle_loading.json"/>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>