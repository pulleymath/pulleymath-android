<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gray_100_ripple"
        android:orientation="vertical">

        <TextView
            android:id="@+id/problemAnalysisTv"
            style="@style/TextGray_600"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp32"
            android:layout_marginTop="@dimen/dp48"
            android:text="문항별 분석"
            android:textSize="@dimen/sp18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/problemAnalysisContainerCl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp32"
            android:layout_marginTop="12dp"

            android:background="@drawable/bg_gray_300_stroke_top"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/problemAnalysisTv">

            <TextView
                android:id="@+id/problemAnalysisGuideTv"
                style="@style/TextGray_800"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginTop="@dimen/dp40"
                android:textSize="@dimen/sp24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="꼼꼼한 리뷰를 하면 정답률을 높일 수 있어요!" />


            <LinearLayout
                android:id="@+id/problemFilterContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/dp40"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/problemAnalysisGuideTv">

                <com.freewheelin.pulley.views.ArduousSpinner
                    android:id="@+id/subjectFilter"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    app:defaultStr="과목 전체" />

                <com.freewheelin.pulley.views.ArduousSpinner
                    android:id="@+id/scoreFilter"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/dp16"
                    app:defaultStr="배점 전체" />

                <com.freewheelin.pulley.views.ArduousSpinner
                    android:id="@+id/killerFilter"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/dp16"
                    android:visibility="gone"
                    app:defaultStr="킬러 전체" />


                <com.freewheelin.pulley.views.ArduousSpinner
                    android:id="@+id/scoreResultFilter"
                    android:layout_width="160dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/dp16"
                    app:defaultStr="채점결과 전체" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/problemHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_gray_300_stroke_top"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginHorizontal="@dimen/dp40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/problemFilterContainer">>

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="문항"
                    android:textSize="@dimen/sp16" />

                <View
                    android:background="@color/gray_300"
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="과목"
                    android:textSize="@dimen/sp16" />

                <View
                    android:background="@color/gray_300"
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="대단원"
                    android:textSize="@dimen/sp16" />

                <View
                    android:background="@color/gray_300"
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="유형"
                    android:textSize="@dimen/sp16" />

                <View
                    android:background="@color/gray_300"
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="배점"
                    android:textSize="@dimen/sp16" />

                <View
                    android:background="@color/gray_300"
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="킬러여부"
                    android:textSize="@dimen/sp16" />

                <View
                    android:background="@color/gray_300"
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="채점결과"
                    android:textSize="@dimen/sp16" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>