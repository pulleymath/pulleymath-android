<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <io.channel.plugin.android.feature.lounge.view.LoungeChatsLabelView
            android:id="@+id/ch_viewLoungeChatsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/ch_buttonLoungeChatsHeaderItemRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.zoyi.channel.plugin.android.view.external.cpv.CircularProgressView
                android:id="@+id/ch_progressLoungeChatsHeaderItemRead"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:visibility="gone"
                app:ch_cpv_animAutostart="true"
                app:ch_cpv_color="@color/ch_bgtxt_absolute_black_lightest"
                app:ch_cpv_indeterminate="true"
                app:ch_cpv_thickness="2dp"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ch_imageLoungeChatsHeaderItemRead"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ch_icon_check_circle"
                app:tint="@color/ch_txt_black_dark" />

            <com.zoyi.channel.plugin.android.view.textview.CHTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginStart="2dp"
                android:textColor="@color/ch_txt_black_darker"
                android:textSize="13sp"
                app:ch_tv_hintKey="ch.lounge.card.chat_list.read_all_count" />

        </LinearLayout>

    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ch_recyclerViewLoungeChats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:overScrollMode="never"
        android:paddingHorizontal="6dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
