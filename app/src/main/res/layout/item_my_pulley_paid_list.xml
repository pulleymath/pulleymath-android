<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        style="@style/TextGrey_c0c0c0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="구매 일자 여기~"
        android:textSize="@dimen/sp16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_ffffff"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/prodNameLabel"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="상품명"
                android:textSize="@dimen/sp16" />
            <TextView
                android:id="@+id/prodNameTv"
                style="@style/TextBlack_4c4c4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="풀리수학+"
                android:textSize="@dimen/sp16" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/usePeriodLabel"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="이용기간"
                android:textSize="@dimen/sp16" />
            <TextView
                android:id="@+id/usePeriodTv"
                style="@style/TextBlack_4c4c4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2021.01.06 ~ 2021.02.05"
                android:textSize="@dimen/sp16" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/paymentLabel"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="결제정보"
                android:textSize="@dimen/sp16" />
            <TextView
                android:id="@+id/paymentTv"
                style="@style/TextBlack_4c4c4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="뭘로결제?"
                android:textSize="@dimen/sp16" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/amountLabel"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="결제금액"
                android:textSize="@dimen/sp16" />
            <TextView
                android:id="@+id/amountTv"
                style="@style/TextBlack_4c4c4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15,000원"
                android:textSize="@dimen/sp16" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>