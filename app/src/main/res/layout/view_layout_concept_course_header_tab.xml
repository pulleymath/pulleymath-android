                    android:layout_width="80dp"
                    android:layout_height="52dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/mathSangWrapperLl">
                    <ImageButton
                        android:id="@+id/bookmarkBtn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:onClick="@{ _ -> vm.onHeaderSubjectBtnClick(SubjectIndicator.Tutorial.rawValue)}"
                        commonBackgroundIf="@{ vm.selectedSubjectId == SubjectIndicator.Tutorial.rawValue }"
                        android:src="@drawable/ic_course_star"
                        imagebtn_tint="@{ vm.selectedSubjectId == SubjectIndicator.Tutorial.rawValue ? @color/white : @color/purple_gray_400 }"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mathSangWrapperLl"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:orientation="vertical"
                    android:layout_marginStart="28dp"
