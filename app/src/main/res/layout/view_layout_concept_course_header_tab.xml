                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/middleBookmarkWrapperLl"
                    app:layout_constraintEnd_toStartOf="@id/middleMath1_2WrapperLl">
                    <Button
