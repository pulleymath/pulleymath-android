                        app:layout_constraintEnd_toStartOf="@id/scrollMath1WrapperLl">
                        <Button
                            android:id="@+id/scrollMathHaBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="20dp"
                            style="@style/h5"
                            android:textColor="@{ vm.selectedSubjectId == SubjectIndicator.MathHa.rawValue ? @color/white : @color/purple_gray_500 }"
                            android:onClick="@{()->vm.onHeaderSubjectBtnClick(SubjectIndicator.MathHa.rawValue)}"
                            commonBackgroundIf="@{ vm.selectedSubjectId == SubjectIndicator.MathHa.rawValue }"
                            android:text="@{ SubjectIndicator.MathHa.inKorean }"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/scrollMath1WrapperLl"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:orientation="vertical"
                        android:layout_marginStart="28dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/scrollMathHaWrapperLl"
                        app:layout_constraintEnd_toStartOf="@id/scrollMath2WrapperLl">
                        <Button
                            android:id="@+id/scrollMath1Btn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="20dp"
                            style="@style/h5"
                            android:textColor="@{ vm.selectedSubjectId == SubjectIndicator.Math1.rawValue ? @color/white : @color/purple_gray_500 }"
                            android:onClick="@{()->vm.onHeaderSubjectBtnClick(SubjectIndicator.Math1.rawValue)}"
                            commonBackgroundIf="@{ vm.selectedSubjectId == SubjectIndicator.Math1.rawValue  }"
                            android:text="@{ SubjectIndicator.Math1.inKorean }"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/scrollMath2WrapperLl"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:orientation="vertical"
                        android:layout_marginStart="28dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/scrollMath1WrapperLl"
                        app:layout_constraintEnd_toStartOf="@id/scrollMathProbabilityAndStatisticsWrapperLl">
                        <Button
                            android:id="@+id/scrollMath2Btn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="20dp"
                            style="@style/h5"
                            android:textColor="@{ vm.selectedSubjectId == SubjectIndicator.Math2.rawValue ? @color/white : @color/purple_gray_500 }"
                            android:onClick="@{()->vm.onHeaderSubjectBtnClick(SubjectIndicator.Math2.rawValue)}"
                            commonBackgroundIf="@{ vm.selectedSubjectId == SubjectIndicator.Math2.rawValue  }"
                            android:text="@{ SubjectIndicator.Math2.inKorean }"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/scrollMathProbabilityAndStatisticsWrapperLl"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:orientation="vertical"
                        android:layout_marginStart="28dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/scrollMath2WrapperLl"
                        app:layout_constraintEnd_toStartOf="@id/scrollMathCalculusWrapperLl">
                        <Button
                            android:id="@+id/scrollMathProbabilityAndStatisticsBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="20dp"
                            style="@style/h5"
                            android:textColor="@{ vm.selectedSubjectId == SubjectIndicator.MathProbabilityAndStatistics.rawValue ? @color/white : @color/purple_gray_500 }"
                            android:onClick="@{()->vm.onHeaderSubjectBtnClick(SubjectIndicator.MathProbabilityAndStatistics.rawValue)}"
                            commonBackgroundIf="@{ vm.selectedSubjectId == SubjectIndicator.MathProbabilityAndStatistics.rawValue  }"
                            android:text="@{ SubjectIndicator.MathProbabilityAndStatistics.inKorean }"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/scrollMathCalculusWrapperLl"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:orientation="vertical"
                        android:layout_marginStart="28dp"
                        app:layout_constraintTop_toTopOf="parent"
