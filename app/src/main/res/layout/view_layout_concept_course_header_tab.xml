                    app:layout_constraintEnd_toStartOf="@id/mathHaWrapperLl">
                    <Button
                        android:id="@+id/mathSangBtn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        style="@style/h5"
                        android:textColor="@{ vm.selectedSubjectId == SubjectIndicator.MathSang.rawValue ? @color/white : @color/purple_gray_500 }"
                        android:onClick="@{()-> vm.onHeaderSubjectBtnClick(SubjectIndicator.MathSang.rawValue)}"
                        commonBackgroundIf="@{ vm.selectedSubjectId == SubjectIndicator.MathSang.rawValue }"
                        android:text="@{ SubjectIndicator.MathSang.inKorean }"/>
                    <!--                        android:background="@drawable/shadow_main_page_tab_focused"-->
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mathHaWrapperLl"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:orientation="vertical"
                    android:layout_marginStart="28dp"
