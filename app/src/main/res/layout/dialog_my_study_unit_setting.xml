<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="960dp"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:background="@drawable/bg_white_fafafa_round">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topContainerCl"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_white_ffffff_round_top_only"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="정보 수정하기"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageButton
                android:id="@+id/xBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@null"
                android:src="@drawable/ic_x_grey_19dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <View style="@style/Border_Grey_e8e8e8_Horizontal"
                android:layout_width="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="536dp"
            app:layout_constraintTop_toBottomOf="@+id/topContainerCl">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/guideLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:text="학습한 대단원을\n모두 선택해주세요."
                    android:lineSpacingExtra="12sp"
                    android:layout_marginTop="62dp"
                    android:layout_marginStart="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c"
                    android:id="@+id/selectGuideLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="일정량의 학습 데이터가\n쌓이기 전까지\n선택하신 대단원에 맞추어\n문항이 추천됩니다 :)"
                    android:lineSpacingExtra="8sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/guideLabel"/>

                <TextView
                    style="@style/TextRed_fe7b67.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp14"
                    android:lineSpacingExtra="6sp"
                    android:text="본인의 진도에 맞는 단원을\n정확히 선택해주세요 :)"
                    android:layout_marginTop="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/selectGuideLabel"
                    app:layout_constraintStart_toStartOf="@+id/selectGuideLabel"/>

                <TextView
                    style="@style/TextGrey_c0c0c0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:textSize="16sp"
                    android:text="단원 정보"
                    app:layout_constraintStart_toStartOf="@+id/contentsLl"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/contentsLl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="62dp"
                    android:layout_marginStart="70dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginEnd="32dp"
                    android:padding="32dp"
                    android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
                    android:orientation="vertical"
                    app:layout_constraintStart_toEndOf="@+id/guideLabel"
                    app:layout_constraintBottom_toTopOf="@+id/modifyBtn"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">



                    <com.freewheelin.pulley.views.DaebakInputSelection
                        android:id="@+id/mathTopSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:DaebakInputSelection_Label="수학(상)"/>

                    <com.freewheelin.pulley.views.DaebakInputSelection
                        android:id="@+id/mathBottomSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        app:DaebakInputSelection_Label="수학(하)" />

                    <com.freewheelin.pulley.views.DaebakInputSelection
                        android:id="@+id/math1Selection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp48"
                        app:DaebakInputSelection_Label="수학I"/>

                    <com.freewheelin.pulley.views.DaebakInputSelection
                        android:id="@+id/math2Selection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        app:DaebakInputSelection_Label="수학II"/>

                    <com.freewheelin.pulley.views.DaebakInputSelection
                        android:id="@+id/probAnsStatSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp48"
                        app:DaebakInputSelection_Label="확률과 통계"/>

                    <com.freewheelin.pulley.views.DaebakInputSelection
                        android:id="@+id/calculusSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        app:DaebakInputSelection_Label="미적분"/>

                    <com.freewheelin.pulley.views.DaebakInputSelection
                        android:id="@+id/geometrySelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        app:DaebakInputSelection_Label="기하"/>


                </LinearLayout>


                <com.freewheelin.pulley.views.buttons.PrimaryButton
                    android:id="@+id/modifyBtn"
                    android:layout_width="200dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="50dp"
                    android:text="@string/text_do_edit"
                    app:ButtonTextSize="18sp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/contentsLl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>