<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_100"
        tools:context="com.freewheelin.pulley.legacy.activities.StartActivity">

        <TextView
            style="@style/TextGray_800.Bold"
            android:id="@+id/topLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학생 자기주도 학습의 완성"
            android:textColor="@color/purple_300"
            android:textSize="@dimen/sp18"
            android:letterSpacing="0.61"
            android:gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dp24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/pulleyIv"/>

        <LinearLayout
            android:id="@+id/coverLl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="end"
            android:orientation="horizontal"
            tools:visibility="gone"
            app:layout_constraintTop_toTopOf="@+id/topLabel"
            app:layout_constraintEnd_toEndOf="@+id/topLabel"
            app:layout_constraintBottom_toBottomOf="@+id/topLabel"
            app:layout_constraintStart_toStartOf="@+id/topLabel">
            <View
                android:id="@+id/topLabelCoverVisible"
                android:layout_width="0dp"
                android:layout_weight="0"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/topLabelCover"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@color/gray_100" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pulleyIv"
            android:layout_width="522dp"
            android:layout_height="56dp"
            android:src="@drawable/pulleymath"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="@+id/topLabel"
            app:layout_constraintEnd_toEndOf="@+id/topLabel"
            app:layout_constraintBottom_toBottomOf="@+id/guideline"/>


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="@dimen/primaryBtn_width_200dp"
            app:layout_constraintGuide_percent="0.43" />

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="240dp"
            android:layout_height="@dimen/dp56"
            android:text="로그인"
            android:textColor="@color/purple_300"
            android:background="@drawable/bg_purple_100_round_40"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/guideline"
            app:layout_constraintStart_toStartOf="@id/topLabel"
            app:layout_constraintEnd_toEndOf="@id/topLabel"
            />

        <Button
            android:id="@+id/joinBtn"
            android:layout_width="240dp"
            android:layout_height="@dimen/dp56"
            android:text="회원가입"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="@+id/loginBtn"
            app:layout_constraintEnd_toEndOf="@+id/loginBtn"
            app:layout_constraintTop_toBottomOf="@id/loginBtn"
            android:background="@drawable/bg_purple_300_round_40"
            />

        <TextView
            android:id="@+id/guestText"
            android:layout_width="240dp"
            android:layout_height="@dimen/dp56"
            android:text="가입없이 둘러보기"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/joinBtn"
            app:layout_constraintStart_toStartOf="@id/joinBtn"
            app:layout_constraintEnd_toEndOf="@id/joinBtn"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:progressTint="@color/purple_200"
            visibleIf="@{ vm.isLoading }"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>