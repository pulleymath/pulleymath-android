<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_fafafa"
        tools:context="com.freewheelin.pulley.activities.StartActivity">

        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:id="@+id/topLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수학 등급상승의 비결"
            android:textSize="@dimen/sp18"
            android:letterSpacing="0.61"
            android:gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dp24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/pulleyIv"/>

        <LinearLayout
            android:id="@+id/coverLl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="end"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="@+id/topLabel"
            app:layout_constraintEnd_toEndOf="@+id/topLabel"
            app:layout_constraintBottom_toBottomOf="@+id/topLabel"
            app:layout_constraintStart_toStartOf="@+id/topLabel">
            <View
                android:id="@+id/topLabelCoverVisible"
                android:layout_width="0dp"
                android:layout_weight="0"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/topLabelCover"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@color/white_fafafa" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pulleyIv"
            android:layout_width="522dp"
            android:layout_height="56dp"
            android:src="@drawable/pulleymath"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="@+id/topLabel"
            app:layout_constraintEnd_toEndOf="@+id/topLabel"
            app:layout_constraintBottom_toBottomOf="@+id/guideline"/>


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="@dimen/primaryBtn_width_200dp"
            app:layout_constraintGuide_percent="0.43" />

        <ImageView
            android:id="@+id/nowJoinIv"
            android:layout_width="292dp"
            android:layout_height="64dp"
            android:src="@drawable/now_look_around"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/guideline"
            app:layout_constraintStart_toStartOf="@id/startBtn"
            app:layout_constraintEnd_toEndOf="@id/startBtn"/>

        <Button
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:text="시작하기"
            app:layout_constraintStart_toStartOf="@+id/topLabel"
            app:layout_constraintEnd_toEndOf="@+id/topLabel"
            app:layout_constraintTop_toBottomOf="@id/nowJoinIv"
            android:background="@drawable/bg_purple_6d6dff_round_40"
            />

        <View
            android:id="@+id/borderView"
            android:layout_width="2dp"
            android:layout_height="20dp"
            android:background="@color/gray_400"
            android:layout_marginTop="18dp"
            app:layout_constraintStart_toStartOf="@id/startBtn"
            app:layout_constraintEnd_toEndOf="@id/startBtn"
            app:layout_constraintTop_toBottomOf="@id/startBtn" />

        <TextView
            android:id="@+id/signupTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            style="@style/mo_h5"
            android:padding="16dp"
            android:textColor="@color/gray_600"
            app:layout_constraintTop_toTopOf="@id/borderView"
            app:layout_constraintEnd_toStartOf="@id/borderView"
            app:layout_constraintBottom_toBottomOf="@id/borderView"
            />

        <TextView
            android:id="@+id/loginTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인"
            style="@style/mo_h5"
            android:padding="16dp"
            android:textColor="@color/gray_600"
            app:layout_constraintTop_toTopOf="@id/borderView"
            app:layout_constraintBottom_toBottomOf="@id/borderView"
            app:layout_constraintStart_toEndOf="@id/borderView"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/balloonCl"
            android:layout_width="136dp"
            android:layout_height="128dp"
            android:visibility="gone"
            android:background="@drawable/ic_balloon_purple"
            android:layout_marginBottom="@dimen/dp28"
            android:layout_marginStart="28dp"
            app:layout_constraintBottom_toBottomOf="@+id/pulleyIv"
            app:layout_constraintStart_toEndOf="@+id/pulleyIv"
            app:layout_constraintTop_toBottomOf="@+id/topLabel">

            <TextView
                style="@style/TextPurple_6d6dff.ExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="빠르게\n등급 상승하기!"
                android:textSize="16sp"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/sp8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:progressTint="@color/purple_200"
            visibleIf="@{ vm.isLoading }"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>