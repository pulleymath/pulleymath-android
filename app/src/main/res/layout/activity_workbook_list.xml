<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.WorkbookListViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".revision2023.ui.activity.WorkbookListActivity">

        <LinearLayout
            android:id="@+id/headerLl"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:background="@color/black_333333"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:background="@android:color/transparent"
                android:padding="@dimen/dp16"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_arrow_black_left"
                app:tint="@color/color_white_ffffff" />
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/h4"
                android:layout_weight="999"
                android:gravity="center"
                android:text="워크북"
                android:textColor="@color/white"/>
            <View
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/totalPlanContainerLl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical"
            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
            app:layout_constraintTop_toBottomOf="@id/headerLl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
        >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/totalLabel"
                    style="@style/h1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp48"
                    android:layout_marginTop="@dimen/dp32"
                    android:text="워크북"
                    android:textColor="@color/black_4c4c4c"
                    android:textSize="@dimen/sp36"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/createWorkbookClWrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/createWorkbookCl"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_purple_300_round_18_ripple"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="@dimen/dp48"
                        android:layout_marginTop="@dimen/dp32"
                        >
                        <ImageView
                            android:id="@+id/plusTv"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_plus"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="워크북 만들기"
                            style="@style/h5"
                            android:layout_marginEnd="20dp"
                            android:textColor="@color/white"
                            app:layout_constraintStart_toEndOf="@+id/plusTv"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/challengeStampIv"
                        android:layout_width="50dp"
                        android:layout_height="64dp"
                        android:src="@drawable/challenge_stamp_3d_image"
                        visibleIf="@{ vm.showStartChallengeStamp }"
                        app:layout_constraintStart_toStartOf="@+id/createWorkbookCl"
                        app:layout_constraintBottom_toBottomOf="@+id/createWorkbookCl"
                        app:layout_constraintEnd_toEndOf="@+id/createWorkbookCl"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>



            </LinearLayout>


            <View
                style="@style/Border_Grey_e8e8e8_Horizontal"
                android:id="@+id/topBorder"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp32"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/workbookWrapperCl"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.freewheelin.pulley.activities.learning.tabFragment.book.BookFilterView
                    android:id="@+id/filterView"
                    android:layout_width="@dimen/learning_wrongNote_filter_width"
                    android:layout_height="0dp"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/dp64"
                    android:paddingEnd="@dimen/dp32"
                    android:paddingBottom="@dimen/dp24"
                    app:type="workbook"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />
                <View
                    style="@style/Border_Grey_e8e8e8_Vertical"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@+id/filterView"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/filterView"/>

                <com.freewheelin.pulley.views.GridRecyclerView
                    android:id="@+id/totalRv"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="1dp"
                    android:padding="@dimen/dp32"
                    android:clipToPadding="false"
                    android:visibility="@{ vm.showRecyclerView ? View.VISIBLE : View.INVISIBLE }"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/filterView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0">

                </com.freewheelin.pulley.views.GridRecyclerView>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/totalLoadingView"
                    android:layout_width="@dimen/dp200"
                    android:layout_height="@dimen/dp200"
                    android:visibility="@{ vm.showTotalLoadingView ? View.VISIBLE : View.GONE }"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/totalRv"
                    app:layout_constraintStart_toStartOf="@+id/totalRv"
                    app:layout_constraintTop_toTopOf="@+id/totalRv"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="circle_loading.json"
                    app:lottie_loop="true" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/totalEmptyContainer"
                    android:visibility="@{ vm.showEmptyContainer ? View.VISIBLE : View.GONE }"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/filterView"
                    app:layout_constraintStart_toEndOf="@+id/filterView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/filterView">

                    <ImageView
                        android:id="@+id/emptyIv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_plan_empty"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginBottom="@dimen/dp24"
                        app:layout_constraintBottom_toTopOf="@+id/emptyTv"/>


                    <TextView
                        style="@style/TextGrey_c0c0c0.Bold"
                        android:id="@+id/emptyTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp16"
                        android:textColor="@color/grey_c0c0c0"
                        android:lineSpacingExtra="8sp"
                        android:gravity="center_horizontal"
                        android:text="조건에 맞는 문제집이 없네요ㅠㅠ\n조건을 바꿔볼까요?"
                        app:layout_constraintTop_toBottomOf="@+id/emptyIv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/totalPlanCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="1dp"
            android:clickable="true"
            android:visibility="@{ vm.showTotalPlanCover ? View.VISIBLE : View.GONE }"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
