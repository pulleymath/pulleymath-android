<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/stepTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 2."
            style="@style/mo_h6"
            android:textColor="@color/purple_300"
            android:layout_marginTop="48dp"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/stepTitleTv"
            style="@style/h4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="유형 학습하기"
            android:layout_marginStart="4dp"
            android:textColor="@color/blue_black_200"
            app:layout_constraintBottom_toBottomOf="@+id/stepTv"
            app:layout_constraintStart_toEndOf="@+id/stepTv"
            app:layout_constraintTop_toTopOf="@+id/stepTv"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_700"
            style="@style/b2"
            android:lineHeight="20dp"
            android:text="아래 유형 지도에서 하나의 유형이라도 풀면 오답 학습을 할 수 있어요!"
            android:layout_marginTop="24dp"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toBottomOf="@+id/stepTitleTv"
            app:layout_constraintStart_toStartOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>