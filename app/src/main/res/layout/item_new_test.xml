<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp64"
    android:background="@drawable/bg_shadow_middle">


    <TextView
        android:id="@+id/yearTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp64"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2021년" />

    <TextView
        android:id="@+id/monthTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp56"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp16"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/yearTv"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12월" />


    <TextView
        android:id="@+id/gradeTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp56"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp16"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/monthTv"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="고1" />


    <TextView
        android:id="@+id/typeTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp56"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp16"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gradeTv"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="계열" />


    <TextView
        android:id="@+id/titleTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp20"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="@+id/typeTv"
        app:layout_constraintStart_toEndOf="@+id/typeTv"
        app:layout_constraintTop_toTopOf="@+id/typeTv"
        tools:text="제목" />


    <TextView
        android:id="@+id/updateTag"
        style="@style/TextWhite_ffffff.ExtraBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_red_fe7b67_capsule"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="신규"
        android:textColor="@color/color_white_ffffff"
        android:textSize="@dimen/sp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/titleTv"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/horizontalBorder"
        style="@style/Border_Grey_e8e8e8_Horizontal"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/testBtnWrapperCl"
        android:layout_width="@dimen/dp120"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/dp16"
        android:background="@drawable/bg_btn_round_common"
        app:layout_constraintBottom_toBottomOf="@id/yearTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/yearTv">

        <ImageView
            android:id="@+id/testBtnLockIv"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock_20_white"
            app:tint="@color/white"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/testBtnTv"
            app:layout_constraintHorizontal_chainStyle="packed"/>

        <TextView
            android:id="@+id/testBtnTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/h5"
            android:textColor="@color/white"
            android:text="풀기"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/testBtnLockIv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/testInProgressBtnWrapperCl"
        android:layout_width="@dimen/dp120"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/dp16"
        android:visibility="gone"
        android:background="@drawable/bg_purple_100_round_5"
        app:layout_constraintBottom_toBottomOf="@id/yearTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/yearTv">

        <TextView
            android:id="@+id/testInProgressBtnTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/h5"
            android:textColor="@color/purple_300"
            android:text="풀기"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>