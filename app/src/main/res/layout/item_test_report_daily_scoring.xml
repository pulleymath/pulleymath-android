<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48">

        <TextView
            android:id="@+id/numberTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_marginStart="1dp"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@color/white_fafafa"
            android:gravity="center"
            android:text="1"
            android:textSize="@dimen/sp14"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            style="@style/Border_Grey_e8e8e8_Vertical"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@+id/numberTv" />

        <ImageView
            android:id="@+id/resultIv"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:src="@drawable/ic_result_correct"
            app:layout_constraintStart_toEndOf="@+id/numberTv" />

        <View
            style="@style/Border_Grey_e8e8e8_Vertical"
            android:layout_height="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/resultIv"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/totalCorrectRateTv"
            style="@style/TextBlack_4c4c4c"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="전체 정답률"
            android:textSize="@dimen/sp14"
            app:layout_constraintStart_toEndOf="@+id/resultIv" />

        <View
            style="@style/Border_Grey_e8e8e8_Vertical"
            android:layout_height="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/totalCorrectRateTv"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/sameCorrectRateTv"
            style="@style/TextBlack_4c4c4c"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="전체 정답률"
            android:textSize="@dimen/sp14"
            app:layout_constraintStart_toEndOf="@+id/totalCorrectRateTv" />

        <View
            style="@style/Border_Grey_e8e8e8_Vertical"
            android:layout_height="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sameCorrectRateTv"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subjectTv"
            style="@style/TextBlack_4c4c4c"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:gravity="center"
            android:text="결과"
            android:textSize="@dimen/sp14"
            app:layout_constraintStart_toEndOf="@+id/sameCorrectRateTv" />

        <LinearLayout
            android:id="@+id/tagLl"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@+id/subjectTv">
        </LinearLayout>


        <View
            style="@style/Border_Grey_e8e8e8_Vertical"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <View
            style="@style/Border_Grey_e8e8e8_Vertical"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            style="@style/Border_Grey_e8e8e8_Horizontal"
            android:layout_width="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>