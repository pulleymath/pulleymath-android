<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activity.lc.fragments.cooking.CookingQuizFragment">

    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2021.model.QuizFormat" />
        <variable name="cookingExercise" type="com.freewheelin.pulley.revision2021.model.CookingExercise"/>
        <variable name="number" type="String"/>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/quizRootView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white"
            android:weightSum="10"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/titleChipTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{ `0`+ number + `. ` + cookingExercise.name }"
                style="@style/mo_h6"
                android:background="@drawable/bg_purple_100_round_ripple"
                android:textColor="@color/purple_300"
                android:paddingVertical="3dp"
                android:paddingHorizontal="8dp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="10">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart"
                    cookingImgResOnPicasso="@{ cookingExercise.imageUrl }"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="6"
                    android:text=""/>

            </LinearLayout>

            <include
                android:id="@+id/quizDetail0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz0 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz0 }"
                layout="@layout/item_cooking_quiz_detail"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz1 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz1 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz1 }"
                layout="@layout/item_cooking_quiz_detail"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz2 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz2 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz2 }"
                layout="@layout/item_cooking_quiz_detail"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz3 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz3 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz3 }"
                layout="@layout/item_cooking_quiz_detail"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz4 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz4 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz4 }"
                layout="@layout/item_cooking_quiz_detail"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz5 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz5 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz5 }"
                layout="@layout/item_cooking_quiz_detail"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz6 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz6 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz6 }"
                layout="@layout/item_cooking_quiz_detail"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz7 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz7 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz7 }"
                layout="@layout/item_cooking_quiz_detail"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz8 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz8 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz8 }"
                layout="@layout/item_cooking_quiz_detail"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/purple_100"
                android:layout_marginVertical="24dp"
                android:visibility="@{ cookingExercise.cookingQuiz9 == null ? View.GONE : View.VISIBLE }"
                />

            <include
                android:id="@+id/quizDetail9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{ cookingExercise.cookingQuiz9 == null ? View.GONE : View.VISIBLE }"
                app:quiz="@{ cookingExercise.cookingQuiz9 }"
                layout="@layout/item_cooking_quiz_detail"/>

        </LinearLayout>

        <com.freewheelin.pulley.revision2021.cookingmemo.CookingMemoView
            android:id="@+id/cookingMemoView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dummyAnswerPanelLl"
            app:layout_constraintBottom_toBottomOf="parent"
            />

<!--        cookingMemoView의 width 측정을 위한 더미 뷰, 항상 Invisible 이어야 한다-->
        <LinearLayout
            android:id="@+id/dummyAnswerPanelLl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                >

                <LinearLayout
                    android:id="@+id/hintBtn"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_gray_300_round_stroke"
                    tools:background="@drawable/bg_btn_round_common">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="힌트"
                        android:gravity="center"
                        android:textColor="@color/white"
                        style="@style/mo_h5"/>

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/quizSingleAnswerCl"
                    android:layout_width="80dp"
                    android:layout_height="36dp">

                    <TextView
                        android:id="@+id/quizSingleAnswer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="정답 입력"
                        tools:text="정답 입력"
                        style="@style/b2"
                        android:gravity="center"
                        tools:visibility="gone"
                        android:background="@drawable/bg_white_stroke_gray_300_round_5"
                        tools:background="@drawable/bg_white_stroke_purple_300_round_5"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />


                    <Button
                        android:id="@+id/quizAnswerBtn"
                        android:layout_width="80dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_white_stroke_gray_300_round_5"
                        tools:background="@drawable/bg_white_stroke_purple_300_round_5"
                        android:gravity="center"
                        android:text="정답 입력"
                        tools:visibility="visible"
                        android:maxLength="9"
                        android:singleLine="true"
                        style="@style/b2"
                        tools:textColor="@color/purple_300"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/alreadySelectedAnswerIv"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        app:layout_constraintTop_toTopOf="@+id/quizSingleAnswer"
                        app:layout_constraintStart_toStartOf="@+id/quizSingleAnswer"
                        app:layout_constraintEnd_toEndOf="@+id/quizSingleAnswer"
                        app:layout_constraintBottom_toBottomOf="@+id/quizSingleAnswer"/>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>



        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>