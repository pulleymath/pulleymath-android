<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.StartChallengeInfoViewModel"/>
        <variable name="isPaidUser" type="Boolean"/>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="448dp"
        android:layout_height="match_parent">
<!--        android:layout_height="@dimen/dp768">-->

        <ScrollView
            android:id="@+id/scrollRootView"
            android:layout_width="448dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/updateGradeCl"
                android:layout_width="448dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <LinearLayout
                    android:id="@+id/headerLl"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:id="@+id/headerTv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        style="@style/h5"
                        android:text="챌린지 안내"
                        />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        />
                    <ImageButton
                        android:id="@+id/exitBtn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginVertical="16dp"
                        android:gravity="center"
                        android:src="@drawable/icon_x"
                        android:background="@null"
                        android:onClick="@{ () -> vm.exitBtn() }" />
<!--                    여기서 src를 isPaidUser로 분기 -->
                </LinearLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/gray_300"
                    app:layout_constraintTop_toBottomOf="@id/headerLl"
                    app:layout_constraintBottom_toTopOf="@id/infoScrollContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/infoScrollContainer"
                    android:layout_width="448dp"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toBottomOf="@+id/headerLl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/layoutButton"
                    app:layout_constraintVertical_bias="0">


                    <TextView
                        android:id="@+id/newChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="24dp"
                        android:textColor="@color/white"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/bg_red_300_round"/>

                    <TextView
                        android:id="@+id/titleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/h4_sb"
                        android:text="스타트 챌린지에 참여해..."
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/newChip"
                        android:layout_marginTop="8dp"/>
                    <TextView
                        android:id="@+id/subTitleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/b1r"
                        android:text="본 챌린지를 통해 풀리수학 프리미엄\n기능을 체험해 볼 수 있어요."
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/titleTv"
                        android:layout_marginTop="8dp"/>

                    <ImageView
                        android:layout_width="304dp"
                        android:layout_height="214dp"
                        app:layout_constraintTop_toBottomOf="@+id/subTitleTv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        cookingImgRes="@{ vm.couponImageUrl }"
                        android:layout_marginTop="12dp"/>
<!--                        android:src="@{ isPaidUser ? @drawable/challenge_popup_2week_coupon : @drawable/challenge_popup_1month_50percent_discount_coupon }"-->

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/layoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/infoScrollContainer"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">


                    <com.freewheelin.pulley.views.buttons.PrimaryButton
                        android:id="@+id/startBtn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp56"
                        android:text="챌린지 참여하기"
                        app:ButtonTextSize="@dimen/sp18"
                        app:buttonTheme="blue"/>

                    <Button
                        android:id="@+id/seeYouNextBtn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp56"
                        android:text="다음에 하기"
                        android:background="@drawable/bg_gray_300_round_5_ripple"
                        android:textColor="@color/gray_800"
                        android:layout_marginTop="8dp"
                        android:onClick="@{ () -> vm.exitBtn() }" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
