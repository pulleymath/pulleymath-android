<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.LCCourseEndDialogViewModel"/>
<!--        <variable name="count" type="String"/>-->
    </data>

    <ScrollView
        android:id="@+id/scrollRootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootView"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_round_ripple">

            <TextView
                android:id="@+id/titleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="개념 학습 정보"
                style="@style/h5"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/exitIconBtn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lc_wrong_note_x"
                app:tint="@color/gray_800"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:id="@+id/lineView1"
                android:layout_width="400dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/gray_300"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleTv"/>

            <TextView
                android:id="@+id/mainMessageTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{ vm.courseSummary.mainMessage }"
                app:layout_constraintTop_toBottomOf="@+id/lineView1"
                style="@style/h4_sb"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:layout_marginTop="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <LinearLayout
                android:id="@+id/pureStudyTimeLl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mainMessageTv">
    <!--            mainMessageTv -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/h6"
                    android:text="공부시간"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/b2"
                    android:textColor="@color/gray_600"
                    android:layout_marginStart="4dp"
                    android:text="@{ vm.courseSummary.studyTimeOnHourMin }"/>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/imageCl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pureStudyTimeLl">
    <!--            pureStudyTimeLl-->

                <ImageView
                    android:id="@+id/exampleIv"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/learning_course_end_example"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/exampleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/h6"
                    android:text="예제"
                    app:layout_constraintTop_toBottomOf="@id/exampleIv"
                    app:layout_constraintStart_toStartOf="@id/exampleIv"
                    app:layout_constraintEnd_toEndOf="@id/exampleIv"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/exampleTv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/lineView2">

                    <TextView
                        android:id="@+id/exampleSolvedTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_pretendard_bold"
                        android:text="@{ vm.courseSummary.exerciseProgress.userSolvedCount + `` }"
                        android:textColor="@color/purple_200"
                        android:textSize="32sp"/>

                    <TextView
                        android:id="@+id/exampleTotalTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        style="@style/b2"
                        android:text="@{ `/` + vm.courseSummary.exerciseProgress.totalQuizCount }"
                        android:textColor="@color/gray_600"/>

                </LinearLayout>


                <View
                    android:id="@+id/lineView2"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="@color/gray_300"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/exampleIv"
                    app:layout_constraintEnd_toStartOf="@+id/patternIv"/>

                <ImageView
                    android:id="@+id/patternIv"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:src="@drawable/learning_course_end_pattern"
                    app:layout_constraintStart_toEndOf="@+id/lineView2"
                    app:layout_constraintEnd_toStartOf="@+id/lineView3"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/patternTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/h6"
                    android:text="유형"
                    app:layout_constraintTop_toBottomOf="@id/patternIv"
                    app:layout_constraintStart_toStartOf="@id/patternIv"
                    app:layout_constraintEnd_toEndOf="@id/patternIv"/>

                <LinearLayout
                    android:id="@+id/patternScoreLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/patternTv"
                    app:layout_constraintStart_toStartOf="@id/lineView2"
                    app:layout_constraintEnd_toEndOf="@id/lineView3">

                    <TextView
                        android:id="@+id/patternSolvedTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_pretendard_bold"
                        android:text="@{ vm.courseSummary.patternProgress.userSolvedCount + `` }"
                        android:textColor="@color/purple_250"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/patternTotalTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        style="@style/b2"
                        android:text="@{ `/` + vm.courseSummary.patternProgress.totalQuizCount }"
                        android:textColor="@color/gray_600"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/patternScorePercentTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/h4"
                    android:text="@{ vm.courseSummary.patternProgress.finalRateStr }"
                    android:textColor="@color/gray_600"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/patternScoreLl"
                    app:layout_constraintStart_toStartOf="@+id/patternScoreLl"
                    app:layout_constraintEnd_toEndOf="@+id/patternScoreLl"
                    />
                <LinearLayout
                    android:id="@+id/patternDiffLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/patternScorePercentTv"
                    app:layout_constraintStart_toStartOf="@+id/patternScorePercentTv"
                    app:layout_constraintEnd_toEndOf="@+id/patternScorePercentTv"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/icon_up_blue"
                        android:visibility="@{ vm.courseSummary.patternProgress.isRateDiffExist ? View.VISIBLE : View.GONE }"
                        />

                    <TextView
                        android:id="@+id/patternDiffPercentTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/b2"
                        android:layout_marginStart="2dp"
                        android:text="@{ vm.courseSummary.patternProgress.rateDiffStr }"
                        android:textColor="@{ vm.courseSummary.patternProgress.isRateDiffExist ? @color/blue_400 : @color/gray_500 }"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />

                </LinearLayout>

                <View
                    android:id="@+id/lineView3"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="@color/gray_300"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/patternIv"
                    app:layout_constraintEnd_toStartOf="@+id/wrongnoteIv"/>
                <ImageView
                    android:id="@+id/wrongnoteIv"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/learning_course_end_wrongnote"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/wrongnoteTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/h6"
                    android:text="남은 오답"
                    app:layout_constraintTop_toBottomOf="@id/wrongnoteIv"
                    app:layout_constraintStart_toStartOf="@id/wrongnoteIv"
                    app:layout_constraintEnd_toEndOf="@id/wrongnoteIv"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/wrongnoteTv"
                    app:layout_constraintStart_toStartOf="@id/lineView3"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/wrongnoteSolvedTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_pretendard_bold"
                        android:text="@{ vm.courseSummary.wrongNoteProgress.remainQuizCount + `` }"
                        android:textColor="@color/red_300"
                        android:textSize="32sp"
                        app:layout_constraintTop_toBottomOf="@id/wrongnoteTv"
                        app:layout_constraintStart_toStartOf="parent" />
                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/subTextTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{ vm.courseSummary.subMessage }"
                style="@style/b2"
                android:textColor="@color/gray_600"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageCl" />
    <!--        imageCl-->

            <Button
                android:id="@+id/moreStudyBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{ vm.courseSummary.studyMessage }"
                style="@style/h4"
                android:layout_marginHorizontal="24dp"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_round_common"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subTextTv" />

            <Button
                android:id="@+id/exitBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="학습 종료하기"
                style="@style/h4"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_gray_300_round_5_ripple"
                app:layout_constraintTop_toBottomOf="@+id/moreStudyBtn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/sprinkleLottieView"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:visibility="@{ vm.showSprinkleView ? View.VISIBLE : View.GONE }"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_fileName="sprinkle_effect.json" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>