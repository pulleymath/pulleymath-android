<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.SnackTestFragViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gray_100_ripple"
        tools:context=".activities.learning.tabFragment.snackTest.SnackTestFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainContentsCl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shadow_left_only"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.575">
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.freewheelin.pulley.activities.learning.tabFragment.snackTest.component.DailyTestSelectorView
            android:id="@+id/dailyContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16"
            android:layout_marginTop="@dimen/dp20"
            android:background="@drawable/bg_common_white_stroke_grey"
            app:layout_constraintBottom_toTopOf="@+id/weeklyContainer"
            app:layout_constraintEnd_toStartOf="@+id/mainContentsCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"></com.freewheelin.pulley.activities.learning.tabFragment.snackTest.component.DailyTestSelectorView>

        <com.freewheelin.pulley.activities.learning.tabFragment.snackTest.component.WeeklyTestSelectorView
            android:id="@+id/weeklyContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_common_white_stroke_grey"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16"
            android:layout_marginTop="@dimen/dp20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dailyContainer"
            app:layout_constraintBottom_toTopOf="@+id/wrongContainer"
            app:layout_constraintEnd_toStartOf="@+id/mainContentsCl">
        </com.freewheelin.pulley.activities.learning.tabFragment.snackTest.component.WeeklyTestSelectorView>

        <com.freewheelin.pulley.activities.learning.tabFragment.snackTest.component.WrongTestSelectorView
            android:id="@+id/wrongContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_common_white_stroke_grey"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16"
            android:layout_marginTop="@dimen/dp20"
            android:layout_marginBottom="@dimen/dp20"
            app:layout_constraintTop_toBottomOf="@+id/weeklyContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/mainContentsCl">
        </com.freewheelin.pulley.activities.learning.tabFragment.snackTest.component.WrongTestSelectorView>

        <View
            android:id="@+id/arrowGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="19dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@+id/mainContentsCl"/>

        <ImageView
            android:id="@+id/arrowIv"
            android:src="@drawable/ic_pointed_triangle_left_18_22_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            app:layout_constraintTop_toTopOf="@+id/dailyContainer"
            app:layout_constraintBottom_toBottomOf="@+id/dailyContainer"
            app:layout_constraintEnd_toStartOf="@+id/arrowGuide"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>