<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.ChallengeCompletedViewModel"/>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="400dp"
        android:background="@color/white"
        android:layout_height="match_parent">
<!--        android:layout_height="@dimen/dp768">-->

        <ScrollView
            android:id="@+id/scrollRootView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scrollRootCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <LinearLayout
                    android:id="@+id/headerLl"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:id="@+id/headerTv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        style="@style/h5"
                        android:text="챌린지 안내"
                        />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        />
                    <ImageButton
                        android:id="@+id/exitBtn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginVertical="16dp"
                        android:gravity="center"
                        android:src="@drawable/icon_x"
                        android:background="@null"
                        android:onClick="@{ () -> vm.exitBtn() }" />

                </LinearLayout>
                <View
                    android:id="@+id/headerBorderView"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/gray_300"
                    app:layout_constraintTop_toBottomOf="@id/headerLl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/infoScrollContainer"
                    android:layout_width="400dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/headerBorderView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/nextChallengeBtnCl">

                    <TextView
                        android:id="@+id/titleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/h4_sb"
                        android:text="와! 미션을 성공했어요!"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="32dp"/>
                    <TextView
                        android:id="@+id/subTitleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/b1r"
                        android:text="다음 미션으로 이동해 진행해보세요:)"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/titleTv"
                        android:layout_marginTop="8dp"/>
                    <androidx.gridlayout.widget.GridLayout
                        android:id="@+id/stampGl"
                        android:layout_width="332dp"
                        android:layout_height="wrap_content"
                        app:rowCount="2"
                        app:columnCount="2"
                        app:orientation="horizontal"
                        android:visibility="@{ vm.showStampGl ? View.VISIBLE : View.GONE }"
                        android:layout_marginTop="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/subTitleTv">

                    </androidx.gridlayout.widget.GridLayout>

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/stampLottie"
                        android:layout_width="@dimen/dp300"
                        android:layout_height="@dimen/dp300"
                        android:layout_marginTop="24dp"
                        android:visibility="@{ vm.showStampAnim ? View.VISIBLE : View.GONE }"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/subTitleTv"
                        app:lottie_fileName="challenge_popup_stamp.json"
                        app:lottie_loop="false" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/nextChallengeBtnCl"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp56"
                    android:background="@drawable/bg_purple_300_round_ripple"
                    android:layout_marginVertical="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:focusable="true"
                    android:clickable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/infoScrollContainer">
                    <!--            android:layout_margin="24dp"-->


                    <TextView
                        android:id="@+id/nextChallengeTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다음 미션으로 이동하기"
                        style="@style/h4"
                        android:textColor="@color/white"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                    <ImageView
                        android:id="@+id/arrowIv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_l1_right"
                        app:tint="@color/white"
                        app:layout_constraintTop_toTopOf="@+id/nextChallengeTv"
                        app:layout_constraintStart_toEndOf="@+id/nextChallengeTv"
                        app:layout_constraintBottom_toBottomOf="@+id/nextChallengeTv"
                        />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

