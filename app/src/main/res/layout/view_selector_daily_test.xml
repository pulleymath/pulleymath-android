<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp32"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        style="@style/TextWhite_ffffff.ExtraBold"
        android:id="@+id/tagTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_grey_e0e0e0_round"
        android:textSize="@dimen/sp12"
        android:text="평일한정"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@+id/titleTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        style="@style/TextGrey_c0c0c0.ExtraBold"
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp24"
        android:textColor="@color/grey_c0c0c0"
        android:text="데일리 테스트"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/guideTv"
        app:layout_constraintTop_toBottomOf="@+id/tagTv"/>


    <TextView
        style="@style/TextGrey_c0c0c0.Bold"
        android:id="@+id/guideTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp14"
        android:textColor="@color/grey_c0c0c0"
        android:lineSpacingExtra="6sp"
        android:layout_marginTop="@dimen/dp16"
        android:text="다음 데일리 테스트는\n월요일 오전 6시에 공개됩니다 :)"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/firstTestIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_1_grey_24"
        app:layout_constraintTop_toTopOf="@+id/titleTv"
        app:layout_constraintBottom_toBottomOf="@+id/titleTv"
        app:layout_constraintStart_toEndOf="@+id/titleTv"/>

    <ImageView
        android:id="@+id/secondTestIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_2_grey_24"
        app:layout_constraintTop_toTopOf="@+id/firstTestIv"
        app:layout_constraintBottom_toBottomOf="@+id/firstTestIv"
        app:layout_constraintStart_toEndOf="@+id/firstTestIv"/>

    <ImageView
        android:id="@+id/thirdTestIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_3_grey_24"
        app:layout_constraintTop_toTopOf="@+id/firstTestIv"
        app:layout_constraintBottom_toBottomOf="@+id/firstTestIv"
        app:layout_constraintStart_toEndOf="@+id/secondTestIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>