<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tagTv"
        style="@style/TextWhite.ExtraBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gray_400_round"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="평일한정"
        android:textSize="@dimen/sp12"
        app:layout_constraintBottom_toTopOf="@+id/titleTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/titleTv"
        style="@style/TextGray_500.ExtraBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="데일리 테스트"
        android:textColor="@color/gray_500"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toTopOf="@+id/guideTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tagTv"
        app:layout_constraintVertical_chainStyle="packed" />


    <TextView
        android:id="@+id/guideTv"
        style="@style/TextGray_500.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="6sp"
        android:text="다음 데일리 테스트는 월요일 오전 6시에 공개됩니다 :)"
        android:maxLines="1"
        android:textColor="@color/gray_500"
        android:textSize="@dimen/sp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTv" />
<!--        android:ellipsize="end"-->

    <ImageView
        android:id="@+id/firstTestIv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_1_grey_24"
        app:layout_constraintBottom_toBottomOf="@+id/titleTv"
        app:layout_constraintStart_toEndOf="@+id/titleTv"
        app:layout_constraintTop_toTopOf="@+id/titleTv" />

    <ImageView
        android:id="@+id/secondTestIv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_2_grey_24"
        app:layout_constraintBottom_toBottomOf="@+id/firstTestIv"
        app:layout_constraintStart_toEndOf="@+id/firstTestIv"
        app:layout_constraintTop_toTopOf="@+id/firstTestIv" />

    <ImageView
        android:id="@+id/thirdTestIv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_3_grey_24"
        app:layout_constraintBottom_toBottomOf="@+id/firstTestIv"
        app:layout_constraintStart_toEndOf="@+id/secondTestIv"
        app:layout_constraintTop_toTopOf="@+id/firstTestIv" />
</androidx.constraintlayout.widget.ConstraintLayout>