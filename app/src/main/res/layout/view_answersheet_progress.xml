<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/psv_answerSheet_customContainer_height"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp64"
    android:paddingStart="@dimen/psv_answerSheet_customContainer_unitStudy_paddingLeft"
    android:paddingEnd="@dimen/dp32">

    <TextView
        style="@style/TextWhite_ffffff.Bold"
        android:id="@+id/todayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp14"
        android:text="푼 문제"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        style="@style/TextWhite_ffffff.Bold"
        android:id="@+id/countTv"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14개"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/todayLabel"
        app:layout_constraintBottom_toBottomOf="@+id/todayLabel"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.freewheelin.pulley.views.LearningProgressView
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:backgroundColor="@color/black_4c4c4c"
        app:progressColor="@color/purple_6D6DFF"
        app:cardCornerRadius="4dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/todayLabel">
    </com.freewheelin.pulley.views.LearningProgressView>

    <TextView
        style="@style/TextGrey_818181.Bold"
        android:id="@+id/guideTv"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp14"
        android:text="목표량 달성을 위해 조금 더 노력해볼까요?"
        android:lineSpacingExtra="6sp"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        app:layout_constraintStart_toStartOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
