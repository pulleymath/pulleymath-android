<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_fafafa"
    android:orientation="vertical"
    android:clickable="true"
    tools:context=".activities.mypage.MySignUpInfoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_ffffff">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@null"
            android:src="@drawable/ic_toolbar_back"
            app:tint="@color/black_4c4c4c"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="버전 정보"
            android:textSize="@dimen/sp24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <View style="@style/Border_Grey_e8e8e8_Horizontal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextGrey_c0c0c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginBottom="@dimen/dp12"
                android:text="버전 정보"
                android:textSize="@dimen/sp16" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white_ffffff"
                android:padding="@dimen/dp32">

                <TextView
                    style="@style/TextBlack_4c4c4c"
                    android:id="@+id/latestVersionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp16"
                    android:text="최신 버전"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c"
                    android:id="@+id/currentVersionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:textSize="@dimen/sp16"
                    android:text="현재 버전"
                    app:layout_constraintTop_toBottomOf="@+id/latestVersionLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    style="@style/TextGrey_c0c0c0"
                    android:id="@+id/latestVersionTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/MyPage_page_contents_start_margin_71dp"
                    android:textSize="@dimen/sp16"
                    android:text="V 1.0.00"
                    app:layout_constraintTop_toTopOf="@+id/latestVersionLabel"
                    app:layout_constraintBottom_toBottomOf="@+id/latestVersionLabel"
                    app:layout_constraintStart_toStartOf="parent" />


                <TextView
                    style="@style/TextGrey_c0c0c0"
                    android:id="@+id/currentVersionTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/MyPage_page_contents_start_margin_71dp"
                    android:textSize="@dimen/sp16"
                    android:text="V 1.0.00"
                    app:layout_constraintTop_toTopOf="@+id/currentVersionLabel"
                    app:layout_constraintBottom_toBottomOf="@+id/currentVersionLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.freewheelin.pulley.views.buttons.PrimaryButton
                    android:id="@+id/updateBtn"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/dp32"
                    android:text="업데이트하기"
                    app:buttonTheme="blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/currentVersionLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>
    </ScrollView>

</LinearLayout>