<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingHorizontal="6dp"
    android:paddingBottom="12dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/ch_layoutLoungeWelcomePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="26dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <com.zoyi.channel.plugin.android.view.layout.AvatarLayout
                android:id="@+id/ch_avatarLoungeWelcomePreview"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                app:ch_avatar_border_radius="15dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/ch_textLoungeWelcomePreviewName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ch_txt_black_darkest"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Name" />

                <com.zoyi.channel.plugin.android.view.textview.EllipsizeTextView
                    android:id="@+id/ch_textLoungeWelcomePreviewMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2sp"
                    android:maxLines="8"
                    android:textColor="@color/ch_txt_black_darkest"
                    android:textSize="15sp"
                    tools:text="preview messages" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/ch_layoutLoungeWelcomeOutOfWorking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="26dp"
            android:paddingBottom="12dp">

            <com.zoyi.channel.plugin.android.view.layout.ChBorderLayout
                android:id="@+id/ch_rootAvatarLayout"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                app:ch_bl_backColor="@color/ch_bgtxt_yellow_lighter"
                app:ch_bl_borderRadius="15dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ch_icon_chat_error_filled"
                    app:tint="@color/ch_bgtxt_yellow_normal" />

            </com.zoyi.channel.plugin.android.view.layout.ChBorderLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.zoyi.channel.plugin.android.view.textview.CHTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ch_txt_black_darkest"
                    android:textSize="13sp"
                    app:ch_tv_textKey="ch.chat.expect_response_delay.out_of_working" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/ch_textLoungeWelcomeOutOfWorkingMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2sp"
                    android:maxLines="8"
                    android:textColor="@color/ch_txt_black_darkest"
                    android:textSize="15sp"
                    tools:text="disabled messages" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <com.zoyi.channel.plugin.android.view.button.ChatStartButton
        android:id="@+id/ch_buttonLoungeWelcomeStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:clipChildren="false" />

    <LinearLayout
        android:id="@+id/ch_buttonLoungeWelcomeWorkingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ch_iconLoungeWelcomeWorkingTimeInfo"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="2dp"
            tools:src="@drawable/ch_icon_chat_error_filled"
            tools:tint="@color/ch_bgtxt_yellow_normal" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ch_textLoungeWelcomeWorkingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ch_txt_black_darker"
            android:textSize="12sp"
            tools:text="@string/ch.chat.expect_response_delay.out_of_working.detail" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ch_iconLoungeWelcomeWorkingTimeChevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ch_icon_chevron_right"
            app:tint="@color/ch_txt_black_darker" />

    </LinearLayout>

</LinearLayout>
