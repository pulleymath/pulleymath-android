<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.MainFViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dim_black_333333_70a"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/guideTextWrappercl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gray_200_round_20"
            android:paddingHorizontal="30dp"
            android:paddingVertical="20dp"
            android:layout_marginBottom="39dp"
            app:layout_constraintBottom_toTopOf="@id/pullingIv"
            app:layout_constraintStart_toStartOf="@id/pullingIv"
            app:layout_constraintEnd_toEndOf="@id/pullingIv">
            <TextView
                android:id="@+id/challengeGuideTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원하는 풀리수학 문제집을 하나 선택해\n문제를 풀고, 유사문제를 만들어봐!"
                style="@style/h5"
                android:gravity="center"
                android:lineHeight="18dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/c1"
                android:textColor="@color/red_300"
                android:text="※ 처음 선택한 문제집을 진행해야 미션이 인정됨"
                app:layout_constraintTop_toBottomOf="@+id/challengeGuideTv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="10dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_pulling_peak"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/pullingIv"
            app:layout_constraintStart_toStartOf="@id/pullingIv"
            app:layout_constraintEnd_toEndOf="@id/pullingIv"/>
        <ImageView
            android:id="@+id/pullingIv"
            android:layout_width="170dp"
            android:layout_height="180dp"
            android:src="@drawable/pulling_character_normal"
            android:layout_marginTop="34dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>