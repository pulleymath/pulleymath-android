<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View"/>
        <variable name="listener" type="com.freewheelin.pulley.revision2021.activity.PdfListActivity.PdfItemClickListener"/>
        <variable name="item" type="com.freewheelin.pulley.revision2021.model.response.Pdf"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.PdfViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{()->listener.onItemClick(item)}"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp24">

        <ImageView
            android:id="@+id/imgCover"
            bind_img_url="@{item.cover_url}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp36"
            android:background="@drawable/bg_white_ffffff"
            android:elevation="5dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="20:27"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/textTitle"
            style="@style/TextBlack_4c4c4c.ExtraBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/dp36"
            android:maxLines="2"
            android:text="@{item.title}"
            android:textSize="@dimen/dp18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgCover" />

        <TextView
            android:id="@+id/textSubject"
            style="@style/TextBlack_4c4c4c.ExtraBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/dp36"
            android:text="@{item.subject}"
            android:textSize="@dimen/dp18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textTitle" />

        <TextView
            android:id="@+id/textPublisher"
            style="@style/TextGrey_9f9f9f.ExtraBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/dp36"
            android:text="@{item.publisher.name}"
            android:textSize="@dimen/dp14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textSubject" />

        <TextView
            android:id="@+id/textCategory"
            style="@style/TextGrey_9f9f9f.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:elevation="5dp"
            android:background="@drawable/bg_grey_f2f2f2_round_2_no_ripple"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="@{item.category}"
            android:textSize="@dimen/dp14"
            app:layout_constraintBottom_toBottomOf="@+id/imgCover"
            app:layout_constraintEnd_toEndOf="@+id/imgCover" />

        <TextView
            android:id="@+id/textNewMark"
            style="@style/TextWhite_ffffff.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_red_fe7b67_round_2_no_ripple"
            android:elevation="5dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="NEW"
            android:textSize="@dimen/dp14"
            android:visibility="@{ item.is_new_mark ? View.VISIBLE : View.INVISIBLE }"
            app:layout_constraintBottom_toBottomOf="@+id/textCategory"
            app:layout_constraintEnd_toStartOf="@+id/textCategory"
            app:layout_constraintTop_toTopOf="@+id/textCategory" />

<!--        <ImageView-->
<!--            android:id="@+id/imgDownload"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:visibility="@{ !item.downloaded &amp;&amp; !item.downloading ? View.VISIBLE : View.INVISIBLE }"-->
<!--            android:elevation="6dp"-->
<!--            app:layout_constraintBottom_toTopOf="@+id/textTitle"-->
<!--            app:layout_constraintEnd_toEndOf="@+id/imgCover"-->
<!--            app:layout_constraintStart_toStartOf="@+id/imgCover"-->
<!--            app:layout_constraintTop_toTopOf="@+id/imgCover"-->
<!--            app:srcCompat="@drawable/ic_download_file" />-->

        <ImageView
            android:id="@+id/imgDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="@{ !item.downloaded &amp;&amp; !item.downloading &amp;&amp; item.is_purchased ? View.VISIBLE : View.INVISIBLE }"
            android:elevation="6dp"
            app:layout_constraintBottom_toTopOf="@+id/textTitle"
            app:layout_constraintEnd_toEndOf="@+id/imgCover"
            app:layout_constraintStart_toStartOf="@+id/imgCover"
            app:layout_constraintTop_toTopOf="@+id/imgCover"
            app:srcCompat="@drawable/ic_download_file" />

        <!-- lock -->
        <FrameLayout
            android:id="@+id/imgLock"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="6dp"
            android:background="@color/dim_black_333333"
            android:visibility="@{ item.is_purchased ? View.INVISIBLE : View.VISIBLE }"
            app:layout_constraintEnd_toEndOf="@+id/imgCover"
            app:layout_constraintStart_toStartOf="@+id/imgCover"
            app:layout_constraintTop_toTopOf="@+id/imgCover"
            app:layout_constraintBottom_toBottomOf="@+id/imgCover">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="7dp"
                app:srcCompat="@drawable/ic_lock_48_white" />

        </FrameLayout>

        <ImageView
            android:id="@+id/imgDownloadCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="@{item.downloading ? View.VISIBLE : View.INVISIBLE}"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/imgDownload"
            app:layout_constraintEnd_toEndOf="@+id/imgDownload"
            app:layout_constraintStart_toStartOf="@+id/imgDownload"
            app:layout_constraintTop_toTopOf="@+id/imgDownload"
            app:srcCompat="@drawable/ic_download_cancel" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/dp72"
            android:layout_height="@dimen/dp72"
            android:indeterminate="false"
            android:progressDrawable="@drawable/circular_progress_bar"
            android:background="@drawable/circle_shape"
            style="?android:attr/progressBarStyleHorizontal"
            android:elevation="6dp"
            android:indeterminateTint="@color/purple_6D6DFF"
            android:max="100"
            android:progress="@{item.downloadProgress}"
            android:visibility="@{item.downloading ? View.VISIBLE : View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/imgDownload"
            app:layout_constraintEnd_toEndOf="@+id/imgDownload"
            app:layout_constraintStart_toStartOf="@+id/imgDownload"
            app:layout_constraintTop_toTopOf="@+id/imgDownload" />

        <ProgressBar
            android:id="@+id/openingProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/dp72"
            android:layout_height="@dimen/dp72"
            android:indeterminateTint="@color/purple_6D6DFF"
            android:visibility="@{item.opening ? View.VISIBLE : View.INVISIBLE}"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/imgDownload"
            app:layout_constraintEnd_toEndOf="@+id/imgDownload"
            app:layout_constraintStart_toStartOf="@+id/imgDownload"
            app:layout_constraintTop_toTopOf="@+id/imgDownload" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>