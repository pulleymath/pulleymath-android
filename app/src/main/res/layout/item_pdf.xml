<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View"/>
        <variable name="listener" type="com.freewheelin.pulley.revision2021.activity.PdfListActivity.PdfItemClickListener"/>
        <variable name="item" type="com.freewheelin.pulley.revision2021.model.response.Pdf"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.PdfViewModel"/>
        <variable name="isGuestUser" type="Boolean"/>

    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_200"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{()->listener.onItemClick(item)}"
        android:layout_marginStart="@dimen/dp14"
        android:layout_marginEnd="@dimen/dp14"
        android:layout_marginTop="@dimen/dp32"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardRootCl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <ImageView
                android:id="@+id/imgCover"
                bind_img_url="@{item.landscape_cover_url}"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@tools:sample/avatars" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/gradient_top_to_bottom"
                visibleIf="@{ item.isLocked }"
                app:layout_constraintTop_toTopOf="@+id/imgCover"
                app:layout_constraintStart_toStartOf="@+id/imgCover"
                app:layout_constraintEnd_toEndOf="@+id/imgCover"
                app:layout_constraintBottom_toBottomOf="@+id/imgCover"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                app:layout_constraintTop_toTopOf="@+id/imgCover"
                app:layout_constraintStart_toStartOf="@+id/imgCover">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_lock_24_white"
                    visibleIf="@{ !isGuestUser &amp;&amp; item.isLocked }"
                    />

            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bodyCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:background="@drawable/bg_white_ripple_gray_200"
                app:layout_constraintTop_toBottomOf="@+id/imgCover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/publisherTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/b3"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gray_600"
                    android:text="@{ item.publisher.name + `(` + item.category + `)` , default = 진학사_심화서}"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
                <LinearLayout
                    android:id="@+id/bookInfoLl"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/publisherTv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/bookNameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/h4"
                        android:textColor="@color/gray_800"
                        android:text="@{ item.title , default = 블랙라벨블랙라벨}"
                        />
                    <TextView
                        android:id="@+id/bookSubjectTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/h6"
                        android:textColor="@color/gray_800"
                        android:text="@{ item.subject , default = 수학_상}"
                        android:layout_marginTop="4dp"
                        />

                </LinearLayout>



                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/downloadCl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:visibility="@{ isGuestUser ? (item.isLocked ? View.INVISIBLE : View.VISIBLE) : !item.downloaded &amp;&amp; !item.downloading &amp;&amp; !item.isLocked ? View.VISIBLE : View.INVISIBLE }"
                    android:background="@drawable/bg_purple_100_round_ripple"
                    app:layout_constraintVertical_bias="1"
                    app:layout_constraintTop_toBottomOf="@id/bookInfoLl"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/downloadIv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_download_slim"
                        visibleIf="@{ !isGuestUser }"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/downloadTv"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"/>
                    <TextView
                        android:id="@+id/downloadTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/h6"
                        android:text="@{ isGuestUser ? `가입하면` : `다운로드` }"
                        android:textColor="@color/purple_300"
                        android:layout_marginVertical="8dp"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/downloadIv"
                        app:layout_constraintEnd_toStartOf="@+id/freeTv"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:id="@+id/freeTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="무료"
                        style="@style/h6"
                        visibleIf="@{ item.is_event_book }"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/white"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_red_300_round"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/downloadTv"
                        app:layout_constraintEnd_toEndOf="parent"

                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/downloadProgressCl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    visibleIf="@{ item.downloading }"
                    android:background="@drawable/bg_purple_100_round_ripple"
                    app:layout_constraintVertical_bias="1"
                    app:layout_constraintTop_toBottomOf="@id/bookInfoLl"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ProgressBar
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:progress="@{ item.downloadProgress }"
                        android:progressDrawable="@drawable/progress_bar_linear"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/downloadProgressTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/h6"
                        android:text="취소"
                        android:textColor="@{ item.downloading ? item.downloadProgress > 50 ? @color/white : @color/purple_300 : @color/purple_300 }"
                        android:layout_marginVertical="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:id="@+id/loadingContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                visibleIf="@{ item.opening }"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    app:lottie_speed="1"
                    app:lottie_repeatMode="restart"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_fileName="circle_loading.json"/>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>
</layout>