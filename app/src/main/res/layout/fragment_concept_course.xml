<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.fragments.ConceptCourseFragment">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.ConceptCourseViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_100">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/studyRv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            bind_study_chapter="@{ vm.chapterList }"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tutorialCl1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/dim_black_333333_70a"
            android:visibility="gone"
            android:focusable="true"
            android:clickable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상위 10%의 풀리수학 학생들은\n튜토리얼을 마치고 바로 학습을 시작했어!"
                android:background="@drawable/bg_gray_200_round_20"
                style="@style/h4"
                android:gravity="center"
                android:paddingHorizontal="30dp"
                android:paddingVertical="20dp"
                android:layout_marginBottom="39dp"
                app:layout_constraintBottom_toTopOf="@id/pullingIv"
                app:layout_constraintStart_toStartOf="@id/pullingIv"
                app:layout_constraintEnd_toEndOf="@id/pullingIv"/>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pulling_peak"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toTopOf="@id/pullingIv"
                app:layout_constraintStart_toStartOf="@id/pullingIv"
                app:layout_constraintEnd_toEndOf="@id/pullingIv"/>
            <ImageView
                android:id="@+id/pullingIv"
                android:layout_width="170dp"
                android:layout_height="220dp"
                android:src="@drawable/pulling_character"
                android:layout_marginTop="34dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tutorialCl2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/dim_black_333333_70a"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tutoral2TitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OOO 학생도 바로 학습을 시작해\n소단원 하나만 끝내볼까?"
                android:background="@drawable/bg_gray_200_round_20"
                style="@style/h4"
                android:gravity="center"
                android:paddingHorizontal="30dp"
                android:paddingVertical="20dp"
                android:layout_marginBottom="39dp"
                app:layout_constraintBottom_toTopOf="@id/pullingIv2"
                app:layout_constraintStart_toStartOf="@id/pullingIv2"
                app:layout_constraintEnd_toEndOf="@id/pullingIv2"/>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pulling_peak"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toTopOf="@id/pullingIv2"
                app:layout_constraintStart_toStartOf="@id/pullingIv2"
                app:layout_constraintEnd_toEndOf="@id/pullingIv2"/>
            <ImageView
                android:id="@+id/pullingIv2"
                android:layout_width="170dp"
                android:layout_height="220dp"
                android:src="@drawable/pulling_character2"
                android:layout_marginTop="34dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <Button
                android:id="@+id/pullingBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_round_common_round_10"
                android:text="개념학습 시작하기! >"
                android:paddingVertical="16dp"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="44dp"
                app:layout_constraintTop_toBottomOf="@id/pullingIv2"
                app:layout_constraintStart_toStartOf="@id/pullingIv2"
                app:layout_constraintEnd_toEndOf="@id/pullingIv2"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

<!--        android:background="@color/gray_100"-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conceptFragProgressCl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/gray_100"
            android:visibility="@{ vm.showProgress ? View.VISIBLE : View.GONE }"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ProgressBar
                android:id="@+id/studyProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/purple_200"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>