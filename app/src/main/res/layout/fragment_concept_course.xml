<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.fragments.ConceptCourseFragment">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.ConceptCourseViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_200">


<!--            android:layout_marginTop="@dimen/dp24"-->
        <HorizontalScrollView
            android:id="@+id/horizontalTabSv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:background="@color/gray_200"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/headerTabContainer2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/dp24"
                android:paddingHorizontal="@dimen/dp48"
                />
<!--                android:layout_marginStart="@dimen/dp48"-->
<!--                android:layout_marginEnd="@dimen/dp48"-->
        </HorizontalScrollView>

        <View
            android:id="@+id/gradationView"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@+id/horizontalTabSv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/gradient_shadow_concept_course_header"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/studyRv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            bind_study_chapter="@{ vm.chapterList }"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="@+id/gradationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

<!--            android:minHeight="700dp"-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conceptFragProgressCl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/gray_200"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontalTabSv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
<!--            android:visibility="@{ vm.isLoading ? View.VISIBLE : View.GONE }"-->

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/loadingLottie"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:lottie_speed="1"
                app:lottie_repeatMode="restart"
                app:lottie_loop="true"
                app:lottie_fileName="circle_loading.json"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>