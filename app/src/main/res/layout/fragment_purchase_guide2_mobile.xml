<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2023.ui.fragment.PurchaseGuide2MobileFragment">

    <data>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.PurchaseGuideViewModel"/>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:background="@color/white">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scrollRootCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >
                <LinearLayout
                    android:id="@+id/headerLl"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:id="@+id/headerTv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        style="@style/h5"
                        android:text="풀리수학+"
                        />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        />
                    <ImageButton
                        android:id="@+id/exitBtn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginVertical="16dp"
                        android:gravity="center"
                        android:src="@drawable/icon_x"
                        android:background="@null"
                        android:onClick="@{ () -> vm.exitBtn() }" />

                </LinearLayout>

                <View
                    android:id="@+id/headerBorder"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/gray_300"
                    app:layout_constraintTop_toBottomOf="@+id/headerLl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/scrollBodyCl"
                    android:layout_width="440dp"
                    android:layout_height="wrap_content"
                    android:background="@color/gray_200"
                    android:paddingHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/headerBorder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/footerCl"
                    >

                    <LinearLayout
                        android:id="@+id/guideTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <Button
                            android:id="@+id/fixedTermBtn"
                            android:layout_width="93dp"
                            android:layout_height="28dp"
                            style="@style/b3"
                            android:background="@{ vm.step2TabIndex == 0 ? @drawable/bg_gray_800_round_left_corner : @drawable/bg_white_round_left_corner_stroke_gray_800, default=@drawable/bg_gray_800_round_left_corner }"
                            android:text="기간 이용권"
                            android:textColor="@{ vm.step2TabIndex == 0 ? @color/white : @color/gray_800, default=@color/white }"
                            android:gravity="center"
                            android:focusable="true"
                            android:clickable="true"
                            />
                        <Button
                            android:id="@+id/subscriptionBtn"
                            android:layout_width="93dp"
                            android:layout_height="28dp"
                            style="@style/b3"
                            android:background="@{ vm.step2TabIndex == 1 ? @drawable/bg_gray_800_round_right_corner : @drawable/bg_white_round_right_corner_stroke_gray_800, default=@drawable/bg_white_round_right_corner_stroke_gray_800 }"
                            android:text="정기 구독"
                            android:textColor="@{ vm.step2TabIndex == 1 ? @color/white : @color/gray_800, default=@color/gray_800 }"
                            android:gravity="center"
                            android:focusable="true"
                            android:clickable="true"
                            />
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/compareCl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="center"
                        android:padding="10dp"
                        app:layout_constraintTop_toTopOf="@+id/guideTab"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/guideTab"
                        >

                        <TextView
                            android:id="@+id/compareTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="멤버십 비교"
                            style="@style/b3"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            />

                        <View
                            android:id="@+id/lineView"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:background="@color/gray_800"
                            android:layout_marginBottom="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>

<!--                        android:minHeight="400dp"-->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/guideRv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/guideTab"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="24dp"
                        android:paddingBottom="12dp"
                        />

<!--                    <LinearLayout-->
<!--                        android:id="@+id/guideLl"-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:minHeight="400dp"-->
<!--                        android:orientation="vertical"-->
<!--                        app:layout_constraintTop_toBottomOf="@+id/step3Tv"-->
<!--                        app:layout_constraintStart_toStartOf="parent"-->
<!--                        app:layout_constraintEnd_toEndOf="parent"-->
<!--                        app:layout_constraintBottom_toBottomOf="parent"/>-->

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/footerCl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingBottom="24dp"
                    android:background="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/descriptionTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="공부해보고 7일이내 100% 전액 환불!"
                        android:textColor="@color/purple_300"
                        style="@style/c1"
                        android:layout_marginVertical="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/actionBtn"/>

                    <com.freewheelin.pulley.revision2023.ui.view.CommonButton
                        android:id="@+id/actionBtn"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp56"
                        android:text="구매하러 가기"
                        style="@style/h5"
                        android:textColor="@color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            visibleIf="@{ vm.isLoading() }"
            app:layout_constraintTop_toTopOf="@+id/scrollRoot"
            app:layout_constraintStart_toStartOf="@id/scrollRoot"
            app:layout_constraintEnd_toEndOf="@id/scrollRoot"
            app:layout_constraintBottom_toBottomOf="@id/scrollRoot"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>