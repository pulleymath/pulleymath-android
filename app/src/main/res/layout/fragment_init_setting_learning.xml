<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp48"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step1"
                style="@style/TextGrey_c0c0c0.Bold"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                android:background="@drawable/bg_grey_f2f2f2_stroke_grey_e8e8e8_circle"
                android:gravity="center"
                android:text="1"
                android:textSize="@dimen/sp16" />

            <ImageView
                android:id="@+id/step1ComplteIv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_check_grey_engrave"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/step1Label"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="개인 정보"
                android:textSize="@dimen/sp16" />

            <View
                style="@style/Border_Grey_e8e8e8_Horizontal"
                android:layout_width="@dimen/dp16"
                android:layout_height="1dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/step2"
                style="@style/TextWhite_ffffff.ExtraBold"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                android:background="@drawable/bg_purple_6d6dff_circle"
                android:gravity="center"
                android:text="2"
                android:textSize="@dimen/sp16" />

            <TextView
                android:id="@+id/step2Label"
                style="@style/TextPurple_6d6dff.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="학습 정보"
                android:textSize="@dimen/sp16" />

            <View
                style="@style/Border_Grey_e8e8e8_Horizontal"
                android:layout_width="@dimen/dp16"
                android:layout_height="1dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/step3"
                style="@style/TextGrey_c0c0c0.Bold"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                android:background="@drawable/bg_grey_f2f2f2_stroke_grey_e8e8e8_circle"
                android:gravity="center"
                android:text="3"
                android:textSize="@dimen/sp16" />

            <TextView
                android:id="@+id/step3Label"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="선택 과목"
                android:textSize="@dimen/sp16" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/step2Body"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp32"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/sp12"
                android:text="풀고 싶은 대단원을 선택해주세요!\n문제를 추천해드릴게요 :)"
                android:textSize="@dimen/sp24" />

            <TextView
                style="@style/TextRed_fe7b67"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:gravity="center_horizontal"
                android:text="일정량의 학습 데이터가 쌓일 때까지 선택한대로 추천됩니다!"
                android:textSize="@dimen/sp14" />

            <com.freewheelin.pulley.views.DaebakInputSelection
                android:id="@+id/mathTopSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                app:DaebakInputSelection_Label="수학(상)" />

            <com.freewheelin.pulley.views.DaebakInputSelection
                android:id="@+id/mathBottomSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                app:DaebakInputSelection_Label="수학(하)" />

            <com.freewheelin.pulley.views.DaebakInputSelection
                android:id="@+id/math1Selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                app:DaebakInputSelection_Label="수학I" />

            <com.freewheelin.pulley.views.DaebakInputSelection
                android:id="@+id/math2Selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                app:DaebakInputSelection_Label="수학II" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp48">

                <com.freewheelin.pulley.views.Buttons.SecondaryButton
                    android:id="@+id/prevBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp56"
                    android:text="이전"
                    app:buttonTheme="grey"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/nextBtn"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.freewheelin.pulley.views.Buttons.PrimaryButton
                    android:id="@+id/nextBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp56"
                    android:layout_marginStart="@dimen/dp24"
                    android:text="다음"
                    app:buttonTheme="blue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/prevBtn"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

