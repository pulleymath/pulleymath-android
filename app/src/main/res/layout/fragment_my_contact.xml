<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_fafafa"
    android:orientation="vertical"
    android:clickable="true"
    tools:context=".activities.mypage.MySignUpInfoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_ffffff">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@null"
            android:src="@drawable/ic_toolbar_back"
            app:tint="@color/black_4c4c4c"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1:1 문의하기"
            android:textSize="@dimen/sp24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <View style="@style/Border_Grey_e8e8e8_Horizontal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextGrey_c0c0c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginBottom="@dimen/dp12"
                android:text="문의하기"
                android:textSize="@dimen/sp16" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white_ffffff"
                android:padding="@dimen/dp32">

                <TextView
                    style="@style/TextBlack_4c4c4c"
                    android:id="@+id/topGuideTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp16"
                    android:lineSpacingExtra="@dimen/sp8"
                    android:text="문의하시기 전,\n자주 묻는 질문 한 번 확인 부탁드립니다 :)"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c"
                    android:id="@+id/contactTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp16"
                    android:lineSpacingExtra="@dimen/sp8"
                    android:text="답변은 영업일 기준 2주 내로\n풀리수학에 가입하신 고객님의 이메일로 보내드립니다."
                    android:layout_marginTop="@dimen/dp24"
                    app:layout_constraintTop_toBottomOf="@+id/topGuideTv"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c.ExtraBold"
                    android:id="@+id/kakaoGuideTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp16"
                    android:lineSpacingExtra="@dimen/sp8"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="카카오톡 @풀리는수학 으로 문의 남겨주시면\n더 빠른 답변을 받으실 수 있습니다."
                    app:layout_constraintTop_toBottomOf="@+id/contactTv"
                    app:layout_constraintStart_toStartOf="parent"/>

                <com.freewheelin.pulley.views.buttons.SecondaryButton
                    android:id="@+id/contactBtn"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="문의 글 작성하기"
                    app:buttonTheme="grey"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/kakaoGuideTv" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>
    </ScrollView>

</LinearLayout>