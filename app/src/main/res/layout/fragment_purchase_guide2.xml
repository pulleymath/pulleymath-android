<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2023.ui.fragment.PurchaseGuide2Fragment">

    <data>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.PurchaseGuideDialogViewModel"/>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/headerLl"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:id="@+id/headerTv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="16dp"
                style="@style/h5"
                android:text="구매하기"
                />
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
            <ImageButton
                android:id="@+id/exitBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="16dp"
                android:gravity="center"
                android:src="@drawable/icon_x"
                android:background="@null"
                android:onClick="@{ () -> vm.exitBtn() }" />
            <!--                    여기서 src를 isPaidUser로 분기 -->
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/gray_300"
            app:layout_constraintTop_toBottomOf="@+id/headerLl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ScrollView
            android:id="@+id/scrollRoot"
            android:layout_width="400dp"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toBottomOf="@id/headerLl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/actionBtnWrapperCl"
            android:layout_marginBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scrollRootCl"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:background="@color/gray_200"
                android:paddingHorizontal="24dp">

                <TextView
                    android:id="@+id/step3Tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="구독제 비교"
                    style="@style/b3"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/guideRv"
                    android:layout_width="0dp"
                    android:layout_height="400dp"
                    app:layout_constraintTop_toBottomOf="@+id/step3Tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            visibleIf="@{ vm.isLoading() }"
            app:layout_constraintTop_toTopOf="@+id/scrollRoot"
            app:layout_constraintStart_toStartOf="@id/scrollRoot"
            app:layout_constraintEnd_toEndOf="@id/scrollRoot"
            app:layout_constraintBottom_toBottomOf="@id/scrollRoot"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/actionBtnWrapperCl"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:layout_margin="24dp"
            android:clickable="true"
            android:background="@{ vm.selectedOfferId > 0 ? @drawable/bg_btn_round_common : @drawable/bg_purple_300_disable_round }"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:focusable="true">
<!--            app:layout_constraintTop_toBottomOf="@+id/scrollRoot"-->

            <TextView
                android:id="@+id/actionTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/h5"
                android:textColor="@color/white"
                android:text="구매하러 가기"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>