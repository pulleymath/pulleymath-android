<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerCl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextGray_800.Bold"
            android:id="@+id/numTv"
            android:layout_width="@dimen/dp40"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="번호"
            android:textSize="@dimen/sp14"
            android:background="@color/gray_100"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            android:id="@+id/startBorder"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/gray_300"
            app:layout_constraintTop_toTopOf="@+id/numTv"
            app:layout_constraintBottom_toBottomOf="@+id/numTv"
            app:layout_constraintStart_toStartOf="@+id/numTv"/>

        <View
            android:id="@+id/numberEndBorder"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/gray_300"
            app:layout_constraintTop_toTopOf="@+id/numTv"
            app:layout_constraintBottom_toBottomOf="@+id/numTv"
            app:layout_constraintEnd_toEndOf="@+id/numTv"/>

        <ImageView
            style="@style/TextGray_800.Bold"
            android:id="@+id/resultIv"
            android:layout_width="@dimen/dp72"
            android:layout_height="0dp"
            android:gravity="center"
            android:textSize="@dimen/sp14"
            android:scaleType="centerInside"
            android:src="@drawable/ic_result_correct"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/numTv"/>

        <TextView
            style="@style/TextGray_800"
            android:id="@+id/resultTv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="-"
            android:textSize="@dimen/sp14"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="@+id/resultIv"
            app:layout_constraintBottom_toBottomOf="@+id/resultIv"
            app:layout_constraintStart_toStartOf="@+id/resultIv"
            app:layout_constraintEnd_toEndOf="@+id/resultIv"/>

        <View
            android:id="@+id/resultEndBorder"
            android:layout_width="1dp"
            android:layout_height="@dimen/dp16"
            android:background="@color/gray_300"
            app:layout_constraintStart_toEndOf="@+id/resultIv"
            app:layout_constraintBottom_toBottomOf="@+id/resultIv"
            app:layout_constraintTop_toTopOf="@+id/resultIv"/>

        <TextView
            style="@style/TextGray_800"
            android:id="@+id/correctRateTv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="N등급 정답률"
            android:textSize="@dimen/sp14"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/resultIv"
            app:layout_constraintEnd_toStartOf="@+id/leftCenterVerticalBorder"/>

        <View
            android:id="@+id/leftCenterVerticalBorder"
            android:layout_width="1dp"
            android:layout_height="@dimen/dp16"
            android:background="@color/gray_300"
            app:layout_constraintStart_toEndOf="@+id/correctRateTv"
            app:layout_constraintEnd_toStartOf="@+id/wrongCntTv"
            app:layout_constraintBottom_toBottomOf="@+id/resultIv"
            app:layout_constraintTop_toTopOf="@+id/resultIv"/>

        <TextView
            style="@style/TextGray_800.Bold"
            android:id="@+id/wrongCntTv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="전체 틀린 횟수"
            android:textSize="@dimen/sp14"
            app:layout_constraintStart_toEndOf="@+id/leftCenterVerticalBorder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#c0fafafa"
            android:id="@+id/clearContainerCl"
            app:layout_constraintStart_toEndOf="@+id/numberEndBorder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/clearIv"
                android:src="@drawable/ic_check_green_circle_w48"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/clearLabel"/>

            <TextView
                style="@style/TextGreen_300.Bold"
                android:id="@+id/clearLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="@dimen/sp14"
                android:text="클리어 완료"
                app:layout_constraintStart_toEndOf="@+id/clearIv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View style="@style/Border_Gray_300_Horizontal"
            android:id="@+id/bottomBorder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            android:background="@color/gray_300"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:id="@+id/endBorder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>