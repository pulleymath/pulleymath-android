<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <com.zoyi.channel.plugin.android.view.layout.ChBorderLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:ch_bl_backColor="@color/ch_bg_black_lighter"
        app:ch_bl_borderColor="@color/ch_bg_transparent"
        app:ch_bl_borderRadius="@dimen/ch_app_messenger_border_bottom_sheet_radius_size">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ch_imageIntegrationMessengerApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ch_imageIntegrationAnotherApp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:tint="@color/ch_txt_black_darker"
            tools:src="@drawable/ch_icon_call"
            tools:visibility="visible" />

    </com.zoyi.channel.plugin.android.view.layout.ChBorderLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/ch_textIntegrationAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/ch_txt_black_dark"
        android:textSize="13sp"
        tools:text="전화" />

</LinearLayout>
