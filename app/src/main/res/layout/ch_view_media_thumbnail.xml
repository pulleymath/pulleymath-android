<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/ch_layoutMediaThumbnailVideos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ch_black"
        android:visibility="gone"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/ch_layoutMediaThumbnailPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ch_black">

        <ImageView
            android:id="@+id/ch_imageMediaThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/ch_layoutPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ch_grey200">

            <ImageView
                android:id="@+id/ch_imagePlaceholder"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:src="@drawable/ch_icon_imagefail" />

        </FrameLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/ch_viewPlayerDuration"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:background="@drawable/ch_rect__black_gradient_50"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/ch_textPlayerDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:textColor="@color/ch_white"
            android:textSize="12sp"
            tools:text="0:32" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/ch_viewPlayerController"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ch_transparent"
        android:visibility="gone"
        tools:visibility="visible">

        <com.zoyi.channel.plugin.android.view.layout.ChBorderLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            app:ch_bl_backColor="@color/ch_bgtxt_absolute_black_light"
            app:ch_bl_borderRadius="24dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ch_play"
                app:tint="@color/ch_bg_white_normal" />

        </com.zoyi.channel.plugin.android.view.layout.ChBorderLayout>

    </FrameLayout>

</FrameLayout>
