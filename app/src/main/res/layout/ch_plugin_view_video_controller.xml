<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/ch_black_70"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:paddingTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/ch_exo_rew"
                style="@style/ChExoMediaButton.Rewind" />

            <ImageButton
                android:id="@id/ch_exo_play"
                style="@style/ChExoMediaButton.Play" />

            <ImageButton
                android:id="@id/ch_exo_pause"
                style="@style/ChExoMediaButton.Pause" />

            <ImageButton
                android:id="@id/ch_exo_ffwd"
                style="@style/ChExoMediaButton.FastForward" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/exo_download"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@color/ch_transparent"
            android:scaleType="center"
            android:src="@drawable/ch_plugin_download_white" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@id/ch_exo_position"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:includeFontPadding="false"
            android:textColor="@color/ch_white_70"
            android:textSize="14sp" />

        <com.zoyi.com.google.android.exoplayer2.ui.DefaultTimeBar
            android:id="@id/ch_exo_progress"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1" />

        <TextView
            android:id="@id/ch_exo_duration"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:includeFontPadding="false"
            android:textColor="@color/ch_white_70"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>