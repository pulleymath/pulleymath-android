<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.zoyi.channel.plugin.android.activity.chat.view.reactions.ReactionsTabLayout
        android:id="@+id/ch_viewReactionsTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ch_recyclerViewReactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:overScrollMode="never"
            android:visibility="invisible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.zoyi.channel.plugin.android.view.external.cpv.CircularProgressView
            android:id="@+id/ch_progressReactions"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            app:ch_cpv_animAutostart="true"
            app:ch_cpv_color="@color/ch_grey500"
            app:ch_cpv_indeterminate="true"
            app:ch_cpv_thickness="2dp" />

    </FrameLayout>

</LinearLayout>
