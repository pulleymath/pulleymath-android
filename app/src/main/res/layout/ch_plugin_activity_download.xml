<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_black_40">

    <RelativeLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_centerInParent="true"
        android:background="@drawable/ch_plugin_download_loading">

        <com.zoyi.channel.plugin.android.view.layout.DownloadProgressBar
            android:id="@+id/ch_progressDownload"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerInParent="true"
            app:ch_progress="0"
            app:ch_progressBarThickness="2dp"
            app:ch_progressbarColor="@color/ch_white" />

        <ImageView
            android:id="@+id/ch_imageDownloadDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:src="@drawable/ch_plugin_check"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/ch_buttonDownloadCancel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ch_transparent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:tint="@color/ch_white"
                android:src="@drawable/ch_plugin_cancel" />

        </FrameLayout>

    </RelativeLayout>

</RelativeLayout>
