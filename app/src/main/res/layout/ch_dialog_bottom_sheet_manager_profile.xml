<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ch_bg_white_normal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ch.manager.profile"
            android:textColor="@color/ch_txt_black_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.zoyi.channel.plugin.android.component.bezier.BezierButton
            android:id="@+id/ch_buttonManagerProfileBottomSheetClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ch_btn_backColor="@color/ch_bg_black_lighter"
            app:ch_btn_contentColor="@color/ch_txt_black_dark"
            app:ch_btn_leftIcon="@drawable/ch_icon_cancel"
            app:ch_btn_size="xs"
            app:ch_btn_type="secondary" />

    </LinearLayout>

    <com.zoyi.channel.plugin.android.view.layout.AvatarLayout
        android:id="@+id/ch_avatarManagerProfileBottomSheet"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="24dp"
        app:ch_avatar_border_radius="50.4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ch_textManagerProfileBottomSheetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/ch_txt_black_darkest"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="George" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ch_textManagerProfileBottomSheetDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:textColor="@color/ch_txt_black_dark"
            android:textSize="14sp"
            tools:text="All in one business messanger\nChannel talk" />

        <LinearLayout
            android:id="@+id/ch_layoutManagerProfileBottomSheetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/ch_buttonManagerProfileBottomSheetPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ch_bg_transparent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ch_icon_mobile"
                        app:tint="@color/ch_txt_black_dark" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/ch_textManagerProfileBottomSheetPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:textColor="@color/ch_txt_black_darker"
                        android:textSize="15sp"
                        tools:text="+82 10-1234-5678" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/ch_buttonManagerProfileBottomSheetEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ch_bg_transparent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ch_icon_email"
                        app:tint="@color/ch_txt_black_dark" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/ch_textManagerProfileBottomSheetEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:textColor="@color/ch_txt_black_darker"
                        android:textSize="15sp"
                        tools:text="george@channel.io" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
