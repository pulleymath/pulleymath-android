<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp48"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/checkIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check_purple"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@+id/pageTv"
        app:layout_constraintTop_toTopOf="@+id/pageTv"
        app:layout_constraintBottom_toBottomOf="@+id/pageTv"/>
    <TextView
        style="@style/TextBlack_4c4c4c.Bold"
        android:id="@+id/pageTv"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp14"
        android:textColor="@color/black_4c4c4c"
        android:gravity="center_horizontal"
        android:text="6p"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>