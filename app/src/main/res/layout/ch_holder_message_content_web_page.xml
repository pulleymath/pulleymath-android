<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ch_rootMessageWebPage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ch_chat_message_divide_height"
    android:background="@drawable/ch_background_webpage">

    <com.zoyi.channel.plugin.android.view.media_thumbnail.WebPageMediaThumbnailView
        android:id="@+id/ch_thumbnailMessageWebPage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ch_layoutMessageWebPageMeta"
        app:layout_constraintDimensionRatio="H,1000:524"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ch_layoutMessageWebPageMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ch_bg_black_lighter"
        android:divider="@drawable/ch_divider_2dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:showDividers="middle"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ch_thumbnailMessageWebPage"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ch_textMessageWebPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="1sp"
            android:maxLines="2"
            android:textColor="@color/ch_txt_black_darkest"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="채널톡 업데이트 소식 소식 소식 소식 소식 소식 소식 소식 소식 소식 소식 소식"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ch_textMessageWebPageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2sp"
            android:maxLines="2"
            android:textColor="@color/ch_txt_black_dark"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="2020년 8월 6일 활용도가 WOW! 고대 파일 발굴단 출동 👮asdoasudbosaudb️"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/ch_layoutMessageWebPagePublisher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ch_iconMessageWebPagePublisher"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                tools:src="@drawable/ch_icon_youtube"
                tools:tint="@color/ch_bgtxt_red_normal"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/ch_textMessageWebPagePublisher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="3dp"
                android:textColor="@color/ch_txt_black_darker"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="YouTube"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
