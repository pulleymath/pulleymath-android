<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View"/>
        <variable name="listener" type="com.freewheelin.pulley.activities.learning.tabFragment.affiliatedTest.AffiliatedTestFragment.AffiliatedTestItemClickListener"/>
        <variable name="item" type="com.freewheelin.pulley.revision2021.model.response.AffiliatedTestCard"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.AffiliatedTestViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/testItemCl"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{()->listener.onItemClick(item)}"
        android:orientation="vertical"
        android:background="@{item.isSelected ? @drawable/shadow_border_purple : item.isCompleted ? @drawable/shadow_false_no_border : @drawable/shadow }"
        >
        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="4dp"
            android:text="@{item.firstWorkbook.test_source + `학교 제휴`}"
            style="@style/mo_h6"
            android:textColor="@color/white_ffffff"
            android:background="@drawable/bg_green_046b08_round"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" >

            <ImageView
                android:id="@+id/test1Iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                app:imageResource="@{item.workbookOrderResource(1)}"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/test2Iv"
                />

            <ImageView
                android:id="@+id/test2Iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                app:imageResource="@{item.workbookOrderResource(2)}"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/test3Iv"
                />
            <ImageView
                android:id="@+id/test3Iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:imageResource="@{item.workbookOrderResource(3)}"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/titleTv"
            style="@style/h4"
            android:textColor="@{item.isCompleted ? @color/gray_500 : @color/gray_800 }"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            android:text="@{item.group_title}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{item.firstWorkbook.remainingTimeText}"
            android:textColor="@color/red_300"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp24"
            android:visibility="@{item.firstWorkbook.isCompleted ? View.INVISIBLE : View.VISIBLE }"
            style="@style/b2"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:src="@mipmap/kudoctor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>