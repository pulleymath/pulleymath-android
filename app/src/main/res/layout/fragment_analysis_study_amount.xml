<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp32"
        android:paddingEnd="@dimen/dp32"
        android:paddingBottom="@dimen/dp64"
        tools:context=".activities.analysis.tabFragment.AnalysisStudyAmountFragment">

        <TextView
            style="@style/TextGrey_c0c0c0"
            android:id="@+id/summaryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp18"
            android:text="기간/과목별 학습량"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/summaryLeftContainerCl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
            app:layout_constraintWidth_percent="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/summaryLabel">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/periodCntContainerCl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp48"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:id="@+id/periodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="지난 7일 학습량"
                    android:textSize="@dimen/sp18"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/periodTotalCntTv"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/periodTotalCntTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="93문제"
                    android:textSize="@dimen/sp24"
                    android:layout_marginTop="8dp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toBottomOf="@+id/periodLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lastCompareCl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                app:layout_constraintTop_toBottomOf="@+id/periodCntContainerCl"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:id="@+id/lastPeriodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="지난 7일 학습량"
                    android:textSize="18sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/lastPeriodCompCntUtv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


                <com.freewheelin.pulley.views.textViews.UpDownTextView
                    style="@style/TextBlue_30a4ff.Bold"
                    android:id="@+id/lastPeriodCompCntUtv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lastPeriodLabel"
                    app:layout_constraintHorizontal_chainStyle="packed"/>
            </androidx.constraintlayout.widget.ConstraintLayout>



            <View style="@style/Border_Grey_e8e8e8_Vertical"
                android:id="@+id/verticalBorder"
                android:layout_height="32dp"
                android:layout_marginTop="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/lastCompareCl"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View style="@style/Border_Grey_e8e8e8_Horizontal"
                android:id="@+id/horizontalBorder"
                android:layout_width="240dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/verticalBorder"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/testCntContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                app:layout_constraintTop_toBottomOf="@+id/horizontalBorder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:id="@+id/testCntLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEST"
                    android:textSize="@dimen/sp18"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/testCntTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12개"
                    android:textSize="@dimen/sp24"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/testCntLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/unitCntContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                app:layout_constraintTop_toBottomOf="@+id/testCntContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:id="@+id/unitCntLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="유형학습"
                    android:textSize="@dimen/sp18"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/unitCntTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="35개"
                    android:textSize="@dimen/sp24"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/unitCntLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mockCntContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                app:layout_constraintTop_toBottomOf="@+id/unitCntContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:id="@+id/mockCntLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모의고사"
                    android:textSize="@dimen/sp18"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/mockCntTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30개"
                    android:textSize="@dimen/sp24"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/mockCntLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/plusIv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_plus_16"
                android:layout_marginTop="@dimen/dp32"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mockCntContainer"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wrongCntContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:layout_marginBottom="@dimen/dp64"
                app:layout_constraintTop_toBottomOf="@+id/plusIv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:id="@+id/wrongCntLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오답학습"
                    android:textSize="@dimen/sp18"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/wrongCntTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14개"
                    android:textSize="@dimen/sp24"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/wrongCntLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dp16"
            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
            app:layout_constraintTop_toTopOf="@+id/summaryLeftContainerCl"
            app:layout_constraintBottom_toBottomOf="@+id/summaryLeftContainerCl"
            app:layout_constraintStart_toEndOf="@+id/summaryLeftContainerCl"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                style="@style/TextBlack_4c4c4c"
                android:id="@+id/subjectGuideTv"
                android:textSize="@dimen/sp24"
                android:text="확률과 통계를 집중해서 공부했네요."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp48"
                android:layout_marginStart="@dimen/dp40"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <com.freewheelin.pulley.views.charts.RingChart
                android:id="@+id/ringChart"
                android:layout_width="@dimen/Report_StudyAmount_ringChart_width"
                android:layout_height="@dimen/Report_StudyAmount_ringChart_width"
                android:layout_marginStart="@dimen/Report_StudyAmount_ringChart_start_margin"
                android:layout_marginTop="@dimen/dp120"
                app:layout_constraintTop_toBottomOf="@+id/subjectGuideTv"
                app:layout_constraintStart_toStartOf="parent">
            </com.freewheelin.pulley.views.charts.RingChart>

            <LinearLayout
                android:id="@+id/legendContainerLl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp32"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp32"
                android:paddingEnd="@dimen/dp32"
                app:layout_constraintTop_toTopOf="@+id/ringChart"
                app:layout_constraintBottom_toBottomOf="@+id/ringChart"
                app:layout_constraintStart_toEndOf="@+id/ringChart">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="@dimen/dp56">
                    <View
                        android:id="@+id/firstLegend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_grey_9f9f9f_circle"
                        app:layout_constraintStart_toEndOf="@+id/ringChart"
                        app:layout_constraintTop_toTopOf="@+id/ringChart"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:id="@+id/firstLegendTv"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:text="확률과 통계efefef"
                        android:textSize="@dimen/sp18"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>

                    <TextView
                        style="@style/TextGrey_c0c0c0.Bold"
                        android:id="@+id/firstLegendCntTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginStart="8dp"
                        android:textSize="@dimen/sp18"
                        android:text="40개"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="@dimen/dp56">
                    <View
                        android:id="@+id/secondLegend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_grey_9f9f9f_circle"
                        app:layout_constraintStart_toEndOf="@+id/ringChart"
                        app:layout_constraintTop_toTopOf="@+id/ringChart"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:id="@+id/secondLegendTv"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:text="확률과 통계"
                        android:textSize="@dimen/sp18"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>

                    <TextView
                        style="@style/TextGrey_c0c0c0.Bold"
                        android:id="@+id/secondLegendCntTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginStart="8dp"
                        android:textSize="@dimen/sp18"
                        android:text="40개"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="@dimen/dp56">
                    <View
                        android:id="@+id/thirdLegend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_grey_9f9f9f_circle"
                        app:layout_constraintStart_toEndOf="@+id/ringChart"
                        app:layout_constraintTop_toTopOf="@+id/ringChart"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:id="@+id/thirdLegendTv"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:text="확률과 통계"
                        android:textSize="@dimen/sp18"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>

                    <TextView
                        style="@style/TextGrey_c0c0c0.Bold"
                        android:id="@+id/thirdLegendCntTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginStart="8dp"
                        android:textSize="@dimen/sp18"
                        android:text="40개"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="@dimen/dp56">
                    <View
                        android:id="@+id/fourthLegend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_grey_9f9f9f_circle"
                        app:layout_constraintStart_toEndOf="@+id/ringChart"
                        app:layout_constraintTop_toTopOf="@+id/ringChart"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:id="@+id/fourthLegendTv"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:text="확률과 통계"
                        android:textSize="@dimen/sp18"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>

                    <TextView
                        style="@style/TextGrey_c0c0c0.Bold"
                        android:id="@+id/fourthLegendCntTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginStart="8dp"
                        android:textSize="@dimen/sp18"
                        android:text="40개"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="@dimen/dp56">
                    <View
                        android:id="@+id/fifthLegend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_grey_9f9f9f_circle"
                        app:layout_constraintStart_toEndOf="@+id/ringChart"
                        app:layout_constraintTop_toTopOf="@+id/ringChart"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:id="@+id/fifthLegendTv"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:text="확률과 통계"
                        android:textSize="@dimen/sp18"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>

                    <TextView
                        style="@style/TextGrey_c0c0c0.Bold"
                        android:id="@+id/fifthLegendCntTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginStart="8dp"
                        android:textSize="@dimen/sp18"
                        android:text="40개"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="@dimen/dp56">
                    <View
                        android:id="@+id/sixthLegend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_grey_9f9f9f_circle"
                        app:layout_constraintStart_toEndOf="@+id/ringChart"
                        app:layout_constraintTop_toTopOf="@+id/ringChart"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:id="@+id/sixthLegendTv"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:text="확률과 통계"
                        android:textSize="@dimen/sp18"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>

                    <TextView
                        style="@style/TextGrey_c0c0c0.Bold"
                        android:id="@+id/sixthLegendCntTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginStart="8dp"
                        android:textSize="@dimen/sp18"
                        android:text="40개"
                        app:layout_constraintTop_toTopOf="@+id/firstLegend"
                        app:layout_constraintBottom_toBottomOf="@+id/firstLegend"
                        app:layout_constraintStart_toEndOf="@+id/firstLegend"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/summaryEmptyGuideTv"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="조금 더 학습을 진행하시면,\n
    각 과목별 학습량을 볼 수 있습니다."
                android:textSize="@dimen/sp16"
                android:lineSpacingExtra="@dimen/sp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            style="@style/TextGrey_c0c0c0"
            android:id="@+id/bigUnitAmountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp18"
            android:text="대단원별 학습량"
            android:layout_marginTop="@dimen/dp48"
            app:layout_constraintTop_toBottomOf="@+id/summaryLeftContainerCl"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bigUnitAmountContainerCl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
            app:layout_constraintTop_toBottomOf="@+id/bigUnitAmountLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                style="@style/TextBlack_4c4c4c"
                android:id="@+id/unitGuideTv"
                android:textSize="@dimen/sp24"
                android:text="지수 학습량이 많았어요."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp48"
                android:layout_marginStart="@dimen/dp40"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                style="@style/TextGrey_c0c0c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
