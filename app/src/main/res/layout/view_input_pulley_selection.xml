<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        style="@style/TextGray_800"
        android:id="@+id/labelTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp18"
        android:text="확률과 통계"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelTv">

        <com.freewheelin.pulley.legacy.views.SelectionButton
            android:id="@+id/btn1"
            style="@style/TextGray_800.Bold"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp48"
            android:paddingHorizontal="20dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_white_stroke_gray_300_round_24"
            android:text="이차곡선"
            android:textSize="@dimen/sp16" />

        <com.freewheelin.pulley.legacy.views.SelectionButton
            android:id="@+id/btn2"
            style="@style/TextGray_800.Bold"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp48"
            android:paddingHorizontal="20dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_white_stroke_gray_300_round_24"
            android:text="이차곡선"
            android:textSize="@dimen/sp16"/>

        <com.freewheelin.pulley.legacy.views.SelectionButton
            android:id="@+id/btn3"
            style="@style/TextGray_800.Bold"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp48"
            android:paddingHorizontal="20dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_white_stroke_gray_300_round_24"
            android:text="이차곡선"
            android:textSize="@dimen/sp16" />

        <com.freewheelin.pulley.legacy.views.SelectionButton
            android:id="@+id/btn4"
            style="@style/TextGray_800.Bold"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp48"
            android:paddingHorizontal="20dp"
            android:background="@drawable/bg_white_stroke_gray_300_round_24"
            android:text="다항식의 곱셈과 인수분해"
            android:textSize="@dimen/sp16" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>