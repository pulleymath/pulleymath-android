<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.learningcourse.fragments.pattern.PatternSolutionFragment">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.pattern.PatternSolutionViewModel"/>
    </data>


    <ScrollView
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/scrollRootLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="24dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/solutionInfoCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/answerTitleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/h5"
                    android:text="정답 : "
                    android:lineHeight="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/answerTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ vm.quiz.answerWithIcon() }"
                    android:textSize="20sp"
                    style="@style/mo_h2"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@+id/answerTitleTv"
                    app:layout_constraintTop_toTopOf="@+id/answerTitleTv"
                    app:layout_constraintBottom_toBottomOf="@+id/answerTitleTv"/>

                <TextView
                    android:id="@+id/barTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    style="@style/b2"
                    android:lineHeight="24dp"
                    android:textColor="@color/gray_300"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@+id/answerTv"
                    app:layout_constraintTop_toTopOf="@+id/answerTv"
                    app:layout_constraintBottom_toBottomOf="@+id/answerTv"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ `정답률 ` + vm.quiz.correctAnswerRateLimit100 + `%` }"
                    android:textSize="14sp"
                    android:textColor="@color/gray_600"
                    android:layout_marginStart="12dp"
                    app:layout_constraintTop_toTopOf="@+id/barTv"
                    app:layout_constraintStart_toEndOf="@+id/barTv"
                    app:layout_constraintBottom_toBottomOf="@+id/barTv"
                    />




            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="해설"
                style="@style/mo_h2"
                android:lineHeight="24dp"
                android:layout_marginTop="56dp"
                />

        </LinearLayout>
    </ScrollView>
</layout>