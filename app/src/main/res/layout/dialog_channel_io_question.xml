<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/rootView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topContainerCl"
            android:layout_width="500dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_white_round_top_only">

            <TextView
                style="@style/h3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="질문하기"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/xBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@null"
                android:src="@drawable/ic_x_grey_19dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                style="@style/Border_Gray_300_Horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_round_bottom_only">


                <LinearLayout
                    android:id="@+id/imageLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="유형 문제 이미지"
                        style="@style/b1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="궁금한 점을 자세하게 작성하면, 빠르고 정확한 답변을 받을 수 있어요!"
                        style="@style/b3"
                        android:gravity="center"
                        android:textColor="@color/gray_600"
                        android:layout_marginStart="8dp"
                        />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/screenShotCardView"
                    android:layout_width="340dp"
                    app:cardCornerRadius="5dp"
                    android:elevation="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/imageLl"
                    app:layout_constraintStart_toStartOf="parent">

                    <!--            <com.freewheelin.pulley.revision2021.views.CustomYoutubePlayerView-->
                    <!--                android:id="@+id/videoPlayerView"-->
                    <!--                android:layout_width="match_parent"-->
                    <!--                android:layout_height="wrap_content"/>-->
                    <ImageView
                        android:id="@+id/screenShotIv"
                        android:layout_width="wrap_content"
                        android:layout_height="180dp"
                        app:layout_constraintTop_toBottomOf="@+id/imageLl"
                        app:layout_constraintStart_toStartOf="parent"/>


                </androidx.cardview.widget.CardView>

                <TextView
                    style="@style/b1"
                    android:id="@+id/detailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp36"
                    android:textSize="@dimen/sp16"
                    android:text="무엇이 궁금한가요?"
                    app:layout_constraintTop_toBottomOf="@+id/screenShotCardView"
                    app:layout_constraintStart_toStartOf="parent" />

                <RadioGroup
                    android:id="@+id/detailRg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp16"
                    android:paddingStart="@dimen/dp12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/detailLabel">

                    <RadioButton
                        style="@style/b1r"
                        android:id="@+id/detail1"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp36"
                        android:textSize="@dimen/sp16"
                        android:text="일부 해설이 이해가 안 가요."/>
                    <RadioButton
                        style="@style/b1r"
                        android:id="@+id/detail2"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp36"
                        android:textSize="@dimen/sp16"
                        android:text="문제 및 해설 전체가 이해가 안 가요."/>
                    <RadioButton
                        style="@style/b1r"
                        android:id="@+id/detail3"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp36"
                        android:textSize="@dimen/sp16"
                        android:text="자세한 해설을 알고 싶어요."/>
                    <RadioButton
                        style="@style/b1r"
                        android:id="@+id/detail4"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp36"
                        android:textSize="@dimen/sp16"
                        android:text="기타"/>

                </RadioGroup>

                <TextView
                    style="@style/b1"
                    android:id="@+id/describeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp48"
                    android:textSize="@dimen/sp16"
                    android:text="간단한 설명을 추가해주세요."
                    app:layout_constraintTop_toBottomOf="@+id/detailRg"
                    app:layout_constraintStart_toStartOf="parent" />


                <EditText
                    android:id="@+id/describeEt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp80"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginEnd="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp16"
                    android:background="@drawable/bg_white_stroke_gray_500_round"
                    android:textColorHint="@color/gray_500"
                    android:hint="예) 해설에서 선분 AB가 왜 a+b 인지 모르겠어요."
                    android:textSize="@dimen/sp16"
                    android:gravity="top"
                    android:padding="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/describeLabel"/>

                <Button
                    android:id="@+id/submitBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp56"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginTop="24dp"
                    android:text="제출하기"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_btn_round_common"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/describeEt" />
<!--                    android:background="@{ ? @drawable/bg_btn_round_common : @drawable/bg_purple_300_disable_round }"-->

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </LinearLayout>
</layout>