<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        style="@style/TextGrey_c0c0c0"
        android:id="@+id/firstLabelTv"
        android:layout_width="@dimen/dp90"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:text="3등급 평균"
        android:textSize="@dimen/sp18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.freewheelin.pulley.views.Bars.PenBar_R
        android:id="@+id/firstPen"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:progressColor="@color/grey_e0e0e0"
        app:valueLabelColor="@color/grey_c0c0c0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/firstLabelTv"
        app:layout_constraintBottom_toBottomOf="@+id/firstLabelTv"
        app:layout_constraintStart_toEndOf="@+id/firstLabelTv">
<!--        app:valueLabelColor="@color/grey_c0c0c0"-->
    </com.freewheelin.pulley.views.Bars.PenBar_R>

    <TextView
        style="@style/TextBlack_4c4c4c"
        android:id="@+id/secondLabelTv"
        android:layout_width="@dimen/dp90"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:text="내 정답률"
        android:textSize="@dimen/sp18"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/firstLabelTv"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.freewheelin.pulley.views.Bars.PenBar_R
        android:id="@+id/secondPen"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:progressColor="@color/grey_e0e0e0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/secondLabelTv"
        app:layout_constraintBottom_toBottomOf="@+id/secondLabelTv"
        app:layout_constraintStart_toEndOf="@+id/secondLabelTv">

    </com.freewheelin.pulley.views.Bars.PenBar_R>

    <TextView
        style="@style/TextGrey_c0c0c0"
        android:id="@+id/thirdLabelTv"
        android:layout_width="@dimen/dp90"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:text="2등급 평균"
        android:textSize="@dimen/sp18"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/secondLabelTv"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.freewheelin.pulley.views.Bars.PenBar_R
        android:id="@+id/thirdPen"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:progressColor="@color/grey_e0e0e0"
        app:layout_constraintEnd_toEndOf="parent"
        app:valueLabelColor="@color/grey_c0c0c0"
        app:layout_constraintTop_toTopOf="@+id/thirdLabelTv"
        app:layout_constraintBottom_toBottomOf="@+id/thirdLabelTv"
        app:layout_constraintStart_toEndOf="@+id/thirdLabelTv">

<!--        app:valueLabelColor="@color/grey_c0c0c0"-->
    </com.freewheelin.pulley.views.Bars.PenBar_R>

</merge>