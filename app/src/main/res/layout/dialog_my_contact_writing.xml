<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="960dp"
        android:layout_height="600dp"
        android:focusableInTouchMode="true"
        android:background="@drawable/bg_gray_100_round_ripple">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topContainerCl"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_white_round_top_only"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                style="@style/TextGray_800.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="문의 글 작성하기"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageButton
                android:id="@+id/xBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@null"
                android:src="@drawable/ic_x_grey_19dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <View style="@style/Border_Gray_300_Horizontal"
                android:layout_width="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/topContainerCl"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.freewheelin.pulley.legacy.views.ArduousSpinner
                    android:id="@+id/categorySpinner"
                    android:layout_width="160dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="32dp"
                    app:defaultStr="문의 유형 선택"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <LinearLayout
                    android:id="@+id/categoryErrorLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/categorySpinner"
                    app:layout_constraintBottom_toBottomOf="@+id/categorySpinner"
                    app:layout_constraintStart_toEndOf="@+id/categorySpinner">

                    <ImageView
                        android:id="@+id/exclamation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_exclamation_red"
                        app:layout_constraintTop_toTopOf="@+id/categorySpinner"
                        app:layout_constraintBottom_toBottomOf="@+id/categorySpinner"
                        app:layout_constraintStart_toEndOf="@+id/categorySpinner"/>

                    <TextView
                        style="@style/TextRed_300.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp"
                        android:text="문의 유형을 선택해주세요."/>
                </LinearLayout>

                <com.freewheelin.pulley.legacy.views.editText.DaebakInputField
                    android:id="@+id/titleDif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    app:DaebakInputField_Label="제목"
                    app:layout_constraintTop_toBottomOf="@+id/categorySpinner"/>

                <TextView
                    style="@style/TextGray_800"
                    android:id="@+id/contentsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="내용 입력"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/titleDif"/>


                <EditText
                    style="@style/TextGray_800"
                    android:id="@+id/contentsEt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="196dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:padding="16dp"
                    android:gravity="top"
                    android:textSize="16sp"
                    android:textColorHint="@color/gray_500"
                    android:hint="문의 내역을 입력해주세요.(10자 이상)\n최대한 빠르게 답변드릴게요 :)"
                    android:background="@drawable/bg_white_stroke_gray_500"
                    app:layout_constraintTop_toBottomOf="@+id/contentsLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <LinearLayout
                    android:id="@+id/contentsErrorLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/contentsEt"
                    app:layout_constraintStart_toStartOf="@+id/contentsEt">

                    <ImageView
                        android:id="@+id/exclamation2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_exclamation_red"
                        app:layout_constraintTop_toTopOf="@+id/categorySpinner"
                        app:layout_constraintBottom_toBottomOf="@+id/categorySpinner"
                        app:layout_constraintStart_toEndOf="@+id/categorySpinner"/>

                    <TextView
                        style="@style/TextRed_300.Bold"
                        android:id="@+id/contentsErrorTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp"
                        android:text="내용을 입력해주세요"/>
                </LinearLayout>

                <com.freewheelin.pulley.revision2023.ui.view.CommonButton
                    android:id="@+id/completeBtn"
                    android:layout_width="200dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="32dp"
                    android:layout_marginTop="25dp"
                    android:text="작성 완료"
                    android:textSize="18sp"
                    app:layout_constraintTop_toBottomOf="@+id/contentsErrorLl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>