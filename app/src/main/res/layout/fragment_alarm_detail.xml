<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.AlarmViewModel"/>
        <variable name="item" type="com.freewheelin.pulley.revision2021.model.response.Alarm"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_white_round_ripple"
        android:focusable="true"
        android:clickable="true"
        android:orientation="vertical"
        tools:context=".activities.mypage.MyMainPageFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerCl"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_left_24"
                app:tint="@color/gray_800"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:onClick="@{()->vm.backToList()}"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/icon_x"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:onClick="@{()->vm.closeActivity()}" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/topBorder"
            style="@style/Border_Gray_300_Horizontal"
            app:layout_constraintTop_toBottomOf="@id/headerCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/dateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/mo_b1"
            android:textColor="@color/gray_600"
            android:maxLines="1"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="@{item.getDetailMessageTime()}"
            app:layout_constraintTop_toBottomOf="@id/topBorder"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/mo_h4_sb"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="@{item.title}"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/dateTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bodyCl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_gray_100"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"
            app:layout_constraintBottom_toTopOf="@+id/detailBtn">

            <TextView
                android:id="@+id/bodyTv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                style="@style/mo_b1r"
                android:scrollbars="vertical"
                android:scrollbarStyle="insideOverlay"
                android:scrollbarThumbVertical="@drawable/width_8_bg_grey_e0e0e0_round_padding_r_8"
                android:text="@{item.contents}"
                android:layout_margin="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.freewheelin.pulley.revision2023.ui.view.CommonButton
            android:id="@+id/detailBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="자세히보기"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            android:visibility="@{item.linkUrl.length > 0 ? View.VISIBLE : View.GONE}"
            android:onClick="@{(v) -> vm.goLinkUrl(item.linkUrl, v)}"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>