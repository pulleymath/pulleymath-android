<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingVertical="6dp"
    android:paddingStart="16dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/ch_textHolderItemLanguageEntryLocalizedName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ch_txt_black_darkest"
        android:textSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/ch_textHolderItemLanguageEntryName"
        app:layout_constraintEnd_toStartOf="@id/ch_iconHolderItemLanguageEntryCheck"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="한국어" />

    <TextView
        android:id="@+id/ch_textHolderItemLanguageEntryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ch_txt_black_dark"
        android:textSize="13sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ch_iconHolderItemLanguageEntryCheck"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ch_textHolderItemLanguageEntryLocalizedName"
        tools:text="Korean" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ch_iconHolderItemLanguageEntryCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ch_icon_check"
        app:tint="@color/ch_txt_black_darkest"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
