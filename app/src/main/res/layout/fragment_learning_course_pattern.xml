<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.learningcourse.fragments.LCPatternFragment">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.LCPatternViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerCl"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/patternHeaderLeftLl"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="left"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/titleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ vm.patternName }"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="32dp"
                    style="@style/h5"/>

<!--                    android:textColor="@{ vm.isClickd() ? @color/ } vm.selectedQuizIndex == 3"-->
                <Button
                    android:id="@+id/mainPatternbtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/purple_300"
                    android:background="@{ vm.selectedQuizIndex == 0 ? @drawable/bg_pattern_index_btn_selected : @drawable/bg_btn_round_non_stroke }"
                    android:text="대표"
                    style="@style/mo_h5"
                    android:layout_gravity="center_vertical"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="16dp"
                    android:onClick="@{() -> vm.setViewPagerPosition(pagerWrapper, 0) }"/>

<!--                 현재 해당 인덱스일때 true, 해당문제를 풀었을때 true -->
                <Button
                    android:id="@+id/patternQuiz1Btn"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:textColor="@{ vm.patternQuiz1.isCorrect != null ? @color/purple_300 : @color/gray_800 }"
                    android:background="@{ vm.selectedQuizIndex == 1 ? (vm.patternQuiz1.isCorrect == null ? @drawable/bg_gray_300_stroke_purple_300_round_5_ripple : @drawable/bg_purple_100_stroke_purple_300_round_5_ripple) : (vm.patternQuiz1.isCorrect == null ? @drawable/bg_gray_300_round_5_ripple : @drawable/bg_purple_100_round_ripple)}"
                    android:text="1"
                    style="@style/mo_h5"
                    android:layout_gravity="center_vertical"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="8dp"
                    android:onClick="@{() -> vm.setViewPagerPosition(pagerWrapper, 1)}"/>

                <Button
                    android:id="@+id/patternQuiz2Btn"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:textColor="@{ vm.patternQuiz2.isCorrect != null ? @color/purple_300 : @color/gray_800 }"
                    android:background="@{ vm.selectedQuizIndex == 2 ? (vm.patternQuiz2.isCorrect == null ? @drawable/bg_gray_300_stroke_purple_300_round_5_ripple : @drawable/bg_purple_100_stroke_purple_300_round_5_ripple) : (vm.patternQuiz2.isCorrect == null ? @drawable/bg_gray_300_round_5_ripple : @drawable/bg_purple_100_round_ripple)}"
                    android:text="2"
                    style="@style/mo_h5"
                    android:layout_gravity="center_vertical"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="8dp"
                    android:onClick="@{() -> vm.setViewPagerPosition(pagerWrapper, 2)}"/>

                <Button
                    android:id="@+id/patternQuiz3Btn"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:textColor="@{ vm.patternQuiz3.isCorrect != null ? @color/purple_300 : @color/gray_800 }"
                    android:background="@{ vm.selectedQuizIndex == 3 ? (vm.patternQuiz3.isCorrect == null ? @drawable/bg_gray_300_stroke_purple_300_round_5_ripple : @drawable/bg_purple_100_stroke_purple_300_round_5_ripple) : (vm.patternQuiz3.isCorrect == null ? @drawable/bg_gray_300_round_5_ripple : @drawable/bg_purple_100_round_ripple)}"
                    android:text="3"
                    style="@style/mo_h5"
                    android:layout_gravity="center_vertical"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="8dp"
                    android:onClick="@{() -> vm.setViewPagerPosition(pagerWrapper, 3)}"/>


<!--                <Button-->
<!--                    android:id="@+id/appendHintBtn"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    style="@style/mo_h4"-->
<!--                    android:textColor="@color/white"-->
<!--                    android:text="@{ vm.hintBtnText }"-->
<!--                    android:visibility="@{ vm.selectedQuizIndex == 0 ? View.GONE : vm.remainingHintSizeLive == 0 ? View.GONE : View.VISIBLE }"-->
<!--                    android:layout_marginVertical="10dp"-->
<!--                    android:paddingHorizontal="16dp"-->
<!--                    android:layout_marginStart="16dp"-->
<!--                    android:background="@drawable/bg_btn_round_common"-->
<!--                    />-->

                <LinearLayout
                    android:id="@+id/appendHintBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_round_common"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="@{ vm.hintExist ? (vm.selectedQuizIndex == 0 ? View.GONE : vm.remainingHintSizeLive == 0 ? View.GONE : View.VISIBLE) : View.GONE}"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="16dp"
                    android:orientation="horizontal"
                    >

                    <TextView
                        android:id="@+id/resetHintBtnTv2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        style="@style/h6"
                        android:text="힌트"
                        android:gravity="center"
                        android:textColor="@color/white" />
                    <TextView
                        android:id="@+id/resetHintBtnTv3"
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        style="@style/h6"
                        android:text="@{ vm.remainingHintSizeLive + `` }"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:background="@drawable/bg_white_round_5"
                        android:textColor="@color/purple_300"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resetHintBtnLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gray_300_round_5_ripple"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="@{ vm.hintExist ? (vm.selectedQuizIndex == 0 ? View.GONE : vm.remainingHintSizeLive == 0 ? View.VISIBLE : View.GONE) : View.GONE }"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="16dp"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:id="@+id/resetHintBtnIv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_refresh"/>

                    <TextView
                        android:id="@+id/resetHintBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        style="@style/h6"
                        android:text="힌트"
                        android:gravity="center"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/patternHeaderRightLl"
                android:layout_width="400dp"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    />


<!--                <LinearLayout-->
<!--                    android:id="@+id/questionBtnLl"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:background="@drawable/bg_purple_100_round_ripple"-->
<!--                    android:paddingHorizontal="12dp"-->
<!--                    android:paddingVertical="8dp"-->
<!--                    android:focusable="true"-->
<!--                    android:clickable="true"-->
<!--                    android:layout_marginVertical="10dp"-->
<!--                    android:layout_marginEnd="16dp"-->
<!--                    android:orientation="horizontal"-->
<!--                    android:visibility="@{ vm.selectedQuizIndex == 0  ? View.GONE : View.VISIBLE }"-->
<!--                    >-->

<!--                    <ImageView-->
<!--                        android:id="@+id/questionBtnIv"-->
<!--                        android:layout_width="20dp"-->
<!--                        android:layout_height="20dp"-->
<!--                        android:src="@drawable/ic_question_outlined"/>-->

<!--                    <TextView-->
<!--                        android:id="@+id/questionBtnTv"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="match_parent"-->
<!--                        style="@style/h6"-->
<!--                        android:text="질문하기"-->
<!--                        android:gravity="center"-->
<!--                        android:textColor="@color/purple_300"-->
<!--                        android:layout_marginStart="4dp"/>-->

<!--                </LinearLayout>-->


                <Button
                    android:id="@+id/conceptSolutionToggleBtn"
                    android:textColor="@color/gray_800"
                    style="@style/mo_h5"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="10dp"
                    android:layout_marginEnd="16dp"
                    android:paddingHorizontal="12dp"
                    android:visibility="@{ vm.selectedQuizIndex == 0 ? View.GONE : View.VISIBLE }"
                    android:background="@drawable/bg_pattern_index_btn"
                    android:text="개념 | 정답 보기"/>
<!--                    android:text="@{ vm.isDrawerOpened ? `개념/정답 닫기` : `개념/정답 보기` }"/>-->

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/headerBottomBorder"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/gray_300"
            app:layout_constraintTop_toBottomOf="@+id/headerCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.freewheelin.pulley.revision2021.views.LCPatternViewPager
            android:id="@+id/pagerWrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/headerBottomBorder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>