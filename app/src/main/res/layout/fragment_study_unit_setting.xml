<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:background="@drawable/bg_gray_100_round_ripple"
        tools:context="com.freewheelin.pulley.legacy.activities.learning.tabFragment.main.mypage.StudyCommonUnitSettingFragment">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_toolbar_back"
            android:paddingTop="@dimen/dp48"
            android:paddingStart="@dimen/dp48"
            android:paddingEnd="@dimen/dp48"
            android:paddingBottom="@dimen/dp24"
            android:background="@null"
            app:tint="@color/gray_800"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            style="@style/TextGray_800.Bold"
            android:id="@+id/titleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp24"
            android:layout_marginStart="@dimen/dp48"
            android:text="학습추천을 최적화하려면 정보가 필요해요 :)"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/backBtn"/>

        <TextView
            style="@style/TextGray_800.Bold"
            android:id="@+id/guideTopLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="충분한 데이터가 쌓일 때까지, 선택한 단원에 맞춰 문항을 추천합니다 :)"
            android:layout_marginStart="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintTop_toBottomOf="@+id/titleLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            style="@style/TextRed_300.Bold"
            android:id="@+id/guideBottomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="본인의 진도에 맞는 단원을 정확히 선택해 주세요 :)"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/guideTopLabel"
            app:layout_constraintStart_toStartOf="@+id/guideTopLabel"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginTop="@dimen/dp48"
            android:layout_marginStart="@dimen/dp48"
            android:layout_marginEnd="@dimen/dp48"
            app:layout_constraintTop_toBottomOf="@+id/guideBottomLabel"
            app:layout_constraintBottom_toTopOf="@+id/modifyBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.freewheelin.pulley.legacy.views.DaebakInputSelection
                    android:id="@+id/mathTopSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:DaebakInputSelection_Label="수학(상)" />

                <com.freewheelin.pulley.legacy.views.DaebakInputSelection
                    android:id="@+id/mathBottomSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    app:DaebakInputSelection_Label="수학(하)" />

                <com.freewheelin.pulley.legacy.views.DaebakInputSelection
                    android:id="@+id/math1Selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp48"
                    app:DaebakInputSelection_Label="수학I" />

                <com.freewheelin.pulley.legacy.views.DaebakInputSelection
                    android:id="@+id/math2Selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    app:DaebakInputSelection_Label="수학II" />

                <com.freewheelin.pulley.legacy.views.DaebakInputSelection
                    android:id="@+id/probAnsStatSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp48"
                    app:DaebakInputSelection_Label="확률과 통계" />

                <com.freewheelin.pulley.legacy.views.DaebakInputSelection
                    android:id="@+id/calculusSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    app:DaebakInputSelection_Label="미적분" />

                <com.freewheelin.pulley.legacy.views.DaebakInputSelection
                    android:id="@+id/geometrySelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    app:DaebakInputSelection_Label="기하" />
            </LinearLayout>
        </ScrollView>



        <com.freewheelin.pulley.revision2023.ui.view.CommonButton
            android:id="@+id/modifyBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:layout_marginStart="@dimen/dp48"
            android:layout_marginEnd="@dimen/dp48"
            android:layout_marginBottom="@dimen/dp48"
            android:text="@string/text_do_edit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>