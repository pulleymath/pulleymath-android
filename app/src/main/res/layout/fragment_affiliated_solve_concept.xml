<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.fragments.AffiliatedSolveConceptFragment">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.AffiliatedSolveConceptViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:tag="conceptFragment"
        >

        <com.freewheelin.pulley.legacy.views.DisableVerticalScrollView
            android:id="@+id/conceptContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:padding="1dp"
            android:scrollbars="none"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/problemInfoContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        style="@style/TextGray_800.ExtraBold"
                        android:id="@+id/answerTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp18"
                        android:text="@{`정답: ` + vm.currentProblem.answer + ``}"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TextGray_600.Bold"
                        android:id="@+id/lvTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp14"
                        android:text="@{`난이도 : ` + vm.currentProblem.levelString() + ``}"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@+id/answerTv"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TextGray_600.Bold"
                        android:id="@+id/pointTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp14"
                        android:text="@{`배점 : ` + vm.currentProblem.point + ``}"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@+id/lvTv"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TextGray_600.Bold"
                        android:id="@+id/referenceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="@dimen/sp14"
                        android:visibility="@{ vm.currentProblem.referenceVisible() ? View.VISIBLE : View.GONE }"
                        android:text="@{`문제 출처 : ` + vm.currentProblem.reference + ``}"
                        app:layout_constraintTop_toBottomOf="@+id/pointTv"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TextGray_600.Bold"
                        android:id="@+id/intentionTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="@dimen/sp14"
                        android:text="@{`출제 의도 : ` + vm.currentProblem.intention + ``}"
                        app:layout_constraintTop_toBottomOf="@+id/referenceLabel"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:id="@+id/solutionIv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp32"
                    android:paddingEnd="@dimen/dp32"
                    android:paddingBottom="@dimen/dp64"
                    android:paddingTop="@dimen/dp32"
                    imgRes="@{vm.currentProblem.answer_img_url}"
                    android:scaleType="fitStart"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/problemInfoContainer" />
                <com.freewheelin.pulley.legacy.views.memoView.MemoView
                    android:id="@+id/solutionMemoView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <!--            android:visibility="gone"-->
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.freewheelin.pulley.legacy.views.DisableVerticalScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
