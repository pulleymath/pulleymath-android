<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:background="@color/white"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >
    <LinearLayout
        android:id="@+id/mainPanelLl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gray_100_stroke_gray_300_round_10"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/undoBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:background="@null"
            android:layout_marginEnd="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_undo"/>

        <ImageButton
            android:id="@+id/redoBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:background="@null"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_redo" />
        
        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="@color/gray_400"
            android:layout_marginEnd="8dp"
            android:layout_gravity="center_vertical"/>

        <ImageButton
            android:id="@+id/penBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:background="@null"
            android:layout_marginEnd="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_pencil" />

        <ImageButton
            android:id="@+id/eraserBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:background="@null"
            android:layout_marginEnd="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_npot_eraser" />

        <ImageButton
            android:id="@+id/figureBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:background="@null"
            android:padding="6dp"
            android:src="@drawable/ic_figure" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/figurePanelCl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gray_100_stroke_gray_300_round_10"
            android:padding="8dp"
            android:orientation="horizontal"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/lineFigureBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_gray_200_round_5_ripple"
                android:layout_marginEnd="4dp"
                android:padding="6dp"
                android:src="@drawable/ic_figure_line" />

            <ImageButton
                android:id="@+id/arrowFigureBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:background="@null"
                android:layout_marginEnd="4dp"
                android:padding="6dp"
                android:src="@drawable/ic_figure_arrow" />

            <ImageButton
                android:id="@+id/circleFigureBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:background="@null"
                android:padding="6dp"
                android:src="@drawable/ic_figure_circle" />

        </LinearLayout>

        <ImageView
            android:id="@+id/peakIv"
            android:layout_width="20dp"
            android:layout_height="14dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_panel_peak"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/eraserPanelCl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:visibility="gone"
        tools:visibility="visible"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gray_100_stroke_gray_300_round_10"
            android:padding="2dp"
            android:orientation="horizontal"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/removeAllBtn"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:text="모두 지우기"
                android:gravity="center"
                android:clickable="true"
                style="@style/h6"
                android:background="@null"
                android:textColor="@color/red_250"/>


        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_panel_peak"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/penOptionPanelCl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gray_100_stroke_gray_300_round_10"
            android:padding="8dp"
            android:orientation="vertical"
            android:layout_marginTop="13dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"
                android:background="@drawable/bg_gray_200_round_5_ripple"
                android:weightSum="2"
                >
                <TextView
                    android:id="@+id/penAlphaOptionBtn"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="펜"
                    android:gravity="center"
                    style="@style/h6"
                    android:background="@drawable/bg_white_round_2"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/highlighterAlphaOptionBtn"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="형광펜"
                    android:gravity="center"
                    style="@style/h6"
                    android:textColor="@color/gray_600"
                    android:layout_weight="1"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                >
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_gravity="center_vertical">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/thicknessIndicator"
                        android:layout_width="24dp"
                        android:layout_height="4dp"
                        android:layout_marginVertical="4dp"
                        app:cardBackgroundColor="@color/gray_700"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <SeekBar
                    android:id="@+id/thickSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:maxHeight="8dp"
                    android:minHeight="8dp"
                    android:max="125"
                    android:progress="5"
                    android:splitTrack="false"
                    android:background="@null"
                    android:progressTint="@color/gray_500"
                    android:progressBackgroundTint="@color/gray_300"
                    android:thumb="@drawable/seekbar_thumb_40"
                    android:progressDrawable="@drawable/seekbar_progress"
                    />

            </LinearLayout>

            <View style="@style/Border_Gray_300_Horizontal"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginVertical="8dp"
                android:orientation="horizontal"
                >

                <LinearLayout
                    android:id="@+id/blackColorLl"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/blackColorCl"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_black_200_circle"
                        android:padding="4dp">
                        <ImageView
                            android:id="@+id/blackColorInnerCircleIv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_transparent_stroke_white"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/blueColorLl"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/blueColorCl"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_blue_400_circle"
                        android:padding="4dp">
                        <ImageView
                            android:id="@+id/blueColorInnerCircleIv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_transparent_stroke_white"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/greenColorLl"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/greenColorCl"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_green_300_circle"
                        android:padding="4dp">
                        <ImageView
                            android:id="@+id/greenColorInnerCircleIv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_transparent_stroke_white"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/yellowColorLl"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/yellowColorCl"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_yellow_300_circle"
                        android:padding="4dp">
                        <ImageView
                            android:id="@+id/yellowColorInnerCircleIv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_transparent_stroke_white"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/redColorLl"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/redColorCl"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_red_300_circle"
                        android:padding="4dp">
                        <ImageView
                            android:id="@+id/redColorInnerCircleIv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_transparent_stroke_white"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

            </LinearLayout>

            <View style="@style/Border_Gray_300_Horizontal"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:paddingHorizontal="6dp">

                <TextView
                    style="@style/h6"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_600"
                    android:layout_gravity="center"
                    android:text="손으로 필기"/>

                <Switch
                    style="@style/Switch.ExtraLight"
                    android:id="@+id/fingerDrawModeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"/>
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_panel_peak"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
