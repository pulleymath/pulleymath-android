<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_white_fafafa_round"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/step1Container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainer">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step1Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dp48"
                android:paddingStart="@dimen/dp48">
                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp24"
                    android:textColor="@color/black_4c4c4c"
                    android:text="과목과 문제집을 선택해주세요."
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step1Body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="@dimen/dp24"
                android:paddingStart="@dimen/dp48"
                android:paddingEnd="@dimen/dp48">

                <com.freewheelin.pulley.views.DaebakTabRadio
                    android:id="@+id/subjectTab"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:tabWidth="@dimen/dp80"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp328"
                    android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp32"
                    app:layout_constraintTop_toBottomOf="@+id/subjectTab">

                    <com.freewheelin.pulley.views.textViews.SortableTextView
                        android:id="@+id/subjectSl"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:padding="@dimen/dp16"
                        app:label="과목명"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/horizontalBorder"/>

                    <com.freewheelin.pulley.views.textViews.SortableTextView
                        android:id="@+id/bookSl"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:padding="@dimen/dp16"
                        app:label="교재명"
                        app:layout_constraintStart_toEndOf="@+id/firstBorder"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/horizontalBorder"/>

                    <com.freewheelin.pulley.views.textViews.SortableTextView
                        android:id="@+id/publisherSl"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:padding="@dimen/dp16"
                        app:label="출판사"
                        app:layout_constraintStart_toEndOf="@+id/thirdBorder"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/horizontalBorder"/>

                    <View
                        style="@style/Border_Grey_e8e8e8_Horizontal"
                        android:id="@+id/horizontalBorder"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/dp48"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <View
                        android:id="@+id/firstBorder"
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:background="@color/grey_e8e8e8"
                        android:layout_marginStart="@dimen/dp104"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/horizontalBorder"/>

                    <View
                        android:id="@+id/thirdBorder"
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:background="@color/grey_e8e8e8"
                        android:layout_marginEnd="@dimen/dp168"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/horizontalBorder"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/bookListRv"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="1dp"
                        android:scrollbars="vertical"
                        app:layout_constraintTop_toBottomOf="@+id/horizontalBorder"
                        app:layout_constraintBottom_toBottomOf="parent"/>


                    <TextView
                        android:id="@+id/bookEmptyTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp14"
                        android:textColor="@color/grey_c0c0c0"
                        android:lineSpacingExtra="6sp"
                        android:gravity="center_horizontal"
                        android:text="열심히 만드는 중 :)\n조금만 기다려주세요!"
                        app:layout_constraintTop_toTopOf="@+id/bookListRv"
                        app:layout_constraintBottom_toBottomOf="@+id/bookListRv"
                        app:layout_constraintStart_toStartOf="@+id/bookListRv"
                        app:layout_constraintEnd_toEndOf="@+id/bookListRv"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/step2Container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainer">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step2Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dp12"
                android:paddingStart="@dimen/dp48">

                <TextView
                    android:id="@+id/selectedBookTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/grey_c0c0c0"
                    android:text="선택한 문제집 : [확률과통계] 개념플러스유형-개념편"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp24"
                    android:textColor="@color/black_4c4c4c"
                    android:text="더 공부하고 싶은 문제 번호를 선택해주세요. "
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/selectedBookTv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step2Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="@dimen/dp12"
                android:paddingStart="@dimen/dp48"
                android:paddingEnd="@dimen/dp48">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pageSelectorContainer"
                    android:layout_width="250dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/dp12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8">

                    <TextView
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp14"
                        android:textColor="@color/black_4c4c4c"
                        android:text="페이지"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/pageVerticalBorder"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/pageHorizontalBorder"/>

                    <CheckBox
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:id="@+id/allCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="문제번호"
                        android:paddingLeft="8dp"
                        android:layout_marginStart="@dimen/dp16"
                        app:layout_constraintStart_toEndOf="@+id/pageVerticalBorder"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/pageHorizontalBorder"/>

                    <View
                        style="@style/Border_Grey_e8e8e8_Horizontal"
                        android:id="@+id/pageHorizontalBorder"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/dp48"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <View
                        android:id="@+id/pageVerticalBorder"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/grey_e8e8e8"
                        android:layout_marginStart="@dimen/dp96"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/pageRv"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="1dp"
                        android:scrollbars="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/pageVerticalBorder"
                        app:layout_constraintTop_toTopOf="@+id/pageHorizontalBorder"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/problemRv"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="1dp"
                        android:scrollbars="vertical"
                        app:layout_constraintStart_toStartOf="@+id/pageVerticalBorder"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/pageHorizontalBorder"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>


                <LinearLayout
                    android:id="@+id/configCl"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/dp24"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@+id/totalCntTv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/pageSelectorContainer"
                    app:layout_constraintTop_toTopOf="@+id/pageSelectorContainer">

                    <TextView
                        android:id="@+id/problemCntTv"
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="문제 수"
                        android:textSize="@dimen/sp16" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cntSection"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_gray_200_stroke_grey_e8e8e8_round"
                        app:layout_constraintTop_toBottomOf="@+id/typeSection">

                        <TextView
                            android:id="@+id/cntGuideTv"
                            style="@style/TextBlack_4c4c4c"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="문제 하나당"
                            android:textSize="@dimen/sp16"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <ImageButton
                            android:id="@+id/minusBtn"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_white_fafafa_grey_stroke_grey_e8e8e8_circle"
                            android:src="@drawable/ic_minus"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/cntGuideTv"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/cntTv"
                            style="@style/TextBlack_4c4c4c.ExtraBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textSize="@dimen/sp18"
                            app:layout_constraintBottom_toBottomOf="@+id/minusBtn"
                            app:layout_constraintEnd_toEndOf="@+id/plusBtn"
                            app:layout_constraintStart_toStartOf="@+id/minusBtn"
                            app:layout_constraintTop_toTopOf="@+id/minusBtn" />


                        <ImageButton
                            android:id="@+id/plusBtn"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"
                            android:layout_marginStart="40dp"
                            android:background="@drawable/bg_white_fafafa_grey_stroke_grey_e8e8e8_circle"
                            android:src="@drawable/ic_plus_grey"
                            app:layout_constraintBottom_toBottomOf="@+id/minusBtn"
                            app:layout_constraintStart_toEndOf="@+id/minusBtn"
                            app:layout_constraintTop_toTopOf="@+id/minusBtn" />

                        <TextView
                            android:id="@+id/cntGuide2Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="개씩 만들기"
                            android:textColor="@color/black_4c4c4c"
                            android:textSize="@dimen/sp16"
                            app:layout_constraintBottom_toBottomOf="@+id/cntGuideTv"
                            app:layout_constraintStart_toEndOf="@+id/plusBtn"
                            app:layout_constraintTop_toTopOf="@+id/cntGuideTv" />

                        <LinearLayout
                            android:id="@+id/firstHider"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="1dp"
                            android:layout_marginEnd="1dp"
                            android:layout_marginBottom="3dp"
                            android:background="#ccf5f5f5"
                            android:clickable="true"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"></LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/levelTitleTv"
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="난이도"
                        android:textSize="@dimen/sp16" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_gray_200_stroke_grey_e8e8e8_round">

                        <ImageButton
                            android:id="@+id/levelQuestionIb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@null"
                            android:src="@drawable/ic_question"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <RadioGroup
                            android:id="@+id/levelRg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <RadioButton
                                android:id="@+id/easyRb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="더 쉽게"
                                android:textColor="@color/black_4c4c4c"
                                android:textSize="@dimen/sp16" />

                            <RadioButton
                                android:id="@+id/originRb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:checked="true"
                                android:text="그대로"
                                android:textColor="@color/black_4c4c4c"
                                android:textSize="@dimen/sp16" />

                            <RadioButton
                                android:id="@+id/hardRb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="26dp"
                                android:text="더 어렵게"
                                android:textColor="@color/black_4c4c4c"
                                android:textSize="@dimen/sp16" />
                        </RadioGroup>

                        <LinearLayout
                            android:id="@+id/secondHider"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="1dp"
                            android:layout_marginEnd="1dp"
                            android:layout_marginBottom="3dp"
                            android:background="#ccf5f5f5"
                            android:clickable="true"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"></LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/clearIncludeLabel"
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="클리어한 문제"
                        android:textSize="@dimen/sp16" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_gray_200_stroke_grey_e8e8e8_round">

                        <RadioGroup
                            android:id="@+id/clearRg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <RadioButton
                                android:id="@+id/includeRb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="포함"
                                android:textColor="@color/black_4c4c4c"
                                android:textSize="@dimen/sp16" />

                            <RadioButton
                                android:id="@+id/excludeRb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="48dp"
                                android:text="미포함"
                                android:textColor="@color/black_4c4c4c"
                                android:textSize="@dimen/sp16" />

                        </RadioGroup>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/cntPrefixLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp18"
                    android:textColor="@color/black_4c4c4c"
                    android:gravity="center_horizontal"
                    android:text="해당 조건에"
                    app:layout_constraintStart_toStartOf="@+id/configCl"
                    app:layout_constraintEnd_toStartOf="@+id/totalCntTv"
                    app:layout_constraintTop_toTopOf="@+id/totalCntTv"
                    app:layout_constraintBottom_toBottomOf="@+id/totalCntTv"
                    app:layout_constraintHorizontal_chainStyle="packed"/>

                <TextView
                    style="@style/TextPurple_6d6dff.ExtraBold"
                    android:id="@+id/totalCntTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp24"
                    android:gravity="center_horizontal"
                    android:text="24"
                    android:layout_marginBottom="@dimen/dp40"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@+id/cntPrefixLabel"
                    app:layout_constraintEnd_toStartOf="@+id/cntSuffixLabel"
                    app:layout_constraintBottom_toBottomOf="@+id/pageSelectorContainer"
                    app:layout_constraintHorizontal_chainStyle="packed"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cntImpossibleCl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/totalCntTv"
                    app:layout_constraintStart_toStartOf="@+id/cntPrefixLabel"
                    app:layout_constraintEnd_toEndOf="@+id/cntSuffixLabel">

                    <ImageView
                        android:id="@+id/cntImpossibleIv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_exclamation_red"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TextRed_fe7b67.Bold"
                        android:id="@+id/cntImpossibleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="최대 100문제까지 만들 수 있습니다."
                        android:textColor="@color/red_fe7b67"
                        android:textSize="@dimen/sp14"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/cntImpossibleIv"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>



                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/cntSuffixLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp18"
                    android:textColor="@color/black_4c4c4c"
                    android:gravity="center_horizontal"
                    android:text="개의 문제가 있습니다."
                    app:layout_constraintStart_toEndOf="@+id/totalCntTv"
                    app:layout_constraintEnd_toEndOf="@+id/configCl"
                    app:layout_constraintTop_toTopOf="@+id/totalCntTv"
                    app:layout_constraintBottom_toBottomOf="@+id/totalCntTv"
                    app:layout_constraintHorizontal_chainStyle="packed"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp60"
            android:background="@drawable/bg_white_ffffff_round_bottom_only"
            android:paddingStart="@dimen/dp48"
            android:paddingEnd="@dimen/dp48"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/selectGuideLabel"
                style="@style/TextGrey_c0c0c0.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp16"
                android:text=""
                android:textSize="@dimen/sp14"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/actionBtn"
                app:layout_constraintTop_toTopOf="parent" />

            <com.freewheelin.pulley.views.buttons.SecondaryButton
                android:id="@+id/cancelBtn"
                android:layout_width="@dimen/dp104"
                android:layout_height="@dimen/dp48"
                android:text="취소"
                app:buttonTheme="grey"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <CheckBox
                android:id="@+id/nowCheckbox"
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
