<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.learningcourse.fragments.LCPatternMapFragment">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.LCPatternMapViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/patternMapRv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            bind_pattern_map_table="@{vm.patternCardList}"
            android:paddingStart="22dp"
            android:paddingEnd="28dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:visibility="@{ vm.showNextStepBtn ? View.VISIBLE : View.GONE }"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/gradient_shadow_lc_review_item"/>


        <LinearLayout
            android:id="@+id/nextStepBtnCl"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal"
            android:focusable="true"
            android:visibility="@{ vm.showNextStepBtn ? View.VISIBLE : View.GONE }"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.65">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shadow_pattern_map_purple_150"
                >

                <TextView
                    android:id="@+id/scoringBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 3 오답 학습하러 가기!"
                    android:textColor="@color/purple_300"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="25dp"
                    android:lineHeight="26dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_review_next_btn"
                    app:layout_constraintTop_toTopOf="@+id/scoringBtn"
                    app:layout_constraintStart_toEndOf="@+id/scoringBtn"
                    app:layout_constraintBottom_toBottomOf="@+id/scoringBtn"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="@{ vm.showProgress ? View.VISIBLE : View.GONE }"
            android:indeterminateTint="@color/purple_200"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>