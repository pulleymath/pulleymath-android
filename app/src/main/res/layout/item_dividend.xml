<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <View style="@style/Border_Grey_e8e8e8_Horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!--<View style="@style/Border_Grey_cccccc_Vertical"-->
        <!--android:id="@+id/verticalBorder1"-->
        <!--android:layout_height="12dp"-->
        <!--android:layout_marginStart="144dp"-->
        <!--android:visibility="invisible"-->
        <!--app:layout_constraintTop_toTopOf="parent"-->
        <!--app:layout_constraintBottom_toBottomOf="parent"-->
        <!--app:layout_constraintStart_toStartOf="parent"/>-->

    <View style="@style/Border_Grey_cccccc_Vertical"
        android:id="@+id/verticalBorder2"
        android:layout_height="12dp"
        android:layout_marginStart="96dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sameRatingCorrectRateTv"/>

    <View style="@style/Border_Grey_cccccc_Vertical"
        android:id="@+id/verticalBorder3"
        android:layout_height="12dp"
        android:layout_marginStart="104dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/upperRatingCorrectRateTv"/>

    <TextView
        style="@style/TextGrey_818181.Bold"
        android:id="@+id/dividendTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textSize="@dimen/sp16"
        android:text="2점 (5)"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/questionBtn"
        app:layout_constraintHorizontal_chainStyle="packed"/>

    <ImageButton
        android:id="@+id/questionBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_question"
        android:background="@null"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dividendTv"
        app:layout_constraintHorizontal_chainStyle="packed"/>

    <TextView
        style="@style/TextBlack_4c4c4c.ExtraBold"
        android:id="@+id/myCorrectRateTv"
        android:layout_width="@dimen/dp104"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        android:text="25%"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/verticalBorder2"/>

    <TextView
        style="@style/TextBlack_4c4c4c.ExtraBold"
        android:id="@+id/sameRatingCorrectRateTv"
        android:layout_width="@dimen/dp104"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        android:text="51%"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/verticalBorder3"/>

    <TextView
        style="@style/TextGrey_818181.Bold"
        android:id="@+id/upperRatingCorrectRateTv"
        android:layout_width="@dimen/dp104"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp16"
        android:gravity="center"
        android:text="64%"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <com.freewheelin.pulley.views.charts.DoubleSidedHorizontalBarView
        android:id="@+id/doubleSideBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="@dimen/dp144"
        app:layout_constraintEnd_toStartOf="@+id/myCorrectRateTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>