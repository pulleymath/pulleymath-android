<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/leftTitle"
            style="@style/TextGray_800.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:text="2점 문항"
            android:textSize="@dimen/sp16"
            app:layout_constraintStart_toStartOf="@+id/mainBar"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/leftSubTitle"
            style="@style/TextGray_600.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="6문제"
            android:textSize="@dimen/sp12"
            app:layout_constraintBottom_toBottomOf="@+id/leftTitle"
            app:layout_constraintStart_toEndOf="@+id/leftTitle" />

        <TextView
            android:id="@+id/rightTitle"
            style="@style/TextGray_800.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="내 정답률 100%"
            android:textSize="@dimen/sp12"
            app:layout_constraintBottom_toBottomOf="@+id/mainBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/mainBar" />

        <TextView
            android:id="@+id/rightSubTitle"
            style="@style/TextGray_600.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1등급 평균 70%"
            android:textSize="@dimen/sp12"
            app:layout_constraintBottom_toBottomOf="@+id/subBar"
            app:layout_constraintStart_toStartOf="@+id/rightTitle"
            app:layout_constraintTop_toTopOf="@+id/subBar" />

        <com.freewheelin.pulley.legacy.views.LearningProgressView
            android:id="@+id/mainBar"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:backgroundColor="@color/gray_200"
            app:cardCornerRadius="2dp"
            app:layout_constraintBottom_toTopOf="@+id/subBar"
            app:layout_constraintEnd_toStartOf="@+id/rightTitle"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/leftTitle"
            app:progressColor="#78beff">

        </com.freewheelin.pulley.legacy.views.LearningProgressView>

        <com.freewheelin.pulley.legacy.views.LearningProgressView
            android:id="@+id/subBar"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            app:backgroundColor="@color/gray_200"
            app:cardCornerRadius="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/mainBar"
            app:layout_constraintStart_toStartOf="@+id/mainBar"
            app:layout_constraintTop_toBottomOf="@+id/mainBar"
            app:progressColor="@color/gray_400"
            app:completeColor="@color/gray_400"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>