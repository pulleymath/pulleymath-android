<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.learningcourse.fragments.LCCookingFragment">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.LCCookingViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <com.freewheelin.pulley.revision2021.views.LCCookingLeftScrollView
            android:id="@+id/leftScrollView"
            android:background="@color/white"
            app:layout_constraintWidth_percent="0.45"
            android:fillViewport="true"
            android:scrollbars="none"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/leftScrollRootCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/leftContentWrapperCl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:id="@+id/stepTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEP 1."
                        style="@style/mo_h6"
                        android:textColor="@color/purple_300"
                        android:layout_marginTop="24dp"
                        android:layout_marginStart="24dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/stepTitleTv"
                        style="@style/h4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="개념 및 예제 공부하기"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/blue_black_200"
                        app:layout_constraintBottom_toBottomOf="@+id/stepTv"
                        app:layout_constraintStart_toEndOf="@+id/stepTv"
                        app:layout_constraintTop_toTopOf="@+id/stepTv"/>

                    <ImageView
                        android:id="@+id/exerciseIv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/stepTv"/>
<!--                    cookingImgResOnPicassoDownScale="@{ vm.cookingImageUrl }"-->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        app:layout_constraintTop_toBottomOf="@+id/exerciseIv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.freewheelin.pulley.revision2021.cookingmemo.CookingMemoView
                    android:id="@+id/cookingMemoView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:focusable="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.freewheelin.pulley.revision2021.views.LCCookingLeftScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rightRv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/leftScrollView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:nestedScrollingEnabled="true" />
<!--            bind_cooking_list="@{vm.cookingInfoItems}"-->

        <FrameLayout
            android:id="@+id/keyboardFl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black3c_000000"
            android:visibility="@{ vm.showNumkeyboard ? View.VISIBLE : View.GONE }"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/customKeyboardCl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|center">

                <com.freewheelin.pulley.revision2021.views.CookingCustomNumberKeyboard
                    android:id="@+id/numberKeyboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="48dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/selectionFl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black3c_000000"
            android:visibility="@{ vm.showSelection ? View.VISIBLE : View.GONE }"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/selectionCl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|center">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/selectionImageRv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_white_fafafa_round"
                    android:layout_marginEnd="56dp"
                    bind_cooking_selection_image="@{ vm.selectionImageUrlList }"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>