<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="vm2" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.pattern.PatternQuizViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/dragIv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="center"
            android:src="@drawable/ic_dot_6"
            android:focusable="true"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/resultIv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_incorrect_new"
            android:layout_marginStart="@dimen/dp16"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@+id/dragIv"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.freewheelin.pulley.views.AnswerSelectionView
            android:id="@+id/selectionAnswerView"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            app:buttonHeight="28dp"
            app:buttonMargin="@dimen/dp28"
            app:buttonWidth="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/resultIv"
            app:layout_constraintTop_toTopOf="parent"
            app:selectionTheme="dark"/>

        <LinearLayout
            android:id="@+id/focusContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/shortAnswerView"
            android:layout_width="160dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_white_stroke_gray_300"
            android:gravity="center_vertical"
            android:hint="정답 입력"
            android:inputType="numberSigned"
            android:maxLength="9"
            android:paddingStart="@dimen/dp16"
            android:singleLine="true"
            android:textCursorDrawable="@drawable/cursor_black_4c4c4c_1dp"
            style="@style/h5"
            android:digits="1234567890-+"
            app:layout_constraintBottom_toBottomOf="@+id/selectionAnswerView"
            app:layout_constraintStart_toStartOf="@+id/selectionAnswerView"
            app:layout_constraintTop_toTopOf="@+id/selectionAnswerView" />

        <Button
            android:id="@+id/scoringBtn"
            android:layout_width="@dimen/primaryBtn_width_132dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/dp24"
            android:textColor="@color/white"
            android:text="채점하기"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/selectionAnswerView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>