<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="960dp"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:background="@drawable/bg_white_fafafa_round">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topContainerCl"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_white_ffffff_round_top_only"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp18"
                android:text="정보 수정하기"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageButton
                android:id="@+id/xBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@null"
                android:src="@drawable/ic_x_grey_19dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <View style="@style/Border_Grey_e8e8e8_Horizontal"
                android:layout_width="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="536dp"
            app:layout_constraintTop_toBottomOf="@+id/topContainerCl">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/guideLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp24"
                    android:text="최적화된\n학습추천을 위해,\n정보가 필요해요 :)"
                    android:lineSpacingExtra="@dimen/sp12"
                    android:layout_marginTop="62dp"
                    android:layout_marginStart="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="현재 학교를 다니지 않는다면,\n공부해야 하는 학년으로\n선택해주세요."
                    android:lineSpacingExtra="8sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/guideLabel"/>


                <TextView
                    style="@style/TextGrey_c0c0c0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:textSize="16sp"
                    android:text="학년, 학교, 성적 정보"
                    app:layout_constraintStart_toStartOf="@+id/contentsLl"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/contentsLl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="62dp"
                    android:layout_marginStart="70dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginEnd="32dp"
                    android:padding="32dp"
                    android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
                    android:orientation="vertical"
                    app:layout_constraintStart_toEndOf="@+id/guideLabel"
                    app:layout_constraintBottom_toTopOf="@+id/modifyBtn"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        style="@style/TextBlack_4c4c4c"
                        android:id="@+id/gradeLabel"
                        android:text="학년"
                        android:textSize="18sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>



                    <com.freewheelin.pulley.views.DaebakTabRadio
                        android:id="@+id/gradeTab"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        app:tabWidth="73dp"
                        app:layout_constraintTop_toBottomOf="@+id/gradeLabel"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c"
                        android:id="@+id/majorLabel"
                        android:text="계열"
                        android:textSize="18sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="parent"/>

                    <com.freewheelin.pulley.views.DaebakTabRadio
                        android:id="@+id/majorTab"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        app:tabWidth="78dp"
                        app:layout_constraintTop_toBottomOf="@+id/majorLabel"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TextBlack_4c4c4c"
                        android:id="@+id/ratingLabel"
                        android:text="최근 수학 모의고사 등급"
                        android:textSize="18sp"
                        android:layout_marginTop="48dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <com.freewheelin.pulley.views.DaebakTabRadio
                        android:id="@+id/ratingTab"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        app:tabWidth="58dp"
                        app:layout_constraintTop_toBottomOf="@+id/ratingLabel"
                        app:layout_constraintStart_toStartOf="parent"/>

                </LinearLayout>


                <com.freewheelin.pulley.views.buttons.PrimaryButton
                    android:id="@+id/modifyBtn"
                    android:layout_width="200dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="50dp"
                    android:text="@string/text_do_edit"
                    app:ButtonTextSize="18sp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/contentsLl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>