<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_white_fafafa_round">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topContainerCl"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp64"
            android:background="@drawable/bg_white_ffffff_round_top_only"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp32"
                android:text="풀이 설정"
                android:textSize="@dimen/sp18"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/xBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp24"
                android:src="@drawable/ic_x_grey_19dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                style="@style/Border_Grey_e8e8e8_Horizontal"
                android:layout_width="match_parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

<!--        app:layout_constraintHeight_default="wrap"-->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topContainerCl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/headContainer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp144"
                    android:background="@color/grey_f2f2f2">

                    <TextView
                        android:id="@+id/textMonth"
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:textSize="@dimen/sp16"
                        app:layout_constraintBottom_toTopOf="@+id/textTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="2020년 11월" />

                    <TextView
                        android:id="@+id/textTitle"
                        style="@style/TextBlack_4c4c4c.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="@dimen/sp24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/textMonth"
                        app:layout_constraintTop_toBottomOf="@+id/textMonth"
                        tools:text="고 2 모의고사 [이과]" />

                    <TextView
                        android:id="@+id/updateTag"
                        style="@style/TextRed_fe7b67.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="신규"
                        android:textSize="@dimen/sp14"
                        app:layout_constraintBottom_toBottomOf="@+id/textTitle"
                        app:layout_constraintStart_toEndOf="@+id/textTitle"
                        app:layout_constraintTop_toTopOf="@+id/textTitle" />

                    <LinearLayout
                        android:id="@+id/subjectContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp32"
                        android:gravity="right"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/reSolveContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginEnd="@dimen/dp32"
                    android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8_round"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/dp32"
                    android:paddingTop="@dimen/dp24"
                    android:paddingEnd="@dimen/dp32"
                    android:paddingBottom="@dimen/dp24">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/checkBoxGuideLabel"
                            style="@style/TextBlack_4c4c4c"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="처음부터 다시 풀기"
                            android:textSize="@dimen/sp16" />

                        <Switch
                            android:id="@+id/checkRestart"
                            style="@style/Switch.Light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp12"
                            android:background="@color/white_ffffff" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/resolveGuideLabel"
                        style="@style/TextGrey_9f9f9f"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:text="기존에 풀었던 내역이 사라집니다."
                        android:textSize="@dimen/sp14"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/selectSubjectContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/selectSubjectLabel"
                        style="@style/TextBlack_4c4c4c.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp32"
                        android:layout_marginTop="@dimen/dp32"
                        android:text="선택과목을 선택해주세요."
                        android:textSize="@dimen/sp16" />

                    <LinearLayout
                        android:id="@+id/selectCheckContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp32"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp32"
                        android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8_round"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp32"
                        android:paddingTop="@dimen/dp24"
                        android:paddingEnd="@dimen/dp32"
                        android:paddingBottom="@dimen/dp24"
                        android:visibility="gone">

                        <CheckBox
                            android:id="@+id/checkSelectOne"
                            style="@style/CheckBoxStyle8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:bufferType="spannable"
                            android:textSize="@dimen/sp16"
                            android:visibility="gone"
                            tools:text="확률과 통계 10문항" />

                        <CheckBox
                            android:id="@+id/checkSelectTwo"
                            style="@style/CheckBoxStyle8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/dp32"
                            android:bufferType="spannable"
                            android:textSize="@dimen/sp16"
                            android:visibility="gone"
                            tools:text="미적분 2문항" />

                        <CheckBox
                            android:id="@+id/checkSelectThree"
                            style="@style/CheckBoxStyle8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/dp32"
                            android:bufferType="spannable"
                            android:textSize="@dimen/sp16"
                            android:visibility="gone"
                            tools:text="기하 2문항" />

                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/selectRadioContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp32"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp32"
                        android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8_round"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp32"
                        android:paddingTop="@dimen/dp24"
                        android:paddingEnd="@dimen/dp32"
                        android:paddingBottom="@dimen/dp24">

                        <RadioButton
                            android:id="@+id/radioSelectOne"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:checked="true"
                            android:text="확률과 통계"
                            android:textSize="@dimen/sp16" />

                        <RadioButton
                            android:id="@+id/radioSelectTwo"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/dp32"
                            android:text="미적분"
                            android:textSize="@dimen/sp16" />

                        <RadioButton
                            android:id="@+id/radioSelectThree"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/dp32"
                            android:text="기하"
                            android:textSize="@dimen/sp16" />

                    </RadioGroup>

                </LinearLayout>

                <TextView
                    android:id="@+id/lbSelectMethod"
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp32"
                    android:text="풀이 방식을 선택해 주세요."
                    android:textSize="@dimen/sp16" />

                <RadioGroup
                    android:id="@+id/radioMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp32"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioOnTablet"
                        style="@style/MFRadioButton.Box"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:drawableBottom="@drawable/bg_check_img_solve_tablet"
                        android:drawablePadding="@dimen/dp16"
                        android:paddingTop="@dimen/dp24"
                        android:paddingBottom="@dimen/dp24"
                        android:text="태블릿에서 바로 풀기" />

                    <RadioButton
                        android:id="@+id/radioOnPrint"
                        style="@style/MFRadioButton.Box"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:drawableBottom="@drawable/bg_check_img_omr"
                        android:drawablePadding="@dimen/dp16"
                        android:paddingTop="@dimen/dp24"
                        android:paddingBottom="@dimen/dp24"
                        android:text="시험지 인쇄해서 풀기" />
                </RadioGroup>

            </LinearLayout>

        </ScrollView>

        <FrameLayout
            android:id="@+id/bottomContainerShadow"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:background="@drawable/gradient_shadow_above_footer"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp32"
            android:paddingTop="@dimen/dp24"
            android:paddingEnd="@dimen/dp32"
            android:paddingBottom="@dimen/dp24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.freewheelin.pulley.views.Buttons.PrimaryButton
                android:id="@+id/solveOnTabletBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:text="풀기"
                app:buttonTheme="blue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <com.freewheelin.pulley.views.Buttons.SecondaryButton
                android:id="@+id/sendEmailBtn"
                android:layout_width="250dp"
                android:layout_height="@dimen/dp48"
                android:text="시험지 메일 발송"
                android:visibility="gone"
                app:buttonTheme="blue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.freewheelin.pulley.views.Buttons.PrimaryButton
                android:id="@+id/solveOnOMR"
                android:layout_width="250dp"
                android:layout_height="@dimen/dp48"
                android:layout_marginStart="8dp"
                android:text="OMR에 정답 입력하기"
                android:visibility="gone"
                app:buttonTheme="blue"
                app:layout_constraintBottom_toBottomOf="@id/sendEmailBtn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/sendEmailBtn"
                app:layout_constraintTop_toTopOf="@id/sendEmailBtn" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/progressContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white_ccffffff"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                android:id="@+id/progressBar3"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>