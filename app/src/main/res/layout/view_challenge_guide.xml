<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.ChallengeGuideDialogViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:background="@color/gray_800"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
<!--        android:background="@color/dim_black_333333_70a"-->

        <ImageView
            android:id="@+id/exitBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:src="@drawable/icon_x"
            app:tint="@color/gray_500"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/challengeGuideTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gray_200_round_20"
            style="@style/h5"
            tools:text="안녕~ 나는 풀링이라고해"
            android:gravity="center"
            android:paddingHorizontal="30dp"
            android:paddingVertical="20dp"
            android:layout_marginBottom="39dp"
            android:lineHeight="18dp"
            app:layout_constraintBottom_toTopOf="@id/pullingIv"
            app:layout_constraintStart_toStartOf="@id/pullingIv"
            app:layout_constraintEnd_toEndOf="@id/pullingIv"/>
<!--            android:text="@{ vm.guideTxt }"-->

        <ImageView
            android:layout_width="22dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_pulling_peak"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/pullingIv"
            app:layout_constraintStart_toStartOf="@id/pullingIv"
            app:layout_constraintEnd_toEndOf="@id/pullingIv"/>
        <ImageView
            android:id="@+id/pullingIv"
            android:layout_width="110dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            app:layout_constraintHeight_percent="0.30"
            android:src="@drawable/pulling_character_normal"
            app:layout_constraintVertical_bias="0.55"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/moveTargetChallengePlaceBtnCl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            visibleIf="@{ vm.showButtons }"
            android:background="@drawable/bg_btn_round_common_round_10"
            android:paddingVertical="16dp"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/pullingIv"
            app:layout_constraintStart_toStartOf="@id/pullingIv"
            app:layout_constraintEnd_toEndOf="@id/pullingIv">

            <TextView
                android:id="@+id/moveTargetChallengePlaceTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{ vm.nextTxt }"
                tools:text="수학 1등급 받고싶으면 개추"
                style="@style/h4"
                android:textColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tailless_arrow_right_24"
                app:tint="@color/white"
                app:layout_constraintStart_toEndOf="@+id/moveTargetChallengePlaceTv"
                app:layout_constraintTop_toTopOf="@+id/moveTargetChallengePlaceTv"
                app:layout_constraintBottom_toBottomOf="@+id/moveTargetChallengePlaceTv"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/dismissTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/moveTargetChallengePlaceBtnCl"
            app:layout_constraintStart_toStartOf="@id/moveTargetChallengePlaceBtnCl"
            app:layout_constraintEnd_toEndOf="@+id/moveTargetChallengePlaceBtnCl"
            android:text="다른 미션 둘러보기"
            android:padding="8dp"
            visibleIf="@{ vm.showDismissButtons }"
            style="@style/h5"
            android:textColor="@color/white"
            android:layout_marginTop="16dp"
            />
<!--            android:onClick="@{ () -> vm.disappearStartChallengeGuide() }"-->

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/sprinkleLottieView"
            android:layout_width="500dp"
            android:layout_height="500dp"
            visibleIf="@{ vm.showSprinkleView }"
            tools:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:lottie_fileName="sprinkle_effect.json" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>