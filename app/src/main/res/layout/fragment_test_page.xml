<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.freewheelin.pulley.legacy.activities.learning.tabFragment.snackTest.TestPageFragment">

        <TextView
            style="@style/TextGray_800.ExtraBold"
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp40"
            android:layout_marginTop="@dimen/dp48"
            android:text="데일리\n테스트"
            android:textSize="@dimen/sp36"
            android:lineSpacingExtra="@dimen/sp18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            style="@style/TextGray_800.Bold"
            android:id="@+id/wrongGuideTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp18"
            android:text="완벽을 위해 무제한 응시!"
            android:layout_marginTop="@dimen/dp32"
            app:layout_constraintStart_toStartOf="@+id/titleTv"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"/>

        <TextView
            style="@style/TextRed_300.Bold"
            android:id="@+id/warningTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp24"
            android:text="23:58"
            app:layout_constraintStart_toStartOf="@+id/titleTv"
            app:layout_constraintTop_toTopOf="@+id/warningGuideLabel"
            app:layout_constraintBottom_toBottomOf="@+id/warningGuideLabel"/>

        <TextView
            style="@style/TextRed_300.Bold"
            android:id="@+id/warningGuideLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp32"
            android:layout_marginStart="4dp"
            android:textSize="@dimen/sp14"
            android:text="이 지나면 풀 수 없어요!"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"
            app:layout_constraintStart_toEndOf="@+id/warningTimeLabel"/>

        <TextView
            style="@style/TextGray_600"
            android:id="@+id/descTv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dp40"
            android:layout_marginEnd="@dimen/dp40"
            android:layout_marginBottom="@dimen/dp40"
            android:layout_marginTop="@dimen/dp24"
            android:lineSpacingExtra="8sp"
            android:text="오늘이 지나면 풀 수 없는 데일리 테스트인데요. 네 그래요 그렇다고 한다."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/warningTimeLabel"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>