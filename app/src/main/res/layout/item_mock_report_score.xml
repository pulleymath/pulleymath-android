<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_fafafa"
        android:orientation="vertical">

        <TextView
            android:id="@+id/scoreAnalysisTv"
            style="@style/TextGrey_9f9f9f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp32"
            android:layout_marginTop="@dimen/dp48"
            android:text="배점별 분석"
            android:textSize="@dimen/sp18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scoreAnalysisContainerCl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp32"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginEnd="@dimen/dp32"
            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scoreAnalysisTv">

            <TextView
                android:id="@+id/scoreAnalysisGuideTv"
                style="@style/TextBlack_4c4c4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginTop="@dimen/dp40"
                android:textSize="@dimen/sp24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="수학1의 3점 문항을 잘 풀고 있어요!" />

            <TextView
                android:id="@+id/scoreAnalysisGuideTv2"
                style="@style/TextBlack_4c4c4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginTop="@dimen/dp8"
                android:textSize="@dimen/sp24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scoreAnalysisGuideTv"
                tools:text="수학(하)의 4점 문항이 가장 약해요ㅠㅠ" />

            <RadioGroup
                android:id="@+id/scoreTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/scoreAnalysisGuideTv2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="@dimen/dp40"
                android:layout_marginStart="@dimen/dp64"
                android:layout_marginBottom="@dimen/dp40">
            </RadioGroup>

            <TextView
                android:id="@+id/lbSubjectScoreRate"
                style="@style/TextGrey_c0c0c0.ExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="과목 배점별 정답률"
                android:textSize="@dimen/sp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scoreAnalysisGuideTv2"
                android:layout_marginTop="@dimen/dp40"
                android:layout_marginStart="@dimen/dp64"
                android:layout_marginEnd="@dimen/dp80"
                />

            <com.freewheelin.pulley.views.charts.MockReportBarChartView
                android:id="@+id/scoreBarChartView1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/dp80"
                app:layout_constraintTop_toBottomOf="@id/lbSubjectScoreRate"
                app:layout_constraintStart_toEndOf="@+id/scoreTab"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <com.freewheelin.pulley.views.charts.MockReportBarChartView
                android:id="@+id/scoreBarChartView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:layout_marginEnd="@dimen/dp80"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/scoreTab"
                app:layout_constraintTop_toBottomOf="@id/scoreBarChartView1"
                />
            <com.freewheelin.pulley.views.charts.MockReportBarChartView
                android:id="@+id/scoreBarChartView3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:layout_marginEnd="@dimen/dp80"
                android:layout_marginBottom="@dimen/dp48"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/scoreTab"
                app:layout_constraintTop_toBottomOf="@id/scoreBarChartView2"
                app:layout_constraintBottom_toBottomOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>