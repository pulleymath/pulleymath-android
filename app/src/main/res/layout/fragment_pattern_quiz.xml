<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.learningcourse.fragments.pattern.PatternQuizFragment">

    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2021.model.LCPatternQuiz.PatternType" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.pattern.PatternQuizViewModel"/>
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:clipToPadding="false"
        >


        <com.freewheelin.pulley.revision2021.views.PatternQuizScrollView
            android:id="@+id/leftScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:focusable="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/leftScrollRootCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ivWrapperCl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
<!--                    android:background="@{ vm.isQuizMainConcept ? @color/purple_gray_100 : @color/white }"-->

                    <View
                        android:id="@+id/mainQuizBackgroundView"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@color/gray_200"
                        android:visibility="@{ vm.isQuizMainConcept ? View.VISIBLE : View.GONE }"
                        tools:visibility="visible"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintWidth_percent="0.4"
                        app:layout_constraintHorizontal_bias="0"/>


                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@color/white"
                        android:visibility="@{ vm.isQuizMainConcept ? View.VISIBLE : View.GONE }"
                        tools:visibility="visible"
                        app:layout_constraintStart_toEndOf="@+id/mainQuizBackgroundView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <ImageView
                        android:id="@+id/quizIv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:layout_marginTop="24dp"
                        imgResAtQuiz="@{ vm.currQuizImage }"
                        android:visibility="@{ vm.isQuizMainConcept ? View.GONE : View.VISIBLE }"
                        android:layout_marginStart="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <LinearLayout
                        android:id="@+id/mainQuizWrapperLl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        tools:visibility="visible"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_percent="0.4"
                        app:layout_constraintHorizontal_bias="0">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/mainQuizCl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_white_round_10"
                            android:padding="24dp"
                            android:visibility="@{ vm.isQuizMainConcept ? View.VISIBLE : View.GONE }"
                            android:layout_margin="24dp"
                            >

                            <ImageView
                                android:id="@+id/mainQuizIv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:adjustViewBounds="true"
                                android:scaleType="fitStart"
                                imgResAtQuiz="@{ vm.currQuizImage }"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/mainQuizConceptSolutionCl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:visibility="@{ vm.isQuizMainConcept ? View.VISIBLE : View.GONE }"
                        app:layout_constraintStart_toEndOf="@+id/mainQuizWrapperLl"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:id="@+id/conceptScrollRootLl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="24dp"
                            android:paddingVertical="24dp"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/solutionScrollRootLl">

                            <TextView
                                android:id="@+id/conceptTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="유형별 개념"
                                style="@style/mo_h2"/>

                            <!--            이외의 이미지나 텍스트뷰는 addView로 집어넣음-->

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:text="해당문제는 유형별 개념을 제공하지 않아요"
                                android:layout_marginTop="24dp"
                                android:layout_marginStart="-24dp"
                                style="@style/c1"
                                android:visibility="gone"
                                tools:visibility="visible"
                                android:textColor="@color/gray_600"
                                android:gravity="center"/>


                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/solutionScrollRootLl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="24dp"
                            android:orientation="vertical"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/conceptScrollRootLl"
                            app:layout_constraintEnd_toEndOf="parent">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="해설"
                                style="@style/mo_h2"
                                android:lineHeight="24dp"
                                />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                cookingImgRes="@{ vm.patternQuiz.solutionImageUrl }"/>

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/solutionInfoCl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp">

                                <TextView
                                    android:id="@+id/answerTitleTv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/mo_h2"
                                    android:text="정답 : "
                                    android:lineHeight="24dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>

                                <TextView
                                    android:id="@+id/answerTv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{ vm.patternQuiz.answerWithIcon() }"
                                    style="@style/mo_h2"
                                    android:textSize="@{ vm.patternQuiz.answerWithIcon().length > 1 ? @dimen/sp20 : @dimen/sp28 }"
                                    android:layout_marginStart="8dp"
                                    app:layout_constraintStart_toEndOf="@+id/answerTitleTv"
                                    app:layout_constraintTop_toTopOf="@+id/answerTitleTv"
                                    app:layout_constraintBottom_toBottomOf="@+id/answerTitleTv"/>

                                <TextView
                                    android:id="@+id/barTv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="|"
                                    style="@style/b2"
                                    android:lineHeight="24dp"
                                    android:textColor="@color/gray_300"
                                    android:layout_marginStart="12dp"
                                    app:layout_constraintStart_toEndOf="@+id/answerTv"
                                    app:layout_constraintTop_toTopOf="@+id/answerTv"
                                    app:layout_constraintBottom_toBottomOf="@+id/answerTv"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{ `정답률 ` + vm.patternQuiz.correctAnswerRateLimit100 + `%` }"
                                    android:textSize="14sp"
                                    android:textColor="@color/gray_600"
                                    android:layout_marginStart="12dp"
                                    app:layout_constraintTop_toTopOf="@+id/barTv"
                                    app:layout_constraintStart_toEndOf="@+id/barTv"
                                    app:layout_constraintBottom_toBottomOf="@+id/barTv"
                                    />




                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:visibility="@{ vm.patternQuiz.isCorrect == null ? View.GONE : View.VISIBLE }"
                        android:src="@{ vm.patternQuiz.isCorrect == false ? @drawable/ic_x_wrong_answer : vm.patternQuiz.isFirstTry == true ? @drawable/ic_o_right_answer : @drawable/ic_triangle_wrong_right_green }"
                        tools:src="@drawable/ic_triangle_wrong_right_green"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="@+id/quizIv"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.freewheelin.pulley.legacy.views.memoView.MemoView
                    android:id="@+id/memoView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:focusable="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.freewheelin.pulley.revision2021.views.PatternQuizScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/solutionContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            tools:visibility="gone"
            android:background="@drawable/bg_white_stroke_gray_300_left"
            app:layout_constraintWidth_percent="0.375"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="@{ vm.isQuizMainConcept ? View.GONE : vm.showConceptSolutionView ? View.VISIBLE : View.GONE }"
            >
            <View
                style="@style/Border_Gray_300_Horizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                app:layout_constraintBottom_toBottomOf="@id/tabLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="56dp"
                tools:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabSelectedTextColor="@color/purple_300"
                app:tabGravity="fill"
                app:tabMaxWidth="1000dp"
                app:tabIndicatorColor="@color/purple_300"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorHeight="2dp"
                app:tabMode="fixed">

            </com.google.android.material.tabs.TabLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                tools:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tabLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.freewheelin.pulley.revision2021.views.FloatingAnswerSheet
            android:id="@+id/floatingAnswerSheet"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:elevation="8dp"
            android:visibility="@{ vm.patternQuiz.patternType.rawValue == 0 ? View.GONE : View.VISIBLE }"
            app:floatingSheetStepBtnText="@{ vm.btnText }"
            app:floatingStepBtnBackground="@{ vm.patternQuiz.isCorrect != null }"
            app:answerAreaEnabled="@{ vm.patternQuiz.isCorrect == null }"
            app:layout_constraintEnd_toEndOf="parent"
            app:floatingSheetAnswerType="@{ vm.patternQuiz.isShortFormat() }"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>