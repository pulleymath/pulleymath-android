<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.GuestJoinViewModel"/>
        <variable name="isBetaApp" type="Boolean"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="448dp"
        android:layout_height="match_parent">
<!--        android:layout_height="@dimen/dp768">-->

        <ScrollView
            android:id="@+id/scrollRootView"
            android:layout_width="448dp"
            android:layout_height="wrap_content"
            android:background="@color/gray_100"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/updateGradeCl"
                android:layout_width="448dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <LinearLayout
                    android:id="@+id/headerLl"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <ImageView
                        android:id="@+id/backBtn"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="16dp"
                        android:src="@drawable/ic_tailless_arrow_left_24"
                        />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        />
                    <TextView
                        android:id="@+id/headerTv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        style="@style/h5"
                        android:text="로그인"
                        />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        />
                    <ImageButton
                        android:id="@+id/exitBtn"
                        android:layout_width="72dp"
                        android:layout_height="56dp"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="16dp"
                        android:gravity="center"
                        android:src="@drawable/icon_x"
                        android:background="@null"
                        android:onClick="@{ () -> vm.exitBtn() }" />
<!--                    여기서 src를 isPaidUser로 분기 -->
                </LinearLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/gray_300"
                    app:layout_constraintTop_toBottomOf="@id/headerLl"
                    app:layout_constraintBottom_toTopOf="@id/infoScrollContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/infoScrollContainer"
                    android:layout_width="400dp"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toBottomOf="@+id/headerLl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0">


                    <TextView
                        android:id="@+id/titleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="서비스 이용을 위해 로그인 해주세요 :)"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="32dp"
                        android:gravity="center"
                        style="@style/h4"
                        android:textColor="@color/gray_800" />
                    <LinearLayout
                        android:id="@+id/inputFieldWrapperLl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@+id/titleTv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.freewheelin.pulley.legacy.views.editText.InputFieldV2
                            android:id="@+id/emailField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:layout_height="80dp"
                            android:layout_marginTop="@dimen/dp24"
                            app:InputFieldV2_maxLength="350"
                            app:InputFieldV2_Hint="아이디(이메일)"
                            />

                        <com.freewheelin.pulley.legacy.views.editText.PasswordFieldV2
                            android:id="@+id/pwField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:PasswordFieldV2_maxLength="15"
                            app:PasswordFieldV2_Hint="비밀번호"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@id/inputFieldWrapperLl"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">


                        <TextView
                            android:id="@+id/loginBtn"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="center"
                            style="@style/h4"
                            android:background="@{ vm.loginBtnEnabled ? @drawable/bg_btn_round_common : @drawable/bg_purple_300_disable_round , default=@drawable/bg_btn_round_common }"
                            android:textColor="@color/white"
                            android:text="로그인하기" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray_400"
                            android:layout_marginVertical="16dp"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp56"
                            app:cardCornerRadius="5dp"
                            android:elevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/whaleLoginBtn"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp56"
                                android:background="@drawable/bg_aiep_login_btn"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="16dp"
                                    android:src="@drawable/ic_whale_secondary"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    style="@style/h4"
                                    android:text="웨일 스페이스로 로그인"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp56"
                            android:layout_marginTop="8dp"
                            app:cardCornerRadius="5dp"
                            android:elevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/aiepLoginBtn"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp56"
                                android:background="@drawable/bg_aiep_login_btn"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:layout_width="44dp"
                                    android:layout_height="12dp"
                                    android:layout_marginStart="16dp"
                                    android:src="@drawable/logo_aiep"
                                    android:contentDescription="AIEP"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    style="@style/h4"
                                    android:text="AIEP로 로그인"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/loginBodyTextWrapperCl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/layoutButton"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        >

                        <TextView
                            android:id="@+id/findIdPwTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="이메일 또는 비밀번호를 잊으셨나요?"
                            style="@style/b2r"
                            android:textColor="@color/gray_700"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <View
                            android:background="@color/gray_700"
                            android:layout_height="0.5dp"
                            android:layout_width="0dp"
                            app:layout_constraintEnd_toEndOf="@+id/findIdPwTv"
                            app:layout_constraintStart_toStartOf="@+id/findIdPwTv"
                            app:layout_constraintTop_toBottomOf="@+id/findIdPwTv" />

                        <TextView
                            android:id="@+id/dummyLoginBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="staging master login"
                            android:textAllCaps="false"
                            visibleOrInvisibleIf="@{ isBetaApp }"
                            android:gravity="center"
                            style="@style/h4"
                            android:background="@drawable/bg_btn_round_common"
                            app:layout_constraintTop_toBottomOf="@id/findIdPwTv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginTop="16dp"
                            android:padding="16dp"
                            android:textColor="@color/white"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:padding="16dp"
                            app:layout_constraintTop_toBottomOf="@+id/dummyLoginBtn"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>



                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <FrameLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000"
            visibleIf="@{ vm.isLoading }"
            tools:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
