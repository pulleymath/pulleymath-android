<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2023.ui.fragment.PurchaseGuide1Fragment">

    <data>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.PurchaseGuideViewModel"/>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="440dp"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/scrollWrapperLl"
            android:layout_width="440dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/actionBtnWrapperCl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/headerLl"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:background="@color/white">
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    />
                <ImageButton
                    android:id="@+id/exitBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginVertical="16dp"
                    android:gravity="center"
                    android:src="@drawable/icon_x"
                    android:background="@null"
                    android:onClick="@{ () -> vm.exitBtn() }" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/subHeaderLl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white">
                <TextView
                    android:id="@+id/titleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="풀리수학+ 구매하고\n성적 상승의 길로 함께 떠나볼까요?"
                    style="@style/h4_sb"
                    android:gravity="center"
                    android:layout_gravity="center"
                    />
                <TextView
                    android:id="@+id/pdfDescTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* 제휴 출판사 문제집 단권구매는\n풀리수학 웹 사이트 > 풀리북스 에서 가능합니다."
                    style="@style/mo_b2r"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center"
                    />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollRoot"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/scrollRootCl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/scrollBodyCl"
                        android:layout_width="440dp"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="42dp"
                        android:background="@color/white"
                        android:paddingBottom="24dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/imageWrapperCl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <LinearLayout
                                android:id="@+id/univInfoLl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_gray_100_round_12"
                                android:paddingVertical="12dp"
                                android:layout_marginEnd="6dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/aiInfoLl"
                                app:layout_constraintBottom_toTopOf="@id/bookInfoLl"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/guide_school_blue"/>

                                <TextView
                                    style="@style/b2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="건국대, 숭실대 등\n대학 진단평가에 사용" />
                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/aiInfoLl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_gray_100_round_12"
                                android:paddingVertical="12dp"
                                android:layout_marginStart="6dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/univInfoLl"
                                app:layout_constraintBottom_toTopOf="@id/questionInfoLl"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/guide_ai_on_book"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/b2"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:text="인공지능 기반\n15만 개의 유사문제"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/bookInfoLl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_gray_100_round_12"
                                android:paddingVertical="12dp"
                                android:layout_marginEnd="6dp"
                                android:layout_marginTop="12dp"
                                app:layout_constraintTop_toBottomOf="@id/univInfoLl"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/questionInfoLl"
                                app:layout_constraintBottom_toTopOf="@id/crownInfoLl"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/guide_book_red"/>

                                <TextView
                                    style="@style/b2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="시중 200권의\n개념서, 유형서 문제 제공" />
                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/questionInfoLl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_gray_100_round_12"
                                android:paddingVertical="12dp"
                                android:layout_marginStart="6dp"
                                android:layout_marginTop="12dp"
                                app:layout_constraintTop_toBottomOf="@id/aiInfoLl"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/bookInfoLl"
                                app:layout_constraintBottom_toTopOf="@id/xInfoLl"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/guide_question_balloon"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/b2"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:text="수학 선생님과\n1:1 실시간 질문답변"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/crownInfoLl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_gray_100_round_12"
                                android:paddingVertical="12dp"
                                android:layout_marginEnd="6dp"
                                android:layout_marginTop="12dp"
                                app:layout_constraintTop_toBottomOf="@id/bookInfoLl"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/xInfoLl"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/guide_crown_yellow"/>

                                <TextView
                                    style="@style/b2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="이론-인강-예제-필수유형\n한 번에 개념 마스터"/>
                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/xInfoLl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_gray_100_round_12"
                                android:paddingVertical="12dp"
                                android:layout_marginStart="6dp"
                                android:layout_marginTop="12dp"
                                app:layout_constraintTop_toBottomOf="@id/questionInfoLl"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/crownInfoLl"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/guide_x_on_book"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/b2"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:text="틀린 문제를 바로\n복습하는 오답노트"/>
                            </LinearLayout>


                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/actionBtnWrapperCl"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:layout_margin="24dp"
            android:clickable="true"
            android:background="@drawable/bg_btn_round_common"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:focusable="true">

            <ImageView
                android:id="@+id/crownIv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_crown"
                app:layout_constraintHorizontal_chainStyle="packed"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/actionTv"/>

            <TextView
                android:id="@+id/actionTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/h5"
                android:textColor="@color/white"
                android:text="구독제 보기"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/crownIv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>