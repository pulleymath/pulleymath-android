<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2023.ui.view.MainTab" />
        <import type="com.freewheelin.pulley.revision2023.SchoolType" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.MainActViewModel"/>
        <variable name="currentTab" type="com.freewheelin.pulley.revision2023.ui.view.MainTab"/>
        <variable name="schoolType" type="com.freewheelin.pulley.revision2023.SchoolType"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp56"
        >

        <LinearLayout
            android:id="@+id/tabletTabRootLl"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp56"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible"
            android:background="@null"
            android:animateLayoutChanges="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tab0"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:gravity="center"
                style="@style/b1"
                android:paddingStart="@dimen/dp24"
                android:paddingEnd="@dimen/dp24"
                android:text="메인"
                mainTabTextStyle="@{ currentTab }"
                />

            <TextView
                android:id="@+id/tab1"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:gravity="center"
                style="@style/b1"
                android:paddingStart="@dimen/dp24"
                android:paddingEnd="@dimen/dp24"
                android:text="개념"
                mainTabTextStyle="@{ currentTab }"
                />

            <TextView
                android:id="@+id/tab2"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:gravity="center"
                style="@style/b1"
                android:paddingStart="@dimen/dp24"
                android:paddingEnd="@dimen/dp24"
                android:text="문제풀이"
                mainTabTextStyle="@{ currentTab }"
                />

            <TextView
                android:id="@+id/tab3"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:gravity="center"
                style="@style/b1"
                android:paddingStart="@dimen/dp24"
                android:paddingEnd="@dimen/dp24"
                android:text="분석"
                mainTabTextStyle="@{ currentTab }"
                />

            <TextView
                android:id="@+id/tab4"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:gravity="center"
                style="@style/b1"
                android:visibility="gone"
                tools:visibility="visible"
                visibleIf="@{ !vm.mainProfileV4.isAffiliated || vm.mainProfileV4.hasLesson }"
                android:paddingStart="@dimen/dp24"
                android:paddingEnd="@dimen/dp24"
                android:text="@{ vm.mainProfileV4.isAffiliated ? `튜터` : `과외`, default=`과외`}"
                mainTabTextStyle="@{ currentTab }"
                />

            <TextView
                android:id="@+id/tab5"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:gravity="center"
                style="@style/b1"
                android:paddingStart="@dimen/dp24"
                android:paddingEnd="@dimen/dp24"
                android:tag="tablet_univ"
                visibleIf="@{ !vm.assessmentExamGroup.empty }"
                android:text="대학"
                mainTabTextStyle="@{ currentTab }"
                />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/mobileTabScrollRoot"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp56"
            android:fillViewport="true"
            android:overScrollMode="never"
            tools:visibility="gone"
            android:scrollbars="none"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <LinearLayout
                android:id="@+id/mobileTabRootLl"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp56"
                android:background="@null"
                android:orientation="horizontal"
                android:animateLayoutChanges="true"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/mobileTab0"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp56"
                    android:gravity="center"
                    style="@style/b1"
                    android:paddingStart="@dimen/dp24"
                    android:paddingEnd="@dimen/dp24"
                    android:text="메인"
                    mainTabTextStyle="@{ currentTab }"
                    />

                <TextView
                    android:id="@+id/mobileTab1"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp56"
                    android:gravity="center"
                    style="@style/b1"
                    android:paddingStart="@dimen/dp24"
                    android:paddingEnd="@dimen/dp24"
                    android:text="개념"
                    mainTabTextStyle="@{ currentTab }"
                    />

                <TextView
                    android:id="@+id/mobileTab2"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp56"
                    android:gravity="center"
                    style="@style/b1"
                    android:paddingStart="@dimen/dp24"
                    android:paddingEnd="@dimen/dp24"
                    android:text="문제풀이"
                    mainTabTextStyle="@{ currentTab }"
                    />

                <TextView
                    android:id="@+id/mobileTab3"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp56"
                    android:gravity="center"
                    style="@style/b1"
                    android:paddingStart="@dimen/dp24"
                    android:paddingEnd="@dimen/dp24"
                    android:text="분석"
                    mainTabTextStyle="@{ currentTab }"
                    />

                <TextView
                    android:id="@+id/mobileTab4"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp56"
                    android:gravity="center"
                    style="@style/b1"
                    android:paddingStart="@dimen/dp24"
                    android:paddingEnd="@dimen/dp24"
                    visibleIf="@{ !vm.assessmentExamGroup.empty }"
                    android:text="대학"
                    mainTabTextStyle="@{ currentTab }"
                    />

                <!--                <TextView-->
                <!--                    android:id="@+id/mobileTab8"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="@dimen/dp56"-->
                <!--                    android:gravity="center"-->
                <!--                    style="@style/b1"-->
                <!--                    android:paddingStart="@dimen/dp24"-->
                <!--                    android:paddingEnd="@dimen/dp24"-->
                <!--                    android:text="대학"-->
                <!--                    mainTabTextStyle="@{ currentTab }"-->
                <!--                    />-->

            </LinearLayout>
        </HorizontalScrollView>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>