<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".revision2021.activity.LCWrongNoteActivity">


    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.LCWrongNoteAViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerCl"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@color/black_200"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:src="@drawable/ic_arrow_left_24"
                android:focusable="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/headerChipTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오답 학습"
                style="@style/c1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_purple_250_round"
                android:textColor="@color/white"
                app:layout_constraintStart_toEndOf="@+id/backBtn"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{ vm.headerTitle }"
                style="@style/b1r"
                android:textColor="@color/gray_600"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/headerChipTv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageButton
                android:id="@+id/externalPenBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_black_200_round_ripple"
                android:scaleType="center"
                android:src="@drawable/ic_npot_pencil"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/mainToolDivider"/>


            <View
                android:id="@+id/mainToolDivider"
                android:layout_width="2dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_gray_750_round"
                app:layout_constraintTop_toTopOf="@id/navPrevBtn"
                app:layout_constraintBottom_toBottomOf="@id/navPrevBtn"
                app:layout_constraintEnd_toStartOf="@id/navPrevBtn"
                android:layout_marginEnd="12dp"
                />
            <ImageButton
                android:id="@+id/navPrevBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_black_200_round_ripple"
                android:src="@drawable/ic_tailless_arrow_left_24_gray_600"
                android:enabled="@{ vm.isPagerFirstIndex == false }"
                imageview_tint="@{ vm.isPagerFirstIndex ? @color/gray_800 : @color/gray_600 }"
                android:focusable="false"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="@+id/navNextBtn"
                app:layout_constraintBottom_toBottomOf="@+id/navNextBtn"
                app:layout_constraintEnd_toStartOf="@+id/navNextBtn"/>
            <ImageButton
                android:id="@+id/navNextBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_black_200_round_ripple"
                android:src="@drawable/ic_tailless_arrow_right_24_gray_600"
                android:enabled="@{ vm.isPagerLastIndex == false}"
                imageview_tint="@{ vm.isPagerLastIndex ? @color/gray_800 : @color/gray_600 }"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

<!--        <androidx.constraintlayout.widget.ConstraintLayout-->
<!--            android:id="@+id/pencilContainer"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="0dp"-->
<!--            android:elevation="2dp"-->
<!--            app:layout_constraintVertical_bias="0"-->
<!--            app:layout_constraintTop_toTopOf="parent"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintBottom_toBottomOf="parent">-->


<!--            <com.freewheelin.pulley.revision2021.views.CookingPencilcaseView-->
<!--                android:id="@+id/pencilcaseView"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintTop_toTopOf="parent"-->
<!--                android:layout_marginTop="10dp"-->
<!--                android:layout_marginEnd="122dp"/>-->

<!--        </androidx.constraintlayout.widget.ConstraintLayout>-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/subHeaderCl"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@color/white"
            app:layout_constraintTop_toBottomOf="@+id/headerCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/patternHeaderLeftLl"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="left"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/titleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ vm.patternName }"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="32dp"
                    style="@style/h5"/>
<!--                    android:text="유형 04. 명제의 참"-->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/noteSelectorCl"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    >
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/noteSelectorRv"
                        bind_note_selector="@{ vm.filteredNoteCardList }"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_gravity="center_vertical"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                    <ImageView
                        android:id="@+id/whiteShadow"
                        android:layout_width="18dp"
                        android:layout_height="0dp"
                        android:visibility="@{ vm.isNoteSelectorScrollPositionEnd ? View.GONE : View.VISIBLE }"
                        android:src="@drawable/gradient_shadow_white_right"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


                <LinearLayout
                    android:id="@+id/appendHintBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_round_common"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="@{ vm.hintExist ? (vm.remainingHintSize == 0 ? View.GONE : View.VISIBLE) : View.GONE }"
                    android:layout_marginVertical="10dp"
                    android:orientation="horizontal"
                    >

                    <TextView
                        android:id="@+id/resetHintBtnTv2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        style="@style/h6"
                        android:text="힌트"
                        android:gravity="center"
                        android:textColor="@color/white" />
                    <TextView
                        android:id="@+id/resetHintBtnTv3"
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        style="@style/h6"
                        android:text="@{ vm.remainingHintSize + `` }"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:background="@drawable/bg_white_round_5"
                        android:textColor="@color/purple_300"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resetHintBtnLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gray_300_round_5_ripple"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="@{ vm.hintExist ? (vm.remainingHintSize == 0 ? View.VISIBLE : View.GONE) : View.GONE }"
                    android:layout_marginVertical="10dp"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:id="@+id/resetHintBtnIv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_refresh"/>

                    <TextView
                        android:id="@+id/resetHintBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        style="@style/h6"
                        android:text="힌트"
                        android:gravity="center"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/patternHeaderRightLl"
                android:layout_width="400dp"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    />

                <Button
                    android:id="@+id/conceptSolutionToggleBtn"
                    android:textColor="@color/gray_800"
                    style="@style/mo_h5"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="10dp"
                    android:layout_marginEnd="16dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_pattern_index_btn"
                    android:text="개념 | 정답 보기"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/headerBottomBorder"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/gray_300"
            app:layout_constraintTop_toBottomOf="@+id/subHeaderCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.freewheelin.pulley.revision2021.views.DisallowTouchEventViewPager
            android:id="@+id/pagerWrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/headerBottomBorder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.freewheelin.pulley.revision2023.ui.view.PencilPanel
            android:id="@+id/penPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp32"
            android:layout_marginEnd="@dimen/dp32"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintTop_toTopOf="@+id/pagerWrapper"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chatBotBgCl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_200_opa_30"
            tools:visibility="visible"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.cardview.widget.CardView
                android:id="@+id/chatBotCv"
                android:layout_width="500dp"
                android:layout_height="match_parent"
                android:maxHeight="736dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                tools:visibility="visible"
                android:visibility="gone"
                android:layout_marginVertical="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.freewheelin.pulley.revision2021.views.CookingWebview
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/chatBotBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48dp"
            android:layout_marginBottom="48dp"
            app:cardCornerRadius="999dp"
            app:cardElevation="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/chatBotLottie"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:lottie_speed="1"
                app:lottie_repeatMode="restart"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_fileName="ai_pulling_floating.json"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>