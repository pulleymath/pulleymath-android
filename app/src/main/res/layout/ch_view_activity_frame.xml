<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/ch_layoutActivityFrameContentMargin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ch_global_navigation_height"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/ch_layoutActivityFrameContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/ch_progressActivityFrameShowContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ch_bg_transparent"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="16dp"
                    app:cardBackgroundColor="@color/ch_bg_white_normal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.zoyi.channel.plugin.android.view.external.cpv.CircularProgressView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:visibility="visible"
                            app:ch_cpv_animAutostart="true"
                            app:ch_cpv_color="@color/ch_txt_black_darkest"
                            app:ch_cpv_indeterminate="true" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/ch_textActivityFrameShowContent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:textColor="@color/ch_txt_black_darkest"
                            android:textSize="16sp"
                            tools:text="HelloHelloHelloHelloHelloHelloHelloHelloHelloHelloHelloHelloHelloHelloHello" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

    <com.zoyi.channel.plugin.android.activity.base.navigation.GlobalNavigation
        android:id="@+id/ch_viewActivityFrameGlobalNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</FrameLayout>
