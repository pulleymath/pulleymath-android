<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".revision2021.activity.learningcourse.fragments.LCWrongNoteMapFragment">

    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2021.model.response.LCWrongNoteMapCardWrapper.PatternLearningStatus" />
        <import type="com.freewheelin.pulley.revision2021.model.response.LCWrongNoteMapCardWrapper.ConceptLearningStatus" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.LCWrongNoteMapViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wrongNoteRv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            bind_lc_wrong_note_card="@{ vm.filteredNoteCardList }"
            android:background="@color/gray_200"
            android:paddingHorizontal="22dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <LinearLayout
            android:id="@+id/nextStepBtnCl"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.65">
<!--            android:visibility="@{ vm.showChapterCompleteBtn ? View.VISIBLE : View.GONE }"-->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="@{ vm.showProgress ? View.GONE : View.VISIBLE }"
                android:background="@{ vm.originalNoteCardWrapper.conceptStatus == ConceptLearningStatus.ING ? @drawable/shadow_pattern_map_purple_150 : vm.originalNoteCardWrapper.patternStatus == PatternLearningStatus.DONE || vm.originalNoteCardWrapper.patternStatus == PatternLearningStatus.PERFECT ? @drawable/shadow_wrong_answer_bottom_btn : @drawable/shadow_pattern_map_purple_150 }"
                >

                <TextView
                    android:id="@+id/scoringBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ vm.bottomBtnText }"
                    android:textColor="@{ vm.originalNoteCardWrapper.conceptStatus == ConceptLearningStatus.ING ? @color/purple_300 : vm.originalNoteCardWrapper.patternStatus == PatternLearningStatus.DONE || vm.originalNoteCardWrapper.patternStatus == PatternLearningStatus.PERFECT ? @color/white : @color/purple_300 }"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="25dp"
                    android:lineHeight="26dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    imageview_tint="@{ vm.originalNoteCardWrapper.conceptStatus == ConceptLearningStatus.ING ? @color/purple_300 : vm.originalNoteCardWrapper.patternStatus == PatternLearningStatus.DONE || vm.originalNoteCardWrapper.patternStatus == PatternLearningStatus.PERFECT ? @color/white : @color/purple_300 }"
                    android:src="@drawable/ic_review_next_btn"
                    app:layout_constraintTop_toTopOf="@+id/scoringBtn"
                    app:layout_constraintStart_toEndOf="@+id/scoringBtn"
                    app:layout_constraintBottom_toBottomOf="@+id/scoringBtn"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="@{ vm.showProgress ? View.VISIBLE : View.GONE }"
            android:indeterminateTint="@color/purple_200"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>