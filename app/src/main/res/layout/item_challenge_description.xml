<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <import type="com.freewheelin.pulley.revision2023.model.challenge.ChallengeUserStatus"/>
        <variable name="listener" type="com.freewheelin.pulley.revision2023.utils.listeners.ChallengeMissionClickListener" />
        <variable name="item" type="com.freewheelin.pulley.revision2023.model.challenge.ChallengeCourse"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/descriptionCl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp48"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/titleCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ item.parentDetailItem.introTitle }"
                    style="@style/h4"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_teacher"
                    visibleIf="@{ item.parentDetailItem.successfulUserCount != null }"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/challengeSuccessCountTv"/>
                <TextView
                    android:id="@+id/challengeSuccessCountTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    visibleIf="@{ item.parentDetailItem.successfulUserCount != null }"
                    android:text="@{ item.parentDetailItem.successfulUserCount + `명 성공`}"
                    android:textColor="@color/gray_600"
                    style="@style/h6"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/challengeDescTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/b2"
                android:layout_marginTop="24dp"
                android:textColor="@color/gray_700"
                android:text="풀리수학+ 프리미엄을 체험해 볼 수 있는 스타트 챌린지입니다 :)\n아래 4개의 미션을 진행해 클리어 도장을 모두 받으면, 풀리수학+ 쿠폰을 드려요!"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/periodCl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                visibleIf="@{ item.parentDetailItem.showPeriodView }"
                >
                <ImageView
                    android:id="@+id/calendarIv"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar_filled"
                    app:tint="@color/gray_600"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ item.parentDetailItem.periodText }"
                    style="@style/b2"
                    android:textColor="@color/gray_700"
                    android:layout_marginStart="4dp"
                    app:layout_constraintStart_toEndOf="@+id/calendarIv"
                    app:layout_constraintTop_toTopOf="@+id/calendarIv"
                    app:layout_constraintBottom_toBottomOf="@+id/calendarIv"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/bottomMarginView"
                android:layout_width="match_parent"
                android:layout_height="32dp"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/missionCl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
<!--            android:onClick="@{ () -> listener.onMissionClick(item)}"-->


            <ImageView
                android:id="@+id/stampIv"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/missionTv"
                app:layout_constraintVertical_chainStyle="packed"
                android:src="@{ item.status == ChallengeUserStatus.DONE ? @drawable/challenge_mission_stamp_clear : @drawable/challenge_mission_stamp_default }"/>
            <TextView
                android:id="@+id/missionTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{ item.stampText }"
                android:textColor="@color/gray_600"
                style="@style/h6"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/stampIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

<!--            <View-->
<!--                android:id="@+id/stampBottomMarginView"-->
<!--                android:layout_width="10dp"-->
<!--                android:layout_height="@dimen/dp48"-->
<!--                android:background="@color/red_200"-->
<!--                android:visibility="gone"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintTop_toBottomOf="@+id/missionTv"/>-->

        </androidx.constraintlayout.widget.ConstraintLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
