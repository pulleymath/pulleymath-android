<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable name="listener" type="com.freewheelin.pulley.revision2021.activity.fragments.AffiliatedSolveSolutionFragment.SolutionItemClickListener"/>
        <variable name="item" type="com.freewheelin.pulley.revision2021.model.response.AffiliatedSolution"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.AffiliatedSolveSolutionViewModel"/>
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/textHeaderContainer"
            android:visibility="gone"
            android:onClick="@{()->listener.onItemClick(item)}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/textHeaderTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{item.title}"
                style="@style/h5"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/dp36"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/pdfItemContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grey_f2f2f2_round"
                android:onClick="@{()->listener.onItemClick(item)}"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ item.title }"
                    android:maxLines="2"
                    style="@style/b2r"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_download_small"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/videoGroupContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@{item.isSelected ? @dimen/dp0 : @dimen/dp8}">
            <!--        8dp는 추후에 하위 인덱스에 아이템이 있을경우 0dp로바꾸고 헤더가있을경우 8dp로 해야한다-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="1dp"
                android:onClick="@{()->listener.onItemClick(item)}"
                android:background="@{item.isSelected ? @drawable/bg_white_ffffff_stroke_grey_e8e8e8_top_corner_ripple : @drawable/bg_white_ffffff_stroke_grey_e8e8e8_round_ripple}">

                <!--            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8_round_ripple">-->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/playerIv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_player"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/contentTv"
                        style="@style/mo_h4_sb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="5"
                        android:text="@{item.group_title}"
                        app:layout_constraintEnd_toStartOf="@+id/playTimeTv"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@+id/playerIv"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/playTimeTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{item.videoGroupDurationString}"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toTopOf="@+id/foldIv"
                        app:layout_constraintEnd_toStartOf="@+id/foldIv"
                        app:layout_constraintBottom_toBottomOf="@id/foldIv"/>

                    <ImageView
                        android:id="@+id/foldIv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/arrow_down_gray"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/videoItemContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/videoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_transparent_only_horizontal_stroke_grey_e8e8e8"
                android:onClick="@{()->listener.onItemClick(item)}"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/videoThumbnailContainer"
                    android:layout_width="104dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:background="@color/gray_400"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        bind_img_url="@{item.thumburl}"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


                <TextView
                    android:id="@+id/videoContentTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@{item.title}"
                    style="@style/b2"
                    android:maxLines="10"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/videoThumbnailContainer"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.minSec}"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/videoContentTv"
                    app:layout_constraintStart_toEndOf="@id/videoThumbnailContainer"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/videoFooterContainer"
            android:visibility="gone"
            android:onClick="@{()->listener.onItemClick(item)}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@drawable/bg_white_stroke_grey_e8e8e8_bottom_corner_ripple"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/emptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="해당 문제는 강의자료와 개념영상을\n제공하지 않습니다."
                style="@style/b2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</layout>