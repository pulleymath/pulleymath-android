<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ch_black_20"
        android:clickable="true"
        android:clipChildren="false"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="20dp"
            android:background="@color/ch_bg_transparent"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <FrameLayout
                android:id="@+id/ch_buttonPopUpLabelClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_marginBottom="6dp"
                android:background="@drawable/ch_background_bgtxt_absolute_black_lightest"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ch_icon_cancel"
                    app:tint="@color/ch_bgtxt_absolute_white_normal" />

            </FrameLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:orientation="vertical"
                app:cardBackgroundColor="@color/ch_bg_white_normal"
                app:cardCornerRadius="20dp"
                app:cardElevation="20dp"
                tools:layout_width="320dp">

                <com.zoyi.channel.plugin.android.view.viewgroup.MaxWidthLinearLayout
                    android:id="@+id/ch_rootPopUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="320dp"
                    android:orientation="vertical"
                    app:ch_mwll_maxWidth="520dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/ch_viewPopUpMedia"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:overScrollMode="never"
                            android:scrollbars="none"
                            android:visibility="gone"
                            app:layout_constrainedHeight="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintHeight_max="520dp"
                            app:layout_constraintHeight_min="180dp"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0"
                            tools:layout_constraintDimensionRatio="H,1:1"
                            tools:visibility="visible" />

                        <FrameLayout
                            android:id="@+id/ch_imagePopUpImageMultiple"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/ch_background_bgtxt_absolute_black_lightest_radius_10dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="4dp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="@id/ch_viewPopUpMedia"
                            app:layout_constraintRight_toRightOf="@id/ch_viewPopUpMedia"
                            tools:visibility="visible">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/ch_textPopUpImageMultiple"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/ch_bgtxt_absolute_white_dark"
                                android:textSize="11sp"
                                tools:text="1/3" />

                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/ch_buttonPopUpVolume"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/ch_background_bgtxt_absolute_black_lightest_radius_16dp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            tools:visibility="visible">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ch_imagePopUpVolume"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ch_icon_volume_off_filled"
                                app:tint="@color/ch_bgtxt_absolute_white_dark" />

                        </FrameLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ch_layoutPopupProfileContentLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.zoyi.channel.plugin.android.view.layout.AvatarLayout
                            android:id="@+id/ch_avatarPopUp"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="0dp"
                            app:ch_avatar_border_radius="10.8dp"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toLeftOf="@id/ch_textPopUpName"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/ch_textPopUpName"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:lineSpacingExtra="5sp"
                            android:maxLines="1"
                            android:textColor="@color/ch_txt_black_darkest"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintBottom_toBottomOf="@id/ch_avatarPopUp"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintLeft_toRightOf="@id/ch_avatarPopUp"
                            app:layout_constraintRight_toLeftOf="@id/ch_textPopUpTime"
                            app:layout_constraintTop_toTopOf="@id/ch_avatarPopUp"
                            tools:text="젤라또팩토리젤라또팩토리젤라또팩토리젤라또팩토리젤라또팩토리젤라또팩토리" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/ch_textPopUpTime"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:lineSpacingExtra="5sp"
                            android:maxLines="1"
                            android:textColor="@color/ch_txt_black_dark"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@id/ch_avatarPopUp"
                            app:layout_constraintLeft_toRightOf="@id/ch_textPopUpName"
                            app:layout_constraintRight_toLeftOf="@+id/ch_buttonPopUpClose"
                            app:layout_constraintTop_toTopOf="@id/ch_avatarPopUp"
                            app:layout_goneMarginEnd="10dp"
                            tools:text="04:12pm" />

                        <FrameLayout
                            android:id="@+id/ch_buttonPopUpClose"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/ch_background_bg_black_lighter_oval"
                            app:layout_constraintBottom_toBottomOf="@id/ch_textPopUpTime"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/ch_textPopUpTime"
                            tools:visibility="visible">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ch_icon_cancel"
                                app:tint="@color/ch_txt_black_dark" />

                        </FrameLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ch_layoutPopupContentLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <com.zoyi.channel.plugin.android.view.layout.message.TextMessageView
                            android:id="@+id/ch_viewPopUpMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            app:ch_tmv_lineSpacingExtra="2sp"
                            app:ch_tmv_maxLines="8"
                            app:ch_tmv_renderMode="SINGLE_VIEW"
                            app:ch_tmv_textColor="@color/ch_txt_black_darkest"
                            app:ch_tmv_textLinkColor="@color/ch_cobalt400"
                            app:ch_tmv_textSize="14sp"
                            app:layout_constraintBottom_toTopOf="@id/ch_textPopUpFileName"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="신규 가입하고 할인된 가격에 GET!"
                            tools:visibility="visible" />

                        <com.zoyi.channel.plugin.android.view.textview.FileRowTextView
                            android:id="@+id/ch_textPopUpFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            app:ch_cfr_fileCountTextSize="13sp"
                            app:ch_cfr_fileNameTextSize="13sp"
                            app:ch_cfr_fileSizeTextSize="13sp"
                            app:ch_cfr_iconSize="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ch_viewPopUpMessage"
                            tools:visibility="visible" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:id="@+id/ch_layoutPopUpLinkButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="10dp"
                        android:divider="@drawable/ch_divider_6dp"
                        android:orientation="horizontal"
                        android:showDividers="middle"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </com.zoyi.channel.plugin.android.view.viewgroup.MaxWidthLinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </FrameLayout>

</ScrollView>
