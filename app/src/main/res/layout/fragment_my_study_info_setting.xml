<?xml version="1.0" encoding="utf-8"?>
<layout>
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/gray_100"
        android:clickable="true"
        tools:context=".activities.mypage.MySignUpInfoFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@null"
                android:src="@drawable/ic_toolbar_back"
                app:tint="@color/gray_800"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/TextGray_800.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="학습 정보"
                android:textSize="@dimen/sp24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View style="@style/Border_Gray_300_Horizontal"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp24"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/infoConatiner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textToLogin"
                            style="@style/TextGray_800.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="현재 학교를 다니지 않습니다"
                            android:textSize="@dimen/sp14" />

                        <Switch
                            android:id="@+id/switchNoStudent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutSchoolSelect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:gravity="bottom"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/selectSchool"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp56"
                                android:background="@drawable/bg_white_stroke_gray_500"
                                android:paddingStart="@dimen/sp16"
                                android:textSize="@dimen/sp16"
                                android:singleLine="true"
                                android:gravity="center_vertical"
                                android:layout_weight="3"/>

                            <com.freewheelin.pulley.revision2023.ui.view.SecondaryButton
                                android:id="@+id/findSchoolBtn"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp56"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="검색하기"
                                />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutCitySelect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.freewheelin.pulley.legacy.views.PulleySpinner
                            android:id="@+id/selectCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutInfoOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/selectGradeLl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.freewheelin.pulley.legacy.views.PulleySpinner
                                android:id="@+id/selectMiddleGrade"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                />

                            <com.freewheelin.pulley.legacy.views.PulleySpinner
                                android:id="@+id/selectHighGrade"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                />
                            <com.freewheelin.pulley.legacy.views.PulleySpinner
                                android:id="@+id/selectElementaryGrade"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                />
                            <com.freewheelin.pulley.legacy.views.PulleySpinner
                                android:id="@+id/selectServicesGrade"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                />
                        </LinearLayout>

<!--                        <com.freewheelin.pulley.legacy.views.PulleySpinner-->
<!--                            android:id="@+id/selectGrade"-->
<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_marginTop="16dp"-->
<!--                            app:layout_constraintEnd_toEndOf="parent"-->
<!--                            app:layout_constraintStart_toStartOf="parent"-->
<!--                            app:layout_constraintTop_toTopOf="parent" />-->

                        <com.freewheelin.pulley.legacy.views.PulleySpinner
                            android:id="@+id/selectMajor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/selectGradeLl" />

                        <com.freewheelin.pulley.legacy.views.PulleySpinner
                            android:id="@+id/selectRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/selectMajor"/>

                        <com.freewheelin.pulley.legacy.views.PulleySpinner
                            android:id="@+id/selectEtc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/selectRate" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:id="@+id/layoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <com.freewheelin.pulley.revision2023.ui.view.CommonButton
                            android:id="@+id/registBtn"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp56"
                            android:layout_weight="3"
                            android:layout_marginTop="@dimen/dp32"
                            android:text="변경하기"
                            android:textSize="@dimen/sp18"
                             />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</layout>