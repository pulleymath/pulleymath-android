<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <variable name="listener" type="com.freewheelin.pulley.revision2021.activity.learningcourse.fragments.LCCookingFragment.CookingItemClickListener"/>
        <variable name="item" type="com.freewheelin.pulley.revision2021.model.CookingInfoItem"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.learningcourse.LCCookingViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightRvItemRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/gray_blue_100">

        <androidx.cardview.widget.CardView
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            android:visibility="gone"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

<!--            <com.freewheelin.pulley.revision2021.views.CustomYoutubePlayerView-->
<!--                android:id="@+id/videoPlayerView"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"/>-->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"/>


        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/exerciseContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@+id/videoContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginBottom="22dp"
                android:paddingHorizontal="26dp"
                android:paddingTop="26dp"
                android:paddingBottom="34dp"
                android:background="@drawable/shadow_concept_page_example_box"
                >

                <LinearLayout
                    android:id="@+id/quizTabHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:weightSum="60"
                    android:background="@drawable/bg_purple_100_round"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >

                </LinearLayout>

                <com.freewheelin.pulley.revision2021.views.CookingHorizontalScrollView
                    android:id="@+id/cookingHorizontalSv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="52dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cookingScrollRootCl"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <include
                                android:id="@+id/cookingQuiz0"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="@{ vm.cookingExercise0 == null ? View.GONE : View.VISIBLE }"
                                app:cookingExercise="@{ vm.cookingExercise0 }"
                                app:number="@{ vm.cookingExercise0.get1  }"
                                layout="@layout/fragment_cooking_quiz"/>

                            <include
                                android:id="@+id/cookingQuiz1"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:visibility="@{ vm.cookingExercise1 == null ? View.GONE : View.VISIBLE }"
                                app:cookingExercise="@{ vm.cookingExercise1 }"
                                app:number="@{ vm.cookingExercise1.get2  }"
                                layout="@layout/fragment_cooking_quiz"/>
                            <include
                                android:id="@+id/cookingQuiz2"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:visibility="@{ vm.cookingExercise2 == null ? View.GONE : View.VISIBLE }"
                                app:cookingExercise="@{ vm.cookingExercise2 }"
                                app:number="@{ vm.cookingExercise2.get3  }"
                                layout="@layout/fragment_cooking_quiz"/>
                            <include
                                android:id="@+id/cookingQuiz3"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:visibility="@{ vm.cookingExercise3 == null ? View.GONE : View.VISIBLE }"
                                app:cookingExercise="@{ vm.cookingExercise3 }"
                                app:number="@{ vm.cookingExercise3.get4  }"
                                layout="@layout/fragment_cooking_quiz"/>
                            <include
                                android:id="@+id/cookingQuiz4"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:visibility="@{ vm.cookingExercise4 == null ? View.GONE : View.VISIBLE }"
                                app:cookingExercise="@{ vm.cookingExercise4 }"
                                app:number="@{ vm.cookingExercise4.get5  }"
                                layout="@layout/fragment_cooking_quiz"/>
                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.freewheelin.pulley.revision2021.views.CookingHorizontalScrollView>


            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>