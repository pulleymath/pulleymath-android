<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/firstBar"
        android:layout_width="40dp"
        android:layout_height="10dp"
        android:orientation="vertical"
        android:background="@color/grey_e0e0e0"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/secondBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerCl">
    </View>

    <View
        android:id="@+id/secondBar"
        android:layout_width="40dp"
        android:layout_height="160dp"
        android:weightSum="100"
        android:background="@color/red_fe7b67"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerCl">
    </View>


    <View
        android:id="@+id/thirdBar"
        android:layout_width="40dp"
        android:layout_height="110dp"
        android:orientation="vertical"
        android:background="@color/grey_e0e0e0"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/secondBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerCl">
    </View>

    <TextView
        style="@style/TextBlack_4c4c4c.Bold"
        android:id="@+id/firstLabelTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:textSize="@dimen/sp12"
        android:text="3등급평균"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@+id/firstBar"
        app:layout_constraintEnd_toEndOf="@+id/firstBar"
        app:layout_constraintBottom_toBottomOf="@+id/firstBar"/>

    <TextView
        style="@style/TextBlack_4c4c4c.Bold"
        android:id="@+id/secondLabelTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:textSize="@dimen/sp12"
        android:text="3등급평균"
        android:textColor="@color/white_ffffff"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@+id/secondBar"
        app:layout_constraintEnd_toEndOf="@+id/secondBar"
        app:layout_constraintBottom_toBottomOf="@+id/secondBar"/>

    <TextView
        style="@style/TextBlack_4c4c4c.Bold"
        android:id="@+id/thirdLabelTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:textSize="@dimen/sp12"
        android:text="3등급평균"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@+id/thirdBar"
        app:layout_constraintEnd_toEndOf="@+id/thirdBar"
        app:layout_constraintBottom_toBottomOf="@+id/thirdBar"/>


    <TextView
        style="@style/TextGrey_e0e0e0.ExtraBold"
        android:id="@+id/firstValueTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="48%"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="@+id/firstBar"
        app:layout_constraintEnd_toEndOf="@+id/firstBar"
        app:layout_constraintBottom_toTopOf="@+id/firstBar"/>

    <TextView
        style="@style/TextGrey_e0e0e0.ExtraBold"
        android:id="@+id/secondValueTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="48%"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="@+id/secondBar"
        app:layout_constraintEnd_toEndOf="@+id/secondBar"
        app:layout_constraintBottom_toTopOf="@+id/secondBar"/>

    <TextView
        style="@style/TextGrey_e0e0e0.ExtraBold"
        android:id="@+id/thirdValueTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="48%"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="@+id/thirdBar"
        app:layout_constraintEnd_toEndOf="@+id/thirdBar"
        app:layout_constraintBottom_toTopOf="@+id/thirdBar"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomContainerCl"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintTop_toBottomOf="@+id/secondBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="확률과 통계"
            android:textSize="@dimen/sp18"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        
        <Button
            android:id="@+id/detailBtn"
            style="@style/TextGrey_9f9f9f.ExtraBold"
            android:layout_width="88dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_gray_200_stroke_grey_e8e8e8_round_16"
            android:text="상세보기"
            android:textSize="@dimen/sp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>



</merge>