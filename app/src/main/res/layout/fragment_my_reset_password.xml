<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white_fafafa"
        android:clickable="true"
        tools:context=".activities.mypage.MySignUpInfoFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white_ffffff">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@null"
                android:src="@drawable/ic_toolbar_back"
                app:tint="@color/black_4c4c4c"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 재설정"
                android:textSize="@dimen/sp24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View style="@style/Border_Grey_e8e8e8_Horizontal"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/dp24"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text"
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 사용 중인 비밀번호를 입력해 주세요."
                    android:textSize="@dimen/sp18" />

                <com.freewheelin.pulley.views.editText.DaebakPasswordField
                    android:id="@+id/currentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:DaebakPasswordField_Hint="현재 비밀번호"
                    app:DaebakPasswordField_isVisibleLabel="false" />
<!--                <com.freewheelin.pulley.views.editText.PasswordFieldV2-->
<!--                    android:id="@+id/currentPassword"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    app:PasswordFieldV2_Hint="현재 비밀번호"-->
<!--                    app:PasswordFieldV2_maxLength="15" />-->

                <TextView
                    android:id="@+id/text2"
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp32"
                    android:text="새로운 비밀번호를 입력해주세요."
                    android:textSize="@dimen/sp18" />

                <com.freewheelin.pulley.views.editText.DaebakPasswordField
                    android:id="@+id/newPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:DaebakPasswordField_Hint="새 비밀번호"
                    app:DaebakPasswordField_isVisibleLabel="false" />
<!--                <com.freewheelin.pulley.views.editText.PasswordFieldV2-->
<!--                    android:id="@+id/newPassword"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    app:PasswordFieldV2_Hint="새 비밀번호"-->
<!--                    app:PasswordFieldV2_maxLength="15" />-->

                <TextView
                    android:id="@+id/label"
                    style="@style/TextGrey_9f9f9f.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/text_please_input_6_between_15_eng_num_symbol"
                    android:textSize="@dimen/sp14" />

                <com.freewheelin.pulley.views.editText.DaebakPasswordField
                    android:id="@+id/newPasswordConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showEye="false"
                    app:DaebakPasswordField_Hint="새 비밀번호 확인"
                    app:DaebakPasswordField_isVisibleLabel="false" />
<!--                <com.freewheelin.pulley.views.editText.PasswordFieldV2-->
<!--                    android:id="@+id/newPasswordConfirm"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    app:PasswordFieldV2_Hint="새 비밀번호 확인"-->
<!--                    app:PasswordFieldV2_maxLength="15" />-->

                <com.freewheelin.pulley.views.buttons.PrimaryButton
                    android:id="@+id/changeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp56"
                    android:layout_marginTop="24dp"
                    android:text="@string/text_change" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</layout>