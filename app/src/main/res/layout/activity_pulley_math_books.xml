<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="planListener" type="com.freewheelin.pulley.activities.learning.tabFragment.book.PlanListenerV2" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.PulleyMathBooksViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".revision2023.ui.activity.PulleyMathBooksActivity">

        <LinearLayout
            android:id="@+id/headerLl"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:background="@color/black_333333"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:background="@android:color/transparent"
                android:padding="@dimen/dp16"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_arrow_black_left"
                app:tint="@color/color_white_ffffff" />
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/h4"
                android:layout_weight="999"
                android:gravity="center"
                android:text="풀리수학 문제집"
                android:textColor="@color/white"/>
            <View
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
        </LinearLayout>

        <ScrollView
            android:id="@+id/rootView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/headerLl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0">

            <LinearLayout
                android:id="@+id/totalPlanContainerLl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/gray_200"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical">

                    <TextView
                        android:id="@+id/headerTv"
                        style="@style/h1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp48"
                        android:layout_marginTop="@dimen/dp32"
                        android:text="풀리수학 문제집"
                        android:textColor="@color/black_4c4c4c"
                        android:textSize="@dimen/sp36" />

                    <TextView
                        android:id="@+id/subHeaderTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp48"
                        android:layout_marginTop="@dimen/dp16"
                        style="@style/b2r"
                        android:text="유형별 학습부터 기출, 내신대비까지!\n풀리수학의 다양한 문제집을 만나보세요."
                        android:textColor="@color/gray_600"/>

                    <View
                        android:id="@+id/topBorder"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_400"
                        android:layout_marginTop="@dimen/dp32"/>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/recommendBookContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        visibleIf="@{ vm.showRecommendBook }"
                        app:layout_constraintTop_toBottomOf="@+id/topBorder"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/recommendLabel"
                            style="@style/h3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp48"
                            android:layout_marginTop="@dimen/dp32"
                            android:text="추천 문제집"
                            android:textColor="@color/black_4c4c4c"

                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/recommendLl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="200dp"
                            android:layout_marginTop="@dimen/dp24"
                            app:layout_constraintTop_toBottomOf="@+id/recommendLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <com.freewheelin.pulley.activities.learning.tabFragment.book.RecommendBookList
                                android:id="@+id/firstRecommendList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                />

                            <com.freewheelin.pulley.activities.learning.tabFragment.book.RecommendBookList
                                android:id="@+id/secondRecommendList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/firstRecommendList"
                                />

                            <com.freewheelin.pulley.activities.learning.tabFragment.book.RecommendBookList
                                android:id="@+id/thirdRecommendList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/secondRecommendList"
                                />

                            <com.freewheelin.pulley.activities.learning.tabFragment.book.RecommendBookList
                                android:id="@+id/fourthRecommendList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/thirdRecommendList"
                                />

                            <FrameLayout
                                android:id="@+id/loadingContainer"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:minHeight="200dp"
                                android:background="@color/gray_200"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <com.airbnb.lottie.LottieAnimationView
                                    android:id="@+id/loadingLottie"
                                    android:layout_width="150dp"
                                    android:layout_height="150dp"
                                    android:layout_gravity="center"
                                    app:lottie_speed="1"
                                    app:lottie_repeatMode="restart"
                                    app:lottie_autoPlay="true"
                                    app:lottie_loop="true"
                                    app:lottie_fileName="circle_loading.json"/>
                            </FrameLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <View
                        android:id="@+id/topBorder2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        visibleIf="@{ vm.showRecommendBook }"
                        android:background="@color/gray_400"
                        android:layout_marginTop="@dimen/dp32"/>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/totalBooksCl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/totalLabelTv"
                            style="@style/h3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp48"
                            android:layout_marginTop="@dimen/dp32"
                            android:text="전체 문제집"
                            android:textColor="@color/gray_800"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.freewheelin.pulley.activities.learning.tabFragment.book.BookFilterView
                            android:id="@+id/filterView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="700dp"
                            android:clipToPadding="false"
                            android:paddingStart="@dimen/dp32"
                            android:paddingEnd="@dimen/dp32"
                            android:paddingBottom="@dimen/dp24"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/totalLabelTv" />
                        <View
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:background="@color/gray_400"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/filterView"/>

                        <com.freewheelin.pulley.views.GridRecyclerView
                            android:id="@+id/totalRv"
                            android:layout_width="0dp"
                            android:layout_height="720dp"
                            android:layout_marginStart="1dp"
                            android:paddingHorizontal="@dimen/dp32"
                            android:paddingTop="@dimen/dp32"
                            android:paddingBottom="@dimen/dp64"
                            android:clipToPadding="false"
                            android:visibility="@{ vm.showRecyclerView ? View.VISIBLE : View.INVISIBLE }"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/filterView"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintVertical_bias="0"/>

                        <FrameLayout
                            android:id="@+id/totalLoadingContainer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@color/gray_200"
                            app:layout_constraintTop_toTopOf="@+id/totalRv"
                            app:layout_constraintStart_toStartOf="@+id/totalRv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="@+id/totalRv"

                            >
                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/totalLoadingView"
                                android:layout_width="@dimen/dp200"
                                android:layout_height="@dimen/dp200"
                                android:layout_gravity="center"
                                app:lottie_speed="1"
                                app:lottie_repeatMode="restart"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_fileName="circle_loading.json"/>
                        </FrameLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/totalEmptyContainer"
                            android:visibility="@{ vm.showEmptyContainer ? View.VISIBLE : View.GONE }"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="@+id/filterView"
                            app:layout_constraintStart_toEndOf="@+id/filterView"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="@+id/filterView">

                            <ImageView
                                android:id="@+id/emptyIv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_plan_empty"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginBottom="@dimen/dp24"
                                app:layout_constraintBottom_toTopOf="@+id/emptyTv"/>


                            <TextView
                                style="@style/TextGrey_c0c0c0.Bold"
                                android:id="@+id/emptyTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/sp16"
                                android:textColor="@color/grey_c0c0c0"
                                android:lineSpacingExtra="8sp"
                                android:gravity="center_horizontal"
                                android:text="조건에 맞는 문제집이 없네요ㅠㅠ\n조건을 바꿔볼까요?"
                                app:layout_constraintTop_toBottomOf="@+id/emptyIv"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </ScrollView>


        <FrameLayout
            android:id="@+id/totalPlanCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="1dp"
            android:clickable="true"
            android:visibility="@{ vm.showTotalPlanCover ? View.VISIBLE : View.GONE }"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>