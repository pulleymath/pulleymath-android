<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.AffiliatedTestSolveViewModel"/>
    </data>

    <com.freewheelin.pulley.legacy.views.DisableHorizontalScrollView
        android:id="@+id/rootView"
        android:animateLayoutChanges="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:focusable="false"
        tools:context="com.freewheelin.pulley.revision2021.activity.AffiliatedTestSolveActivity">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="false"
            android:orientation="horizontal">

            <com.freewheelin.pulley.revision2021.views.AffiliatedTestGalleryView
                android:id="@+id/galleryView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:focusable="false"
                app:viewModel="@{ vm }"/>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/baseCl"
                android:layout_width="600dp"
                android:layout_height="match_parent"
                android:focusable="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/firstHeaderCl"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp56"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@color/black_200">

                    <ImageButton
                        android:id="@+id/backBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:padding="@dimen/dp24"
                        app:tint="@color/gray_600"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:srcCompat="@drawable/ic_arrow_left_18_14"
                        />
                    <TextView
                        android:id="@+id/titleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{vm.currentProblem.subject}"
                        style="@style/b1"
                        android:textColor="@color/gray_600"
                        app:layout_constraintStart_toEndOf="@+id/backBtn"
                        app:layout_constraintTop_toTopOf="@+id/backBtn"
                        app:layout_constraintBottom_toBottomOf="@+id/backBtn"/>

                    <com.freewheelin.pulley.revision2023.ui.view.CommonButton
                        android:id="@+id/submitBtn"
                        android:layout_width="62dp"
                        android:layout_height="0dp"
                        android:text="제출하기"
                        visibleIf="@{ !vm.isReview }"
                        style="@style/h6"
                        android:textColor="@color/white"
                        android:layout_marginVertical="8dp"
                        android:layout_marginEnd="@dimen/dp24"
                        commonButton_binding_enabled="@{ vm.isSubmitBtnActive }"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <ImageButton
                        android:id="@+id/externalPenBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_black_200_round_ripple"
                        android:scaleType="center"
                        android:src="@drawable/ic_pencil"
                        android:layout_marginEnd="@dimen/dp24"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/submitBtn"/>

                    <TextView
                        android:id="@+id/solutionDescTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="* 문제를 틀린 경우 해설을 확인할 수 있습니다."
                        style="@style/b1"
                        android:visibility="@{vm.isReview ? View.VISIBLE : View.GONE }"
                        android:textColor="@color/gray_600"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/externalPenBtn"/>
<!--                        tools:visibility="gone"-->

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/secondHeaderCl"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp56"
                    app:layout_constraintTop_toBottomOf="@id/firstHeaderCl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@color/black_200">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/galleryBtn"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:layout_marginStart="@dimen/dp32"
                        android:visibility="visible"
                        android:focusable="false"
                        app:lottie_loop="true"
                        app:lottie_fileName="gallery.json"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <LinearLayout
                        android:id="@+id/pageTool"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp36"
                        android:layout_marginStart="@dimen/dp24"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toEndOf="@+id/galleryBtn"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
<!--                        app:layout_constraintStart_toStartOf="parent"-->

                        <ImageButton
                            android:id="@+id/prevBtn"
                            android:layout_width="@dimen/dp36"
                            android:layout_height="match_parent"
                            android:src="@{ vm.problemIndex == 0 ? @drawable/ic_tailless_arrow_left_24 : @drawable/ic_tailless_arrow_left_24_gray_600}"
                            tools:src="@drawable/ic_tailless_arrow_left_24_gray_600"
                            android:background="@drawable/bg_black_200_round_ripple"
                            android:focusable="false"/>

<!--                        <View-->
<!--                            style="@style/Border_Gray_800_Vertical"-->
<!--                            android:layout_height="match_parent"/>-->

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/numCl"
                                android:layout_width="96dp"
                                android:layout_height="match_parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/numTv"
                                    style="@style/TextWhite.ExtraBold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{vm.currentProblem.no + ``}"
                                    tools:text="3"
                                    android:textSize="@dimen/sp24"
                                    app:layout_constraintEnd_toStartOf="@+id/numExtTv"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintHorizontal_chainStyle="packed"/>

                                <TextView
                                    android:id="@+id/numExtTv"
                                    style="@style/TextWhite.ExtraBold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    tools:text="+1"
                                    android:textSize="@dimen/sp14"
                                    app:layout_constraintBaseline_toBaselineOf="@+id/numTv"
                                    app:layout_constraintStart_toEndOf="@+id/numTv"
                                    app:layout_constraintEnd_toStartOf="@+id/totalCntTv"/>

                                <TextView
                                    android:id="@+id/totalCntTv"
                                    style="@style/TextGray_700.ExtraBold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{`/ ` + vm.problemList.size()}"
                                    android:layout_marginStart="4dp"
                                    tools:text="/ 30 (+1)"
                                    tools:visibility="visible"
                                    android:textSize="@dimen/sp14"
                                    app:layout_constraintBaseline_toBaselineOf="@+id/numExtTv"
                                    app:layout_constraintStart_toEndOf="@+id/numExtTv"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <ImageButton
                            android:id="@+id/nextBtn"
                            android:layout_width="@dimen/dp36"
                            android:layout_height="match_parent"
                            android:src="@{ vm.problemIndex == vm.problemList.size - 1 ? @drawable/ic_tailless_arrow_right_24 : @drawable/ic_tailless_arrow_right_24_gray_600}"
                            tools:src="@drawable/ic_tailless_arrow_right_24"
                            android:background="@drawable/bg_black_200_round_ripple"
                            android:focusable="false"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/icon_clock_basic"
                        android:visibility="@{ vm.isReview ? View.GONE : vm.showTimer ? View.VISIBLE : View.GONE }"
                        app:layout_constraintBottom_toBottomOf="@+id/remainingTime"
                        app:layout_constraintEnd_toStartOf="@+id/remainingTime"
                        app:layout_constraintTop_toTopOf="@+id/remainingTime"
                        app:layout_constraintVertical_bias="0.60" />
                    <TextView
                        android:id="@+id/remainingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:fontFamily="@font/font_pretendard_semibold"
                        android:textColor="@color/gray_600"
                        android:textSize="32sp"
                        android:visibility="@{ vm.isReview ? View.GONE : vm.showTimer ? View.VISIBLE : View.GONE }"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginEnd="@dimen/dp24"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="정답/해설 표시"
                        style="@style/b1"
                        android:textColor="@{ vm.isEnableSolutionSwitch ? @color/gray_600 : @color/gray_800 }"
                        visibleIf="@{vm.isReview }"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toTopOf="@+id/switchCl"
                        app:layout_constraintBottom_toBottomOf="@+id/switchCl"
                        app:layout_constraintEnd_toStartOf="@+id/switchCl"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/switchCl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <Switch
                            android:id="@+id/solutionSwitch"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:checked="@{ vm.showSolutionView }"
                            style="@style/Switch.ExtraLight"
                            visibleIf="@{ vm.isReview &amp;&amp; vm.isEnableSolutionSwitch }"
                            android:onCheckedChanged="@{vm::onCommentaryShowChanged}"
                            android:enabled="@{vm.isEnableSolutionSwitch}"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <Switch
                            android:id="@+id/solutionSwitchDisabled"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:checked="@{ vm.showSolutionView }"
                            style="@style/Switch.ExtraLightDisabled"
                            visibleIf="@{ vm.isReview &amp;&amp; !vm.isEnableSolutionSwitch }"
                            android:onCheckedChanged="@{vm::onCommentaryShowChanged}"
                            android:enabled="false"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/solveCl"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/secondHeaderCl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.freewheelin.pulley.legacy.views.DisableVerticalScrollView
                        android:id="@+id/problemContainer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:fillViewport="true"
                        android:scrollbars="none"
                        android:focusable="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/solutionContainer"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/memoArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false">
                            <ImageView
                                android:id="@+id/problemIv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/dp32"
                                android:scaleType="fitStart"
                                android:focusable="false"
                                imgRes="@{vm.currentProblem.img_url}"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.freewheelin.pulley.legacy.views.memoView.MemoView
                                android:id="@+id/problemMemoView"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:focusable="false"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.freewheelin.pulley.legacy.views.DisableVerticalScrollView>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/solutionContainer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_white_stroke_gray_300_left"
                        android:visibility="@{vm.showSolutionView &amp;&amp; vm.currentProblem.is_correct == false ? View.VISIBLE : View.GONE }"
                        app:layout_constraintWidth_percent="0.375"
                        app:layout_constraintStart_toEndOf="@+id/problemContainer"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        >

                        <View
                            style="@style/Border_Gray_300_Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            app:layout_constraintBottom_toBottomOf="@id/tabLayout"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tabLayout"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp56"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tabSelectedTextColor="@color/purple_300"
                            app:tabGravity="fill"
                            app:tabIndicatorColor="@color/purple_300"
                            app:tabIndicatorFullWidth="true"
                            app:tabIndicatorHeight="2dp"
                            app:tabMode="fixed">

                            <com.google.android.material.tabs.TabItem
                                android:id="@+id/tabItem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="해설" />

                            <com.google.android.material.tabs.TabItem
                                android:id="@+id/tabItem2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="개념" />
                        </com.google.android.material.tabs.TabLayout>

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/pager"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            app:layout_constraintTop_toBottomOf="@id/tabLayout"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>

<!--                    <com.freewheelin.pulley.legacy.views.PencilcaseView-->
<!--                        android:id="@+id/pencilcaseView"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginTop="@dimen/dp32"-->
<!--                        android:layout_marginEnd="@dimen/dp32"-->
<!--                        app:layout_constraintTop_toTopOf="@+id/problemContainer"-->
<!--                        app:layout_constraintEnd_toEndOf="@+id/problemContainer"/>-->
                    <com.freewheelin.pulley.revision2023.ui.view.PencilPanel
                        android:id="@+id/penPanel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:layout_marginTop="@dimen/dp32"
                        android:layout_marginEnd="@dimen/dp32"
                        app:layout_constraintTop_toTopOf="@+id/problemContainer"
                        app:layout_constraintEnd_toEndOf="@+id/problemContainer"/>/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dimCl"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/gray_500"
                    tools:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/secondHeaderCl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:visibility="@{vm.showDimBgView ? View.VISIBLE : View.GONE }"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/dimDialog"
                        android:layout_width="308dp"
                        android:layout_height="134dp"
                        android:background="@drawable/bg_white_round_ripple"
                        android:padding="@dimen/dp24"
                        android:visibility="@{vm.showDimView ? View.VISIBLE : View.GONE }"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.40">

                        <TextView
                            android:id="@+id/dimDialogTitle"
                            style="@style/h4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.minInDimDialog + `분 ` + vm.secInDimDialog +`초 후에 시험이 시작됩니다.`}"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <Button
                            android:id="@+id/dimDialogBtn"
                            style="@style/TextWhite.ExtraBold"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_purple_300_round_ripple"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="뒤로가기"
                            android:textSize="14dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.freewheelin.pulley.legacy.activities.solve.AnswerV2View
                    android:id="@+id/answerView"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp64"
                    android:layout_marginBottom="@dimen/dp32"
                    android:layout_marginEnd="@dimen/dp32"
                    android:elevation="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/galleryCloser"
                    android:visibility="@{ vm.showGalleryView ? View.VISIBLE : View.GONE }"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.freewheelin.pulley.legacy.views.DisableHorizontalScrollView>
</layout>