<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>

        <variable name="listener" type="com.freewheelin.pulley.revision2021.activity.fragments.ConceptCourseFragment.ChapterItemClickListener"/>
        <variable name="item" type="com.freewheelin.pulley.revision2021.model.StudyChapter"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.ConceptCourseViewModel"/>
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_200"
        >


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chapterCl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chapterInnerCl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/largeChapterCl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/largeChapterTitleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{ item.largeTitle }"
                        tools:text="Ⅰ. 함수의 극한과 연속"
                        android:visibility="@{ item.firstMiddleChapter ? View.VISIBLE : View.GONE }"
                        android:layout_marginTop="48dp"
                        android:layout_marginStart="48dp"
                        style="@style/h4"
                        android:textColor="@color/blue_black_200"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/middleChapterRootView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout_margin_top_dimen="@{ item.isTutorial ? @dimen/dp0 : @dimen/dp32 }"
                        tools:layout_marginTop="24dp"
                        app:layout_constraintTop_toBottomOf="@id/largeChapterTitleTv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/mediumChapterTitleTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/h5"
                            android:text="@{ item.middleTitle }"
                            tools:text="1. 함수의 극한"
                            android:layout_marginStart="48dp"
                            android:textColor="@color/blue_black_200"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/smallChapterRv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            bind_small_chapter="@{ item.children }"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintTop_toBottomOf="@id/mediumChapterTitleTv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    layout_margin_top_dimen="@{ item.isTutorial ? @dimen/dp264 : @dimen/dp40 }"
                    android:visibility="@{ item.isTutorial ? View.VISIBLE : View.GONE }"
                    app:layout_constraintTop_toBottomOf="@+id/largeChapterCl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/largeChapterBorder"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    android:background="@color/gray_400"
                    android:visibility="@{ item.hasNextItem || item.isParentChapterLast ? View.GONE : View.VISIBLE }"
                    android:layout_marginHorizontal="48dp"
                    app:layout_constraintTop_toBottomOf="@+id/largeChapterCl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/footerCl"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/chapterCl"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/footerView"
                android:layout_width="0dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
<!--                android:background="@drawable/shadow_main_page_box_bottom"-->

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>