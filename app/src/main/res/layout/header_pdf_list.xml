<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2021.viewmodel.PdfViewModel"/>
        <variable name="subjectSpinnerAdapter" type="android.widget.ArrayAdapter" />
        <variable name="categorySpinnerAdapter" type="android.widget.ArrayAdapter" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_200"
        android:layout_marginStart="@dimen/dp_minus35"
        android:layout_marginEnd="@dimen/dp_minus35"
        tools:context=".revision2021.activity.PdfListActivity">
        
        <TextView
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/h1"
            android:text="풀리북스"
            android:layout_marginTop="32dp"
            android:layout_marginStart="@dimen/dp48"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/subTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            style="@style/b2r"
            android:text="제휴 출판사 문제집이 통째로!\n무겁게 책 들고 다니지 마세요 :)"
            android:textColor="@color/gray_600"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleTv"/>

        <View
            android:id="@+id/titleBottomBorderView"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp32"
            android:background="@color/gray_400"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subTitleTv"/>

        <TextView
            android:id="@+id/subtitleTv"
            style="@style/h3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp48"
            android:layout_marginTop="@dimen/dp48"
            android:text="나의 풀리북스"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleBottomBorderView" />

        <LinearLayout
            android:id="@+id/textTotalCountLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="@+id/subtitleTv"
            app:layout_constraintStart_toEndOf="@+id/subtitleTv">
            <TextView
                style="@style/h6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 "/>
            <TextView
                android:id="@+id/pdfListCountTv"
                style="@style/h6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{vm.pdfListLength}"/>
            <TextView
                style="@style/h6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="개"/>
        </LinearLayout>

        <com.freewheelin.pulley.revision2021.views.Spinner
            android:id="@+id/spinnerSubject"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:background="@drawable/bg_spinner_common"
            app:layout_constraintStart_toStartOf="@+id/subtitleTv"
            app:layout_constraintTop_toBottomOf="@+id/subtitleTv"
            android:selectedItemPosition="@={vm.subjectSelectedPosition}"
            app:adapter="@{subjectSpinnerAdapter}" />

        <com.freewheelin.pulley.revision2021.views.Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            android:background="@drawable/bg_spinner_common"
            app:layout_constraintStart_toEndOf="@+id/spinnerSubject"
            app:layout_constraintTop_toTopOf="@+id/spinnerSubject"
            android:selectedItemPosition="@={vm.categorySelectedPosition}"
            app:adapter="@{categorySpinnerAdapter}" />
        <TextView
            android:id="@+id/purchaseTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/b1"
            android:textColor="@color/gray_700"
            android:text="열람할 수 있는 책 보기"
            android:layout_marginStart="@dimen/dp16"
            app:layout_constraintStart_toEndOf="@+id/spinnerCategory"
            app:layout_constraintTop_toTopOf="@+id/spinnerCategory"
            app:layout_constraintBottom_toBottomOf="@+id/spinnerCategory"
            />
        <Switch
            android:id="@+id/purchaseSwtich"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="@={vm.isOpenableBookSelected}"
            android:onCheckedChanged="@{(switch, flag) -> vm.openableBookListener(flag)}"
            app:layout_constraintTop_toTopOf="@+id/purchaseTv"
            app:layout_constraintBottom_toBottomOf="@+id/purchaseTv"
            app:layout_constraintStart_toEndOf="@+id/purchaseTv"
            android:layout_marginStart="@dimen/dp8"/>

        <SearchView
            android:id="@+id/searchNameInHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp48"
            android:visibility="visible"
            android:queryHint="문제집명으로 검색하세요."
            searchview_hint_size="@{ @dimen/sp18 }"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:setOnQueryTextListener="@{vm.searchViewTextQueryListener}"
            tools:setOnQueryTextFocusChangeListener="@{vm.headerSearchViewQueryTextFocusChangeListener}"
            android:setOnCloseListener="@{vm.headerSearchViewCloseListener}"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
