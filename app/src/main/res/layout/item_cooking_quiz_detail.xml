<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2021.model.QuizFormat" />
        <variable name="quiz" type="com.freewheelin.pulley.revision2021.model.CookingQuiz"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quizCl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:id="@+id/quizIvWrapperLl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.65"
            app:layout_constraintHorizontal_bias="0">

            <ImageView
                android:id="@+id/quizIv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                tools:src="@drawable/dummy_cooking_only_quiz"
                cookingImgResOnPicasso="@{ quiz.quizImageUrl }"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/answerPanelLl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/answerLl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/answerTv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="정답: "
                    android:layout_gravity="center"
                    style="@style/mo_b2r"
                    tools:visibility="visible"
                    android:visibility="@{ !quiz.isCorrectAnswer &amp;&amp; quiz.isAnswerEntered ? View.VISIBLE : View.INVISIBLE }"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/answerWrapperCl"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp">

                    <TextView
                        android:id="@+id/correctAnswerTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:text="@{ quiz.answer }"
                        tools:text="-33"
                        android:gravity="center"
                        android:ellipsize="end"
                        android:maxLines="1"
                        style="@style/h4"
                        android:layout_gravity="center_horizontal"
                        tools:visibility="visible"
                        android:visibility="@{ !quiz.isCorrectAnswer &amp;&amp; quiz.isAnswerEntered &amp;&amp; quiz.format == QuizFormat.Short ? View.VISIBLE : View.GONE }"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                    <ImageView
                        android:id="@+id/correctAnswerIv2"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="8dp"
                        tools:visibility="gone"
                        android:visibility="@{ !quiz.isCorrectAnswer &amp;&amp; quiz.isAnswerEntered &amp;&amp; quiz.format != QuizFormat.Short ? View.VISIBLE : View.GONE }"
                        cookingImgRes="@{ quiz.correctAnswerImage }"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                >

                <LinearLayout
                    android:id="@+id/hintBtn"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    visibleOrInvisibleIf="@{ quiz.hintExist }"
                    android:focusable="@{ quiz.isHintUsed ? false : true }"
                    android:background="@{ quiz.isHintUsed ? @drawable/bg_gray_300_round_stroke : @drawable/bg_btn_round_common }"
                    tools:background="@drawable/bg_btn_round_common">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="힌트"
                        android:gravity="center"
                        android:textColor="@color/white"
                        style="@style/mo_h5"/>

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/quizSingleAnswerCl"
                    android:layout_width="80dp"
                    android:layout_height="36dp">

                    <TextView
                        android:id="@+id/quizSingleAnswer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@{ quiz.isAnswerEntered ? `` : `정답 입력` }"
                        tools:text="정답 입력"
                        style="@style/b2"
                        android:gravity="center"
                        tools:visibility="gone"
                        android:background="@{ quiz.afterTryAnswered ? @drawable/bg_white_stroke_gray_300_round_5 : @drawable/bg_white_stroke_purple_300_round_5 }"
                        tools:background="@drawable/bg_white_stroke_purple_300_round_5"
                        android:visibility="@{ quiz.format == QuizFormat.Short ? View.GONE : View.VISIBLE }"
                        android:textColor="@{ quiz.afterTryAnswered ? @color/gray_300 : @color/purple_300 }"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />


                    <Button
                        android:id="@+id/quizAnswerBtn"
                        android:layout_width="80dp"
                        android:layout_height="36dp"
                        android:background="@{ quiz.isAnswerEntered ? @drawable/bg_white_stroke_gray_300_round_5 : @drawable/bg_white_stroke_purple_300_round_5 }"
                        tools:background="@drawable/bg_white_stroke_purple_300_round_5"
                        android:gravity="center"
                        android:text="정답 입력"
                        android:visibility="@{ quiz.format == QuizFormat.Short ? View.VISIBLE : View.GONE }"
                        tools:visibility="visible"
                        android:maxLength="9"
                        android:singleLine="true"
                        style="@style/b2"
                        android:textColor="@{ quiz.isAnswerEntered ? @color/gray_800 : @color/purple_300 }"
                        tools:textColor="@color/purple_300"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/alreadySelectedAnswerIv"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        cookingImgRes="@{ quiz.selectedQuizAnswerImageUrl }"
                        android:visibility="@{ quiz.isAnswerEntered &amp;&amp; quiz.format == QuizFormat.Single ? View.VISIBLE : View.GONE }"
                        app:layout_constraintTop_toTopOf="@+id/quizSingleAnswer"
                        app:layout_constraintStart_toStartOf="@+id/quizSingleAnswer"
                        app:layout_constraintEnd_toEndOf="@+id/quizSingleAnswer"
                        app:layout_constraintBottom_toBottomOf="@+id/quizSingleAnswer"/>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>



        </LinearLayout>

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@{ quiz.isAnswerEntered ? quiz.isCorrectAnswer ? @drawable/ic_o_right_answer : @drawable/ic_x_wrong_answer : null }"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>