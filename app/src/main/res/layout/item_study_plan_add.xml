<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:padding="2dp">

        <TextView
            style="@style/TextPurple_300.ExtraBold"
            android:id="@+id/activeTag"
            android:textSize="@dimen/sp14"
            android:paddingBottom="4dp"
            android:paddingTop="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="최대 글자 몇글"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="@+id/cardUpdateTag"
            app:layout_constraintBottom_toBottomOf="@+id/cardUpdateTag"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/bg_purple_100_round_ripple"/>

        <TextView
            android:id="@+id/cardUpdateTag"
            style="@style/TextRed_300.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPDATE"
            android:textSize="@dimen/sp14"
            android:layout_marginStart="8dp"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/activeTag"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintTop_toBottomOf="@+id/cardUpdateTag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="5dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/blackCl"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@color/gray_800"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bookNameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp20"
                        android:layout_marginEnd="@dimen/dp20"
                        android:text="2점문항 efefefafeaefaewf"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp16"
                        android:lineSpacingExtra="@dimen/sp8"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/TextGray_800.Bold"
                    android:id="@+id/subjectTagTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_marginStart="@dimen/dp20"
                    android:layout_marginEnd="@dimen/dp20"
                    android:textSize="@dimen/sp16"
                    android:text="확률과 통계"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/blackCl"/>

                <TextView
                    style="@style/TextGray_500.Bold"
                    android:id="@+id/chapterTv"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/dp20"
                    android:layout_marginEnd="@dimen/dp20"
                    android:textSize="@dimen/sp14"
                    android:text="지수함수와 로그함수 ①외 2단원?"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/subjectTagTv"/>

                <TextView
                    android:id="@+id/problemCntTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp24"
                    android:layout_marginEnd="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp32"
                    android:textColor="@color/gray_700"
                    android:textSize="@dimen/sp14"
                    android:text="150개"
                    app:layout_constraintTop_toBottomOf="@+id/chapterTv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <LinearLayout
                    android:id="@+id/tagContainerLl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp20"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="@dimen/dp24"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/problemCntTv"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                </LinearLayout>

                <View
                    android:id="@+id/hider"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/white_c0ffffff"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"></View>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <Button
            style="@style/TextWhite.ExtraBold"
            android:id="@+id/addBtn"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/dp24"
            android:background="@drawable/bg_yellow_300_round_18"
            android:text="추가하기"
            android:drawableLeft="@drawable/ic_plus_small"
            android:paddingStart="27dp"
            android:paddingEnd="20dp"
            android:textSize="@dimen/sp14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            style="@style/TextGray_800.Bold"
            android:id="@+id/addedDateTv"
            android:layout_width="152dp"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/dp24"
            android:gravity="center"
            android:textSize="@dimen/sp14"
            android:background="@drawable/bg_gray_200_round_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>