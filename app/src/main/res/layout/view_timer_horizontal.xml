<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <merge
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            style="@style/TestGray_200.Bold"
            android:id="@+id/timerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="타이머 표시"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <Switch
            android:id="@+id/timerSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            style="@style/Switch.ExtraLight"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/timerLabel"/>

        <TextView
            style="@style/TextGray_700.Bold"
            android:id="@+id/hideGuideLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="타이머를 숨겼습니다."
            android:layout_marginStart="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/timerSwitch" />

        <TextView
            android:id="@+id/hourMinTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:lineSpacingExtra="0sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:text="1:40"
            android:textSize="36sp"
            android:textColor="@color/white"
            app:layout_constraintStart_toEndOf="@+id/timerSwitch"
            app:layout_constraintTop_toTopOf="@+id/timerSwitch"
            app:layout_constraintBottom_toBottomOf="@+id/timerSwitch"/>

        <TextView
            android:id="@+id/secTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:lineSpacingExtra="0sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:text=":00"
            android:textSize="36sp"
            android:textColor="@color/gray_600"
            app:layout_constraintStart_toEndOf="@+id/hourMinTv"
            app:layout_constraintTop_toTopOf="@+id/hourMinTv"
            app:layout_constraintBottom_toBottomOf="@+id/hourMinTv"/>

        <TextView
            style="@style/TextRed_300.Bold"
            android:id="@+id/overTimerTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 0:00:00"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/secTv"
            app:layout_constraintTop_toTopOf="@+id/secTv"
            app:layout_constraintBottom_toBottomOf="@+id/secTv"/>

        <ImageButton
            android:id="@+id/timerPlayBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/timer_play"
            android:background="@drawable/bg_black_100_round"
            app:layout_constraintStart_toEndOf="@+id/overTimerTv"
            app:layout_constraintTop_toTopOf="@+id/secTv"
            app:layout_constraintBottom_toBottomOf="@+id/secTv"/>

        <RadioGroup
            android:id="@+id/typeRg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="@+id/secTv"
            app:layout_constraintBottom_toBottomOf="@+id/secTv"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/strictRb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="100분 후 자동 제출"
                android:textColor="@color/purple_200"
                android:textSize="16sp"
                android:theme="@style/OMR_radio_button" />

            <RadioButton
                android:id="@+id/lenientRb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="36dp"
                android:text="시간 제한 없음"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:theme="@style/OMR_radio_button" />
        </RadioGroup>
    </merge>
</layout>