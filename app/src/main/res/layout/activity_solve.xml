<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.SolveActViewModel"/>
        <variable name="isTablet" type="Boolean"/>
    </data>
    <com.freewheelin.pulley.legacy.views.DisableHorizontalScrollView
        android:animateLayoutChanges="true"
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:focusable="false"
        tools:context="com.freewheelin.pulley.legacy.activities.solve.SolveActivity">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="false"
            android:orientation="horizontal">

            <com.freewheelin.pulley.legacy.activities.solve.GalleryView
                android:id="@+id/galleryView"
                android:layout_width="400dp"
                android:layout_height="match_parent"
                android:focusable="false"
                android:visibility="visible"
                tools:visibility="gone"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/solveCl"
                android:layout_width="1000dp"
                android:layout_height="match_parent"
                android:focusable="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mainHeaderView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp64"
                    android:background="@color/black_200"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/backBtn"
                        android:layout_width="@dimen/dp80"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:src="@drawable/ic_toolbar_back"
                        android:focusable="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:tint="@color/gray_600" />

                    <TextView
                        style="@style/TextGray_600.Bold"
                        android:id="@+id/titleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp16"
                        android:layout_marginStart="@dimen/dp64"
                        android:text=""
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <com.freewheelin.pulley.legacy.views.SolveTimerView
                        android:id="@+id/timerView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp24"
                        android:layout_marginEnd="@dimen/dp32"
                        tools:visibility="visible"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/spyBtn"
                        app:layout_constraintStart_toEndOf="@+id/titleTv"
                        app:layout_constraintHorizontal_bias="1"
                        app:orientation_subname="solve"
                        >
                    </com.freewheelin.pulley.legacy.views.SolveTimerView>

                    <Button
                        style="@style/TextGray_800.ExtraBold"
                        android:id="@+id/spyBtn"
                        android:layout_width="@dimen/dp64"
                        android:layout_height="@dimen/dp36"
                        android:text="SPY"
                        android:textSize="@dimen/sp16"
                        android:layout_marginEnd="@dimen/dp24"
                        android:background="@drawable/bg_gray_600_round_ripple"
                        android:focusable="false"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/toolView2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp64"
                    android:background="@color/black_200"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mainHeaderView"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/galleryBtn"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginStart="16dp"
                    android:visibility="visible"
                    android:focusable="false"
                    app:lottie_loop="true"
                    app:lottie_fileName="gallery.json"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mainHeaderView"
                    app:layout_constraintBottom_toBottomOf="@+id/toolView2"/>

                <LinearLayout
                    android:id="@+id/pageTool"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginStart="@dimen/dp24"
                    android:orientation="horizontal"
                    app:layout_goneMarginStart="@dimen/dp32"
                    app:layout_constraintStart_toEndOf="@+id/galleryBtn"
                    app:layout_constraintTop_toBottomOf="@+id/mainHeaderView"
                    app:layout_constraintBottom_toBottomOf="@+id/toolView2">

                    <ImageButton
                        android:id="@+id/prevBtn"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="match_parent"
                        android:src="@{ vm.selectedContent.problems.indexOf(vm.selectedProblemOb) == 0 ? @drawable/ic_tailless_arrow_left_24 : @drawable/ic_tailless_arrow_left_24_gray_600}"
                        tools:src="@drawable/ic_tailless_arrow_left_24_gray_600"
                        android:background="@drawable/bg_black_200_round_ripple"
                        android:focusable="false"/>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/numCl"
                            android:layout_width="96dp"
                            android:layout_height="match_parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/numTv"
                                style="@style/TextWhite.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                tools:text="3"
                                android:textSize="@dimen/sp24"
                                app:layout_constraintEnd_toStartOf="@+id/numExtTv"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintHorizontal_chainStyle="packed"/>

                            <TextView
                                android:id="@+id/numExtTv"
                                style="@style/TextWhite.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                tools:text="+1"
                                android:textSize="@dimen/sp14"
                                app:layout_constraintBaseline_toBaselineOf="@+id/numTv"
                                app:layout_constraintStart_toEndOf="@+id/numTv"
                                app:layout_constraintEnd_toStartOf="@+id/totalCntTv"/>

                            <TextView
                                android:id="@+id/totalCntTv"
                                style="@style/TextGray_700.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="/ -"
                                android:layout_marginStart="4dp"
                                tools:text="/ 30 (+1)"
                                tools:visibility="visible"
                                android:textSize="@dimen/sp14"
                                app:layout_constraintBaseline_toBaselineOf="@+id/numExtTv"
                                app:layout_constraintStart_toEndOf="@+id/numExtTv"
                                app:layout_constraintEnd_toEndOf="parent"
                                />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageButton
                        android:id="@+id/nextBtn"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="match_parent"
                        android:src="@{ vm.selectedContent.problems.indexOf(vm.selectedProblemOb) == vm.selectedContent.problems.size - 1 ? @drawable/ic_tailless_arrow_right_24 : @drawable/ic_tailless_arrow_right_24_gray_600}"
                        tools:src="@drawable/ic_tailless_arrow_right_24"
                        android:background="@drawable/bg_black_200_round_ripple"
                        android:focusable="false"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlTool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/pageTool"
                    app:layout_constraintBottom_toBottomOf="@+id/pageTool">

                    <ImageButton
                        android:id="@+id/externalPenBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_black_200_round_ripple"
                        android:scaleType="center"
                        android:src="@drawable/ic_npot_pencil"
                        visibleIf="@{ isTablet }"
                        android:layout_marginEnd="6dp"/>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="16dp"
                        visibleIf="@{ isTablet }"
                        android:background="@drawable/bg_gray_600_round"/>

                    <ImageButton
                        android:id="@+id/clearBtn"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="20dp"
                        android:visibility="visible"
                        android:focusable="false"
                        android:src="@drawable/ic_check_gray_24"
                        tools:src="@drawable/ic_check_filled_purple"
                        android:background="@null"/>

                    <ImageButton
                        android:id="@+id/scrapBtn"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:layout_marginEnd="20dp"
                        android:focusable="false"
                        android:src="@drawable/ic_bookmark"
                        tools:src="@drawable/ic_bookmark_filled_purple"
                        android:background="@null"/>

                    <ImageButton
                        android:id="@+id/reportBtn"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:src="@drawable/ic_report"
                        android:layout_marginEnd="20dp"
                        android:focusable="false"
                        android:background="@null"/>
                    <ImageButton
                        android:id="@+id/quickPanelBtn"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:src="@drawable/ic_toggle"
                        tools:src="@drawable/ic_toggle_filled_purple"
                        android:focusable="false"
                        android:background="@null"/>
                </LinearLayout>



                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mainFormatTool"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginEnd="@dimen/dp24"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mainHeaderView"
                    app:layout_constraintBottom_toBottomOf="@+id/toolView2">

                    <com.freewheelin.pulley.legacy.views.DaebakSwitch
                        android:id="@+id/solutionSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp16"
                        android:padding="8dp"
                        android:focusable="false"
                        visibleIf="@{ !vm.mainProfileV4.isAffiliated || !vm.selectedProblemOb.getResultByScoring().isYet }"
                        app:DaebakSwitch_Label="정답/해설 표시"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/speedyScoreSwitch"/>

                    <com.freewheelin.pulley.legacy.views.DaebakSwitch
                        android:id="@+id/speedyScoreSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:DaebakSwitch_Label="빠른 채점"
                        android:padding="8dp"
                        android:focusable="false"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/addSimilarProblemCl"
                    android:layout_width="@dimen/dp120"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginStart="@dimen/dp24"
                    android:visibility="gone"
                    android:background="@drawable/bg_yellow_300_round_18"
                    app:layout_constraintBottom_toBottomOf="@+id/pageTool"
                    app:layout_constraintStart_toEndOf="@+id/pageTool"
                    app:layout_constraintTop_toTopOf="@+id/pageTool">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:id="@+id/plusIv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            visibleIf="@{ vm.enableTargetService || vm.isOnlyStartChallengePiece }"
                            android:src="@drawable/ic_plus_white"
                            app:tint="@color/black_200" />

                        <ImageView
                            android:id="@+id/lockIv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            visibleIf="@{ !vm.enableTargetService &amp;&amp; !vm.isOnlyStartChallengePiece }"
                            android:src="@drawable/ic_lock_16_white"
                            app:tint="@color/black_200" />

                        <TextView
                            style="@style/TextBlack_200.ExtraBold"
                            android:id="@+id/similarTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="유사 문제"
                            android:textSize="@dimen/sp16" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:id="@+id/challengeStampIv"
                    android:layout_width="50dp"
                    android:layout_height="64dp"
                    android:src="@drawable/challenge_stamp_3d_image"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/addSimilarProblemCl"
                    app:layout_constraintBottom_toBottomOf="@+id/addSimilarProblemCl"
                    app:layout_constraintEnd_toEndOf="@+id/addSimilarProblemCl"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/changeSimilarProblemCl"
                    android:layout_width="@dimen/dp120"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginStart="@dimen/dp24"
                    android:background="@drawable/bg_yellow_300_round_18"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="@+id/pageTool"
                    app:layout_constraintStart_toEndOf="@+id/pageTool"
                    app:layout_constraintTop_toTopOf="@+id/pageTool">

                    <ImageView
                        android:id="@+id/changeIv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_problem_change"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/changeTv"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black_200" />

                    <TextView
                        style="@style/TextBlack_200.ExtraBold"
                        android:id="@+id/changeTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="문제 교체"
                        android:textSize="@dimen/sp16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toEndOf="@+id/changeIv"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mainBgView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/white"
                    android:animateLayoutChanges="true"
                    android:focusable="false"
                    app:layout_constraintTop_toBottomOf="@+id/toolView2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/container"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:focusable="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/speedAnswerView">

                        <com.freewheelin.pulley.legacy.views.DisableVerticalScrollView
                            android:id="@+id/problemContainer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:fillViewport="true"
                            android:scrollbars="none"
                            android:focusable="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/solutionContainer"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/memoArea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false">
                                <ImageView
                                    android:id="@+id/problemIv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:padding="@dimen/dp32"
                                    android:scaleType="fitStart"
                                    android:focusable="false"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <com.freewheelin.pulley.legacy.views.memoView.MemoView
                                    android:id="@+id/problemMemoView"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:focusable="false"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.freewheelin.pulley.legacy.views.DisableVerticalScrollView>

                        <com.freewheelin.pulley.legacy.views.DisableVerticalScrollView
                            android:id="@+id/solutionContainer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:fillViewport="true"
                            android:padding="1dp"
                            android:background="@drawable/bg_white_stroke_gray_300_left"
                            android:scrollbars="none"
                            android:focusable="false"
                            app:layout_constraintStart_toEndOf="@+id/problemContainer"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/problemInfoContainer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <TextView
                                        style="@style/TextGray_800.ExtraBold"
                                        android:id="@+id/answerTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/sp18"
                                        android:text="정답: -123"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"/>

                                    <TextView
                                        style="@style/TextGray_600.Bold"
                                        android:id="@+id/correctRateTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/sp14"
                                        android:text="정답률 : -"
                                        android:layout_marginTop="@dimen/dp24"
                                        app:layout_constraintTop_toBottomOf="@+id/answerTv"
                                        app:layout_constraintStart_toStartOf="parent"/>

                                    <TextView
                                        style="@style/TextGray_600.Bold"
                                        android:id="@+id/lvTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/sp14"
                                        android:text="난이도 : -"
                                        android:layout_marginTop="8dp"
                                        app:layout_constraintTop_toBottomOf="@+id/correctRateTv"
                                        app:layout_constraintStart_toStartOf="parent"/>

                                    <TextView
                                        style="@style/TextGray_600.Bold"
                                        android:id="@+id/referenceLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/sp14"
                                        android:text="유형명 : "
                                        android:layout_marginTop="8dp"
                                        app:layout_constraintTop_toBottomOf="@+id/lvTv"
                                        app:layout_constraintStart_toStartOf="parent"/>

                                    <TextView
                                        style="@style/TextGray_600.Bold"
                                        android:id="@+id/intentionTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/sp14"
                                        android:text="-"
                                        app:layout_constraintTop_toTopOf="@+id/referenceLabel"
                                        app:layout_constraintStart_toEndOf="@+id/referenceLabel"/>
                                </androidx.constraintlayout.widget.ConstraintLayout>



                                <ImageView
                                    android:id="@+id/solutionIv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="@dimen/dp32"
                                    android:paddingEnd="@dimen/dp32"
                                    android:paddingBottom="@dimen/dp64"
                                    android:paddingTop="@dimen/dp32"
                                    android:scaleType="fitStart"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/problemInfoContainer" />

                                <com.freewheelin.pulley.legacy.views.memoView.MemoView
                                    android:id="@+id/solutionMemoView"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.freewheelin.pulley.legacy.views.DisableVerticalScrollView>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/clearContainer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="#c0ffffff"
                            android:visibility="invisible"
                            android:focusable="false"
                            app:layout_constraintStart_toStartOf="@+id/problemContainer"
                            app:layout_constraintEnd_toEndOf="@+id/problemContainer"
                            app:layout_constraintBottom_toBottomOf="@+id/problemContainer"
                            app:layout_constraintTop_toTopOf="@+id/problemContainer">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_check_green_circle"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <ImageView
                            android:id="@+id/tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_tag_yellow_long"
                            android:layout_marginEnd="@dimen/dp32"
                            android:visibility="invisible"
                            app:layout_goneMarginEnd="140dp"
                            app:layout_constraintEnd_toStartOf="@+id/solutionContainer"
                            app:layout_constraintTop_toTopOf="@+id/problemContainer"/>

                        <com.freewheelin.pulley.revision2023.ui.view.PencilPanel
                            android:id="@+id/penPanel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp32"
                            android:layout_marginEnd="@dimen/dp32"
                            android:visibility="gone"
                            tools:visibility="visible"
                            app:layout_constraintTop_toBottomOf="@+id/quickPanelLl"
                            app:layout_constraintEnd_toStartOf="@id/solutionContainer"/>

                        <LinearLayout
                            android:id="@+id/quickPanelLl"
                            android:layout_width="192dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp32"
                            android:layout_marginEnd="@dimen/dp32"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="16dp"
                            android:background="@drawable/bg_gray_100_stroke_gray_300_round_10"
                            app:layout_constraintTop_toTopOf="@+id/problemContainer"
                            app:layout_constraintEnd_toStartOf="@+id/solutionContainer">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_gravity="center"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    style="@style/h6"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/gray_600"
                                    android:layout_gravity="center"
                                    android:text="정답/해설 표시"/>

                                <Switch
                                    style="@style/Switch.ExtraLight"
                                    android:id="@+id/solutionPanelSwitch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end"/>
                            </LinearLayout>
                            <View
                                android:layout_width="wrap_content"
                                android:layout_height="12dp"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_gravity="center"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    style="@style/h6"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/gray_600"
                                    android:layout_gravity="center"
                                    android:text="빠른 채점"/>

                                <Switch
                                    style="@style/Switch.ExtraLight"
                                    android:id="@+id/quickScoringPanelSwitch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end"/>
                            </LinearLayout>

                        </LinearLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/statusContainer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="#80818181"
                            android:visibility="gone"
                            android:clickable="true"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/problemContainer"
                            app:layout_constraintEnd_toEndOf="@+id/solutionContainer">

                            <ImageView
                                android:id="@+id/statusIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_siren_w28"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toTopOf="@+id/statusTv"
                                app:layout_constraintVertical_chainStyle="packed"/>

                            <TextView
                                style="@style/TextWhite.Bold"
                                android:id="@+id/statusTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textSize="@dimen/sp14"
                                android:lineSpacingExtra="6sp"
                                android:gravity="center"
                                android:text="신고 처리 중입니다.\n빠른 시일 내에 처리하겠습니다 :)"
                                app:layout_constraintTop_toBottomOf="@+id/statusIcon"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/emptyGuide"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@color/white"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="@+id/problemContainer"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/solutionContainer"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/emptyIv"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/rect_gray_500"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toTopOf="@+id/emptyTv"
                                app:layout_constraintVertical_chainStyle="packed"/>

                            <TextView
                                style="@style/TextGray_500.Bold"
                                android:id="@+id/emptyTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/sp16"
                                android:text="와! 틀린 문제가 없네요 :)"
                                android:layout_marginTop="@dimen/dp24"
                                app:layout_constraintTop_toBottomOf="@+id/emptyIv"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <com.freewheelin.pulley.legacy.activities.solve.SpeedAnswerView
                        android:id="@+id/speedAnswerView"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.freewheelin.pulley.legacy.activities.solve.AnswerView
                    android:id="@+id/answerView"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp64"
                    android:layout_marginBottom="@dimen/dp32"
                    android:layout_marginEnd="@dimen/dp32"
                    android:elevation="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/galleryCloser"
                    android:visibility="gone"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/chatBotBgCl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black_200_opa_30"
                    tools:visibility="gone"
                    android:visibility="gone"
                    android:translationZ="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/chatBotCv"
                        android:layout_width="500dp"
                        android:layout_height="match_parent"
                        android:maxHeight="736dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        android:layout_marginVertical="24dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <com.freewheelin.pulley.revision2021.views.CookingWebview
                            android:id="@+id/webView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            />

                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/chatBotBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="48dp"
                    android:layout_marginBottom="48dp"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="1dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    >

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/chatBotLottie"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:lottie_speed="1"
                        app:lottie_repeatMode="restart"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_fileName="ai_pulling_floating.json"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.freewheelin.pulley.legacy.views.DisableHorizontalScrollView>
</layout>