<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <TextView
        android:id="@+id/ch_textMessageHolderDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/ch_txt_black_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/ch_viewMessageHolderText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2020/2/22" />

    <!-- Date 밑에 매달려서 max width 까지 가로 길이만 잡아주는 친구,
         앵커가 date에 별도로 걸려있기에 실제로 영역을 차지하진 않습니다 -->

    <View
        android:id="@+id/ch_dummyMessageHolderContainer"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="100dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ch_textMessageHolderDate"
        app:layout_constraintWidth_max="@dimen/ch_chat_message_max_width" />

    <com.zoyi.channel.plugin.android.activity.chat.view.viewholder.UserMessageTextView
        android:id="@+id/ch_viewMessageHolderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ch_layoutMessageHolderContents"
        app:layout_constraintEnd_toEndOf="@id/ch_dummyMessageHolderContainer"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@id/ch_dummyMessageHolderContainer"
        app:layout_constraintTop_toBottomOf="@id/ch_textMessageHolderDate"
        app:layout_constrainedWidth="true"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ch_layoutMessageHolderContents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/ch_viewMessageHolderTailPadding"
        app:layout_constraintEnd_toEndOf="@id/ch_dummyMessageHolderContainer"
        app:layout_constraintStart_toStartOf="@id/ch_dummyMessageHolderContainer"
        app:layout_constraintTop_toBottomOf="@id/ch_viewMessageHolderText">

        <include layout="@layout/ch_holder_message_content" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ch_buttonMessageHolderResend"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="@dimen/ch_chat_message_divide_height"
        android:src="@drawable/ch_icon_refresh_circle_filled"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ch_viewMessageHolderText"
        app:layout_constraintEnd_toStartOf="@id/ch_viewMessageHolderText"
        app:tint="@color/ch_bgtxt_red_normal"
        tools:visibility="visible" />

    <View
        android:id="@+id/ch_viewMessageHolderTailPadding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ch_chat_message_tail_height"
        android:background="@color/ch_transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ch_layoutMessageHolderContents" />

</androidx.constraintlayout.widget.ConstraintLayout>
