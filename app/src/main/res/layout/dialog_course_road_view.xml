<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2021.model.CourseType" />
        <variable name="courseType" type="com.freewheelin.pulley.revision2021.model.CourseType"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="368dp"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/peakView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/rootLl">
<!--            app:layout_constraintHorizontal_bias="@{ courseType == CourseType.review ? 0.3 : courseType == CourseType.cooking ? 0.5 : 0.8 }">-->

            <ImageView
                android:layout_width="22dp"
                android:layout_height="15dp"
                android:src="@drawable/triangle88"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/rootLl"
            android:layout_width="368dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_white_round_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:paddingStart="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

<!--                <ImageView-->
<!--                    android:id="@+id/goMapBtn"-->
<!--                    android:layout_width="26dp"-->
<!--                    android:layout_height="26dp"-->
<!--                    android:src="@drawable/ic_header_map"-->
<!--                    android:visibility="@{ courseType == CourseType.cooking ? View.GONE : View.VISIBLE }"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    app:layout_constraintBottom_toBottomOf="parent"/>-->

                <TextView
                    android:id="@+id/stepTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ courseType == CourseType.PriorConcept ? `PRE STEP.` : courseType == CourseType.Cooking ? `STEP 1.` : `STEP 2.` }"
                    style="@style/h6"
                    android:textColor="@color/purple_300"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/titleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{ courseType == CourseType.PriorConcept ? `복습하기` : courseType == CourseType.Cooking ? `개념 익히기` : `유형 학습` }"
                    style="@style/h4"
                    android:layout_marginStart="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/stepTv"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <LinearLayout
                    android:id="@+id/goMapBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:visibility="@{ courseType == CourseType.Cooking ? View.GONE : View.VISIBLE }"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="메인으로"
                        style="@style/h6"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_review_next_btn"
                        app:tint="@color/gray_800"/>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
<!--            <TextView-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="중 1-1. 집합의 표현 방법"-->
<!--                style="@style/b1"-->
<!--                android:focusable="true"-->
<!--                android:layout_marginTop="8dp"-->
<!--                android:background="@drawable/bg_road_view_common"-->
