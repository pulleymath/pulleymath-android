<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context="com.freewheelin.pulley.activities.auth.InitSettingPersonalFragment">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp48"
            android:layout_marginBottom="@dimen/dp24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step1"
                style="@style/TextWhite.ExtraBold"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                android:background="@drawable/bg_purple_300_circle"
                android:gravity="center"
                android:text="1"
                android:textSize="@dimen/sp16" />

            <ImageView
                android:id="@+id/step1ComplteIv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_check_grey_engrave"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/step1Label"
                style="@style/TextPurple_300.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="개인 정보"
                android:textSize="@dimen/sp16" />

            <View
                style="@style/Border_Gray_300_Horizontal"
                android:layout_width="@dimen/dp16"
                android:layout_height="1dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/step2"
                style="@style/TextGray_500.Bold"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                android:background="@drawable/bg_gray_200_stroke_gray_300_circle"
                android:gravity="center"
                android:text="2"
                android:textSize="@dimen/sp16" />

            <TextView
                android:id="@+id/step2Label"
                style="@style/TextGray_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="학습 정보"
                android:textSize="@dimen/sp16" />

            <View
                style="@style/Border_Gray_300_Horizontal"
                android:layout_width="@dimen/dp16"
                android:layout_height="1dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/step3"
                style="@style/TextGray_500.Bold"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                android:background="@drawable/bg_gray_200_stroke_gray_300_circle"
                android:gravity="center"
                android:text="3"
                android:textSize="@dimen/sp16" />

            <TextView
                android:id="@+id/step3Label"
                style="@style/TextGray_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="선택 과목"
                android:textSize="@dimen/sp16" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/step1Body"
                android:layout_width="531dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/firstStepGuideTv"
                    style="@style/TextGray_800.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:lineSpacingExtra="@dimen/sp12"
                    android:text="ㅇㅇ님에게 최적화된 서비스를 위해\n정보가 필요해요! :)"
                    android:textSize="@dimen/sp24" />

                <TextView
                    style="@style/TextGray_800"
                    android:id="@+id/gradeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="학년"
                    android:textSize="@dimen/sp18"
                    android:layout_marginTop="@dimen/dp48" />

                <com.freewheelin.pulley.views.DaebakTabRadio
                    android:id="@+id/gradeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginTop="8dp"
                    app:tabWidth="0dp" />

                <TextView
                    style="@style/TextGray_800"
                    android:id="@+id/majorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="계열"
                    android:textSize="@dimen/sp18"
                    android:layout_marginTop="@dimen/dp48" />

                <com.freewheelin.pulley.views.DaebakTabRadio
                    android:id="@+id/majorRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginTop="8dp"
                    app:tabWidth="0dp" />

                <TextView
                    android:id="@+id/ratingLabel"
                    style="@style/TextGray_800"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp40"
                    android:text="최근 수학 모의고사 등급"
                    android:textSize="@dimen/sp18" />

                <com.freewheelin.pulley.views.DaebakTabRadio
                    android:id="@+id/ratingRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginTop="8dp"
                    app:tabWidth="58dp" />

                <com.freewheelin.pulley.views.buttons.PrimaryButton
                    android:id="@+id/nextBtn"
                    android:layout_width="@dimen/dp280"
                    android:layout_height="@dimen/dp56"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp64"
                    android:layout_marginBottom="@dimen/dp64"
                    android:text="다음"
                    app:buttonTheme="blue" />

            </LinearLayout>
        </ScrollView>


    </LinearLayout>

</layout>