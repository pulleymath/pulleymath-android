<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.GuestJoinViewModel"/>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootCl"
        android:layout_width="448dp"
        android:layout_height="match_parent">
<!--        android:layout_height="@dimen/dp768">-->

        <ScrollView
            android:id="@+id/scrollRootView"
            android:layout_width="448dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/updateGradeCl"
                android:layout_width="448dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <LinearLayout
                    android:id="@+id/headerLl"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:id="@+id/headerTv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        style="@style/h5"
                        android:text=""
                        />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        />
                    <ImageButton
                        android:id="@+id/exitBtn"
                        android:layout_width="72dp"
                        android:layout_height="56dp"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="16dp"
                        android:gravity="center"
                        android:src="@drawable/icon_x"
                        android:background="@null"
                        android:onClick="@{ () -> vm.exitBtn() }" />
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/infoScrollContainer"
                    android:layout_width="400dp"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toBottomOf="@+id/headerLl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/layoutButton"
                    app:layout_constraintVertical_bias="0">


                    <TextView
                        android:id="@+id/titleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30초 만에 가입하고\n다양한 혜택을 만나보세요!"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:gravity="center"
                        style="@style/h4"
                        android:textColor="@color/gray_800" />

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/planLoadingView"
                        android:layout_width="400dp"
                        tools:layout_height="400dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/titleTv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="24dp"
                        android:paddingHorizontal="12dp"
                        app:lottie_autoPlay="true"
                        app:lottie_fileName="guest_join_introduce.json"
                        app:lottie_loop="true" />

<!--                    <ImageView-->
<!--                        android:layout_width="400dp"-->
<!--                        android:layout_height="250dp"-->
<!--                        app:layout_constraintTop_toBottomOf="@id/titleTv"-->
<!--                        app:layout_constraintStart_toStartOf="parent"-->
<!--                        app:layout_constraintEnd_toEndOf="parent"-->
<!--                        tools:srcCompat="@tools:sample/avatars"-->
<!--                        android:layout_marginTop="24dp"/>-->

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/layoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/infoScrollContainer"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">


                    <Button
                        android:id="@+id/signUpBtn"
                        style="@style/h4"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp56"
                        android:background="@drawable/bg_btn_round_common"
                        android:text="무료로 가입하기"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/loginTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="로그인하기"
                        android:textColor="@color/gray_700"
                        android:background="@drawable/bottom_border_gray_700"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginTop="20dp"/>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
