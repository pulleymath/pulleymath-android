<!--                android:layout_height="40dp"-->
<!--                android:layout_marginStart="8dp"-->
<!--                android:text="레인지체인지"/>-->
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dailyPlannerWrapperLl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_marginVertical="24dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_white_round_20"
            app:layout_constraintWidth_percent="0.38"
            app:layout_constraintTop_toBottomOf="@id/headerLl"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/planSelectLl">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/calendarContainerCl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dateRangeCl"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_white_stroke_gray_500_round_18"
                    android:paddingHorizontal="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/plannerCalendarIv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_calendar_gray"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/b2"
                        android:text="@{ vm.selectedMondayOfTheWeek.toString(`yy. MM. dd`) + ` - ` + vm.selectedSundayOfTheWeek.toString(`yy. MM. dd`) }"
                        tools:text="23. 07. 17 - 23. 07. 23"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@+id/plannerCalendarIv"
                        app:layout_constraintTop_toTopOf="@+id/plannerCalendarIv"
                        app:layout_constraintBottom_toBottomOf="@+id/plannerCalendarIv"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="@+id/dateRangeCl"
                    app:layout_constraintBottom_toBottomOf="@+id/dateRangeCl"
                    app:layout_constraintEnd_toStartOf="@+id/dateRangeCl">
                    <ImageView
                        android:id="@+id/plannerPrevNaviBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_tailless_arrow_left_24"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="8dp"
                        app:tint="@color/gray_800"
                        android:background="@drawable/bg_white_ripple"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="@+id/dateRangeCl"
                    app:layout_constraintBottom_toBottomOf="@+id/dateRangeCl"
                    app:layout_constraintStart_toEndOf="@+id/dateRangeCl">
                    <ImageView
                        android:id="@+id/plannerNextNaviBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_tailless_arrow_right_24"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="8dp"
                        app:tint="@color/gray_800"
                        android:background="@drawable/bg_white_ripple"
                        />
                </androidx.cardview.widget.CardView>


            </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/plannerRv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                tools:listitem="@layout/item_user_planner"
                tools:visibility="visible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp"
                app:layout_constraintBottom_toBottomOf="@+id/plannerRv"
                android:background="@drawable/gradient_shadow_main_planner_footer"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

        <LinearLayout
