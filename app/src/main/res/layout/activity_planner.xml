                    android:text="중"
                    android:background="@{ vm.schoolType.isMiddle ? @drawable/bg_gray_800_round_18 : @drawable/bg_white_round_18 }"
                    android:textColor="@{ vm.schoolType.isMiddle ? @color/white : @color/gray_800}"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:onClick="@{ () -> vm.updateSchoolType(SchoolType.MIDDLE) }"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/h5"
                    android:text="고"
                    android:background="@{ vm.schoolType.isHigh ? @drawable/bg_gray_800_round_40 : @drawable/bg_white_round_18 }"
                    tools:background="@drawable/bg_gray_800_round_40"
                    android:textColor="@{ vm.schoolType.isHigh ? @color/white : @color/gray_800}"
                    tools:textColor="@color/white"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:onClick="@{ () -> vm.updateSchoolType(SchoolType.HIGH) }"/>

