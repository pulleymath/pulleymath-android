<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".revision2023.ui.activity.PlannerActivity">
    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2021.model.response.LCSubject.SubjectIndicator"/>
        <import type="com.freewheelin.pulley.legacy.assets.SubjectV3"/>
        <import type="com.freewheelin.pulley.revision2023.SchoolType"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.PlannerActViewModel"/>
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_200"
        >
        <LinearLayout
