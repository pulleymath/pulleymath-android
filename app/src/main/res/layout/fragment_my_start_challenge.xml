<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <import type="com.freewheelin.pulley.revision2023.model.challenge.ChallengeUserStatus"/>
        <variable name="vm" type="com.freewheelin.pulley.revision2023.viewmodel.MyMainPageFragViewModel"/>
        <variable name="mission1" type="com.freewheelin.pulley.revision2023.model.challenge.ChallengeCourse"/>
        <variable name="mission2" type="com.freewheelin.pulley.revision2023.model.challenge.ChallengeCourse"/>
        <variable name="mission3" type="com.freewheelin.pulley.revision2023.model.challenge.ChallengeCourse"/>
        <variable name="mission4" type="com.freewheelin.pulley.revision2023.model.challenge.ChallengeCourse"/>
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/gray_100"
        android:clickable="true"
        tools:context=".activities.mypage.MySignUpInfoFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@null"
                android:src="@drawable/ic_toolbar_back"
                app:tint="@color/gray_800"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="스타트 챌린지"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View style="@style/Border_Gray_300_Horizontal"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="48dp">

                <TextView
                    style="@style/b1"
                    android:textColor="@color/gray_500"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:text="스타트 챌린지 현황" />

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/stampGl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    app:columnCount="2"
                    app:alignmentMode="alignBounds"
                    app:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="100dp">

                    <LinearLayout
                        android:id="@+id/mission1Cl"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/missionTv"
                            tools:srcCompat="@drawable/challenge_mission_stamp_clear"
                            android:src="@{ mission1.status == ChallengeUserStatus.DONE ? @drawable/challenge_mission_stamp_clear : @drawable/challenge_mission_stamp_default }"
                            />
<!--                            android:src="@drawable/challenge_mission_stamp_clear"-->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{ mission1.stampText, default=`Mission 01. 개념` }"
                            android:textColor="@color/gray_600"
                            style="@style/h6"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@+id/stampIv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/mission2Cl"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            tools:srcCompat="@drawable/challenge_mission_stamp_clear"
                            android:src="@{ mission2.status == ChallengeUserStatus.DONE ? @drawable/challenge_mission_stamp_clear : @drawable/challenge_mission_stamp_default }"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{ mission2.stampText, default=`Mission 01. 개념` }"
                            android:textColor="@color/gray_600"
                            style="@style/h6"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/mission3Cl"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            tools:srcCompat="@drawable/challenge_mission_stamp_clear"
                            android:src="@{ mission3.status == ChallengeUserStatus.DONE ? @drawable/challenge_mission_stamp_clear : @drawable/challenge_mission_stamp_default }"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{ mission3.stampText, default=`Mission 01. 개념` }"
                            android:textColor="@color/gray_600"
                            style="@style/h6"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/mission4Cl"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:orientation="vertical"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/missionTv"
                            tools:srcCompat="@drawable/challenge_mission_stamp_clear"
                            android:src="@{ mission4.status == ChallengeUserStatus.DONE ? @drawable/challenge_mission_stamp_clear : @drawable/challenge_mission_stamp_default }"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{ mission4.stampText, default=`Mission 01. 개념` }"
                            android:textColor="@color/gray_600"
                            style="@style/h6"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </androidx.gridlayout.widget.GridLayout>

                <com.freewheelin.pulley.revision2023.ui.view.CommonButton
                    android:id="@+id/couponBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    commonButton_binding_enabled="@{ vm.startChallengeCouponStatus == null &amp;&amp; mission1.status == ChallengeUserStatus.DONE &amp;&amp; mission2.status == ChallengeUserStatus.DONE &amp;&amp; mission3.status == ChallengeUserStatus.DONE &amp;&amp; mission4.status == ChallengeUserStatus.DONE }"
                    android:text="쿠폰 발급받기"
                    android:textColor="@color/white"
                    style="@style/h4"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/stopChallengeCl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="10dp"
                    visibleIf="@{ vm.startChallengeCouponStatus == null }"
                    app:layout_constraintTop_toTopOf="@+id/guideTab"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/guideTab"
                    >

                    <TextView
                        android:id="@+id/compareTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="그만하기"
                        style="@style/b3"
                        android:textColor="@color/gray_700"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                    <View
                        android:id="@+id/lineView"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@color/gray_700"
                        android:layout_marginBottom="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>