<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp64"
            android:paddingEnd="@dimen/dp64"
            tools:context="com.freewheelin.pulley.activities.learning.tabFragment.snackTest.TestMainResultFragment">

            <TextView
                android:id="@+id/titleTv"
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="데일리 테스트 결과"
                android:textSize="@dimen/sp18"
                app:layout_constraintBottom_toTopOf="@+id/scoreTv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/scoreTv"
                style="@style/TextBlack_4c4c4c.ExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="60"
                android:textSize="@dimen/sp104"
                app:layout_constraintBottom_toTopOf="@+id/settingContainerCl"
                app:layout_constraintStart_toStartOf="@+id/titleTv"
                app:layout_constraintTop_toBottomOf="@+id/titleTv" />

            <TextView
                android:id="@+id/scoreLabel"
                style="@style/TextBlack_4c4c4c.ExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="@dimen/dp20"
                android:text="점"
                android:textSize="@dimen/sp48"
                app:layout_constraintBottom_toBottomOf="@+id/scoreTv"
                app:layout_constraintStart_toEndOf="@+id/scoreTv" />

            <TextView
                style="@style/TextPurple_6d6dff.ExtraBold"
                android:id="@+id/reportTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginBottom="2dp"
                android:textSize="@dimen/sp18"
                android:text="보고서 보기 &gt;"
                app:layout_constraintStart_toEndOf="@+id/scoreLabel"
                app:layout_constraintBottom_toBottomOf="@+id/scoreLabel"/>

            <TextView
                style="@style/TextGrey_c0c0c0"
                android:id="@+id/contentTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp24"
                android:lineSpacingExtra="8sp"
                android:textSize="@dimen/sp18"
                android:text="데일리 테스트는 아래의 기준에 따라 추천됩니다."
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/settingContainerCl" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/settingContainerCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp90"
                android:background="@drawable/bg_white_fafafa_stroke_grey_e8e8e8"
                android:visibility="invisible"
                app:layout_constraintTop_toBottomOf="@+id/scoreTv"
                app:layout_constraintBottom_toTopOf="@+id/startBtn"
                app:layout_constraintVertical_chainStyle="packed">

                <TextView
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:id="@+id/levelLabel"
                    android:layout_marginTop="@dimen/dp32"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="난이도 :"
                    android:textSize="@dimen/sp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/levelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp16"
                    android:layout_marginStart="8dp"
                    android:text="고난도 위주"
                    app:layout_constraintStart_toEndOf="@+id/levelLabel"
                    app:layout_constraintTop_toTopOf="@+id/levelLabel"
                    app:layout_constraintBottom_toBottomOf="@+id/levelLabel"/>

                <TextView
                    android:id="@+id/rangeLabel"
                    style="@style/TextGrey_c0c0c0.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp32"
                    android:text="출제 범위 :"
                    android:textSize="@dimen/sp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/levelLabel" />

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/rangeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp16"
                    android:layout_marginStart="8dp"
                    android:text="선행 단원 함께"
                    app:layout_constraintStart_toEndOf="@+id/rangeLabel"
                    app:layout_constraintTop_toTopOf="@+id/rangeLabel"
                    app:layout_constraintBottom_toBottomOf="@+id/rangeLabel"/>

                <TextView
                    android:id="@+id/subjectTv"
                    style="@style/TextGrey_9f9f9f.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:text="여기 과목 표시"
                    android:textSize="@dimen/sp16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/rangeTv"
                    app:layout_constraintTop_toBottomOf="@+id/rangeTv" />


                <ImageButton
                    android:id="@+id/settingBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_gear"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"
                    android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8_round"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>



            <com.freewheelin.pulley.views.buttons.PrimaryButton
                android:id="@+id/startBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp56"
                android:layout_marginTop="@dimen/dp56"
                android:text="시작하기"
                android:visibility="invisible"
                app:buttonTheme="blue"
                app:ButtonTextSize="@dimen/sp18"
                app:layout_constraintTop_toBottomOf="@+id/settingContainerCl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fullClearCl"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/white_fafafa"
                android:visibility="invisible"
                app:layout_constraintTop_toTopOf="@+id/settingContainerCl"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/startBtn">

                <TextView
                    style="@style/TextGrey_9f9f9f.Bold"
                    android:id="@+id/fullClearGuideTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp18"
                    android:lineSpacingExtra="8sp"
                    android:layout_marginTop="@dimen/dp64"
                    android:visibility="invisible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/secondLabelTv"
                    android:text="오늘의 데일리 테스트 클리어!"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    style="@style/TextGrey_9f9f9f"
                    android:id="@+id/secondLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp18"
                    android:text="2회차"
                    android:layout_marginTop="@dimen/dp24"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fullClearGuideTv"
                    app:layout_constraintBottom_toTopOf="@+id/secondScoreTv"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    style="@style/TextGrey_9f9f9f"
                    android:id="@+id/firstLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp18"
                    android:text="1회차"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="@+id/firstScoreTv"
                    app:layout_constraintEnd_toEndOf="@+id/firstScoreTv"
                    app:layout_constraintTop_toTopOf="@+id/secondLabelTv"/>

                <TextView
                    style="@style/TextGrey_9f9f9f"
                    android:id="@+id/thirdLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp18"
                    android:text="3회차"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="@+id/thirdScoreTv"
                    app:layout_constraintEnd_toEndOf="@+id/thirdScoreTv"
                    app:layout_constraintTop_toTopOf="@+id/secondLabelTv"/>

                <TextView
                    style="@style/TextGrey_9f9f9f.ExtraBold"
                    android:id="@+id/secondScoreTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/dp36"
                    android:text="40점"
                    android:layout_marginBottom="@dimen/dp72"
                    android:layout_marginTop="8dp"
                    android:visibility="invisible"
                    app:layout_constraintTop_toBottomOf="@+id/secondLabelTv"
                    app:layout_constraintStart_toStartOf="@+id/secondLabelTv"
                    app:layout_constraintEnd_toEndOf="@+id/secondLabelTv"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    style="@style/TextGrey_9f9f9f.ExtraBold"
                    android:id="@+id/firstScoreTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/dp36"
                    android:text="40점"
                    android:visibility="invisible"
                    android:layout_marginEnd="@dimen/dp64"
                    app:layout_constraintTop_toTopOf="@+id/secondScoreTv"
                    app:layout_constraintEnd_toStartOf="@+id/secondScoreTv"/>

                <TextView
                    style="@style/TextGrey_9f9f9f.ExtraBold"
                    android:id="@+id/thirdScoreTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/dp36"
                    android:text="40점"
                    android:visibility="invisible"
                    android:layout_marginStart="@dimen/dp64"
                    app:layout_constraintTop_toTopOf="@+id/secondScoreTv"
                    app:layout_constraintStart_toEndOf="@+id/secondScoreTv" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/giftContainerCl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white_ffffff">

                <ImageView
                    android:id="@+id/giftIv"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="32dp"
                    android:src="@drawable/ic_gift"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toTopOf="@+id/clearTv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    style="@style/TextBlack_4c4c4c.Bold"
                    android:id="@+id/clearTv"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp24"
                    android:textColor="@color/black_4c4c4c"
                    android:lineSpacingExtra="@dimen/sp12"
                    android:gravity="center_horizontal"
                    android:text="짝짝짝!\n오늘의 데일리 테스트 클리어 :)"
                    android:layout_marginTop="@dimen/dp24"
                    app:layout_constraintTop_toBottomOf="@+id/giftIv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/reportTv2"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    style="@style/TextPurple_6d6dff.ExtraBold"
                    android:id="@+id/reportTv2"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp24"
                    android:gravity="center_horizontal"
                    android:text="보고서 보기 &gt;"
                    android:layout_marginTop="@dimen/dp32"
                    android:layout_marginBottom="183dp"
                    app:layout_constraintTop_toBottomOf="@+id/clearTv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>