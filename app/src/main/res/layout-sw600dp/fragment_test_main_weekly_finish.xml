<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp64"
        android:paddingEnd="@dimen/dp64"
        tools:context="com.freewheelin.pulley.legacy.activities.learning.tabFragment.snackTest.TestMainWeeklyFragment">

        <TextView
            android:id="@+id/titleTv"
            style="@style/TextGray_800.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주간 테스트 결과"
            android:textSize="@dimen/sp18"
            app:layout_constraintBottom_toTopOf="@+id/scoreTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/scoreTv"
            style="@style/TextGray_800.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="60"
            android:textSize="@dimen/sp104"
            app:layout_constraintBottom_toTopOf="@+id/settingContainerCl"
            app:layout_constraintStart_toStartOf="@+id/titleTv"
            app:layout_constraintTop_toBottomOf="@+id/titleTv" />

        <TextView
            android:id="@+id/scoreLabel"
            style="@style/TextGray_800.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="@dimen/dp20"
            android:text="점"
            android:textSize="@dimen/sp48"
            app:layout_constraintBottom_toBottomOf="@+id/scoreTv"
            app:layout_constraintStart_toEndOf="@+id/scoreTv" />

        <TextView
            style="@style/TextPurple_300.ExtraBold"
            android:id="@+id/reportTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginBottom="2dp"
            android:textSize="@dimen/sp18"
            android:text="보고서 보기 &gt;"
            app:layout_constraintStart_toEndOf="@+id/scoreLabel"
            app:layout_constraintBottom_toBottomOf="@+id/scoreLabel"/>

        <TextView
            style="@style/TextGray_500"
            android:id="@+id/contentTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp24"
            android:lineSpacingExtra="8sp"
            android:textSize="@dimen/sp18"
            android:text="이번주 주간 테스트를 완료했습니다!\n자세한 내용은 보고서에서 확인해주세요 :)"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/settingContainerCl" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settingContainerCl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp90"
            android:background="@drawable/bg_gray_100_stroke_gray_300_ripple"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@+id/scoreTv"
            app:layout_constraintBottom_toTopOf="@+id/startBtn"
            app:layout_constraintVertical_chainStyle="packed">

            <TextView
                style="@style/TextGray_500.Bold"
                android:id="@+id/levelLabel"
                android:layout_marginTop="@dimen/dp32"
                android:layout_marginStart="@dimen/dp32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="난이도 :"
                android:textSize="@dimen/sp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                style="@style/TextGray_800.Bold"
                android:id="@+id/levelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:layout_marginStart="8dp"
                android:text="고난도 위주"
                app:layout_constraintStart_toEndOf="@+id/levelLabel"
                app:layout_constraintTop_toTopOf="@+id/levelLabel"
                app:layout_constraintBottom_toBottomOf="@+id/levelLabel"/>

            <TextView
                style="@style/TextGray_500.Bold"
                android:id="@+id/rangeLabel"
                android:layout_marginStart="@dimen/dp32"
                android:layout_marginBottom="@dimen/dp32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:text="출제 범위 :"
                android:textSize="@dimen/sp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/levelLabel"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                style="@style/TextGray_800.Bold"
                android:id="@+id/rangeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:layout_marginStart="8dp"
                android:text="선행 단원 함께"
                app:layout_constraintStart_toEndOf="@+id/rangeLabel"
                app:layout_constraintTop_toTopOf="@+id/rangeLabel"
                app:layout_constraintBottom_toBottomOf="@+id/rangeLabel"/>

            <ImageButton
                android:id="@+id/settingBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_gear"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                android:background="@drawable/bg_white_stroke_gray_300_round"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>



        <com.freewheelin.pulley.revision2023.ui.view.CommonButton
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:layout_marginTop="@dimen/dp56"
            android:text="시작하기"
            android:visibility="invisible"
            android:textSize="@dimen/sp18"
            app:layout_constraintTop_toBottomOf="@+id/settingContainerCl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fullClearCl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/gray_100"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="@+id/settingContainerCl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/startBtn">


            <TextView
                style="@style/TextGray_600.Bold"
                android:id="@+id/finishLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp18"
                android:lineSpacingExtra="8sp"
                android:layout_marginTop="@dimen/dp64"
                android:visibility="visible"
                android:layout_marginStart="@dimen/dp32"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/durationLabel"
                android:text="이번주 주간테스트 범위"
                app:layout_constraintVertical_chainStyle="packed"/>

            <TextView
                style="@style/TextGray_500.Bold"
                android:id="@+id/durationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:text="기간 :"
                android:layout_marginTop="@dimen/dp32"
                app:layout_constraintStart_toStartOf="@+id/finishLabel"
                app:layout_constraintTop_toBottomOf="@+id/finishLabel"/>

            <TextView
                style="@style/TextGray_500.Bold"
                android:id="@+id/durationTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                tools:text="7월 30일 - 8월 4일"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/durationLabel"
                app:layout_constraintTop_toTopOf="@+id/durationLabel"
                app:layout_constraintBottom_toBottomOf="@+id/durationLabel"/>

            <TextView
                style="@style/TextGray_500.Bold"
                android:id="@+id/coverLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:text="범위 :"
                android:layout_marginTop="@dimen/dp32"
                app:layout_constraintTop_toBottomOf="@+id/durationLabel"
                app:layout_constraintStart_toStartOf="@+id/durationLabel"/>

            <TextView
                style="@style/TextGray_500.Bold"
                android:id="@+id/coverTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:text="범위 :"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/coverLabel"
                app:layout_constraintTop_toTopOf="@+id/coverLabel"
                app:layout_constraintBottom_toBottomOf="@+id/coverLabel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>