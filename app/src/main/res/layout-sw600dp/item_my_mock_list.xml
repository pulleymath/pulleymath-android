            <LinearLayout
                android:id="@+id/remainBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_purple_300_gray_400_round"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/reviewBtn"
                app:layout_constraintStart_toStartOf="@+id/reportBtn"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/remainCountText"
                    style="@style/TextPurple_200.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0문항 남음"
                    android:textSize="@dimen/sp12" />

                <TextView
                    style="@style/TextWhite.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="이어 풀기"
                    android:textSize="@dimen/sp16" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/horizontalBorder"
            style="@style/Border_Gray_300_Horizontal"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/dp32"
            android:layout_marginEnd="@dimen/dp32"
