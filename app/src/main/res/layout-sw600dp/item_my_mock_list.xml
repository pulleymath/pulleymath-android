<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outContainerCl"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp64"
    android:background="@drawable/bg_shadow_middle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerCl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp64"
        android:paddingStart="@dimen/dp32"
        android:paddingEnd="@dimen/dp32"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/dateTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="@dimen/dp64"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="학습 날짜"
            android:textSize="@dimen/sp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/gradeTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="@dimen/dp56"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            android:gravity="center"
            android:text="학년"
            android:textSize="@dimen/sp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dateTv"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/typeTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="@dimen/dp56"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            android:gravity="center"
            android:text="계열"
            android:textSize="@dimen/sp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/gradeTv"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titleTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            android:text="제목"
            android:textSize="@dimen/sp16"
            app:layout_constraintBottom_toTopOf="@+id/optionContainer8inch"
            app:layout_constraintStart_toEndOf="@+id/typeTv"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <LinearLayout
            android:id="@+id/optionContainer8inch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/typeTv"
            app:layout_constraintTop_toBottomOf="@+id/titleTv" />

        <LinearLayout
            android:id="@+id/optionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/titleTv"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/correctPercentContainer"
            android:layout_width="@dimen/dp96"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp16"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/scoreTv"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/correctPercentTv"
                style="@style/TextBlack_4c4c4c.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:gravity="end"
                android:text="100%"
                android:textSize="@dimen/sp16" />

            <TextView
                android:id="@+id/correctCountTv"
                style="@style/TextGrey_c0c0c0.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="21/30"
                android:textSize="@dimen/sp14" />

        </LinearLayout>

        <TextView
            android:id="@+id/scoreTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="@dimen/dp64"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp16"
            android:gravity="center"
            android:text="점수"
            android:textSize="@dimen/sp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/percentageTv"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/percentageTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="@dimen/dp64"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp16"
            android:gravity="center"
            android:text="백분위"
            android:textSize="@dimen/sp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ratingTv"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ratingTv"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="@dimen/dp64"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp16"
            android:gravity="center"
            android:text="등급"
            android:textSize="@dimen/sp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reportBtn"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ratingIv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ratingTv"
            app:layout_constraintEnd_toEndOf="@+id/ratingTv"
            app:layout_constraintStart_toStartOf="@+id/ratingTv"
            app:layout_constraintTop_toTopOf="@+id/ratingTv" />

        <com.freewheelin.pulley.views.buttons.SecondaryButton
            android:id="@+id/reportBtn"
            android:layout_width="@dimen/dp80"
            android:layout_height="36dp"
            android:layout_marginEnd="@dimen/dp16"
            android:text="보고서"
            app:buttonTheme="grey"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reviewBtn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.freewheelin.pulley.views.buttons.SecondaryButton
            android:id="@+id/reviewBtn"
            android:layout_width="@dimen/dp80"
            android:layout_height="36dp"
            android:text="리뷰"
            app:buttonTheme="blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/remainBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_purple_6d6dff_grey_e0e0e0_round"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/reviewBtn"
            app:layout_constraintStart_toStartOf="@+id/reportBtn"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/remainCountText"
                style="@style/TextPurple_acacff.ExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0문항"
                android:textSize="@dimen/sp12" />

            <TextView
                style="@style/TextWhite_ffffff.ExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="이어 풀기"
                android:textSize="@dimen/sp16" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/horizontalBorder"
        style="@style/Border_Grey_e8e8e8_Horizontal"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/dp32"
        android:layout_marginEnd="@dimen/dp32"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>