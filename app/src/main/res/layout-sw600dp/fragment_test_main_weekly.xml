<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp64"
        android:paddingEnd="@dimen/dp64"
        tools:context="com.freewheelin.pulley.activities.learning.tabFragment.snackTest.TestMainWeeklyFragment">

        <TextView
            android:id="@+id/headerTv"
            style="@style/TextBlack_4c4c4c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이번주 점검을 위한"
            android:textSize="@dimen/sp24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/titleTv"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView
            android:id="@+id/titleTv"
            style="@style/TextBlack_4c4c4c.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="주간 테스트"
            android:textSize="@dimen/sp36"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerTv"
            app:layout_constraintBottom_toTopOf="@+id/settingContainerCl"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView
            style="@style/TextGrey_c0c0c0"
            android:id="@+id/contentTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp24"
            android:lineSpacingExtra="8sp"
            android:textSize="@dimen/sp18"
            android:text="주간 테스트는 이번 주 ㅇㅇ님이 학습한 범위 내에서 출제됩니다."
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/settingContainerCl"

            app:layout_constraintVertical_chainStyle="packed"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settingContainerCl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp120"
            android:background="@drawable/bg_white_fafafa_stroke_grey_e8e8e8"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"
            app:layout_constraintBottom_toTopOf="@+id/timerGuideTv"
            app:layout_constraintVertical_chainStyle="packed">

            <TextView
                style="@style/TextGrey_c0c0c0.Bold"
                android:id="@+id/levelLabel"
                android:layout_marginTop="@dimen/dp32"
                android:layout_marginStart="@dimen/dp32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="난이도 :"
                android:textSize="@dimen/sp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                style="@style/TextBlack_4c4c4c.Bold"
                android:id="@+id/levelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:layout_marginStart="8dp"
                android:text="고난도 위주"
                app:layout_constraintStart_toEndOf="@+id/levelLabel"
                app:layout_constraintTop_toTopOf="@+id/levelLabel"
                app:layout_constraintBottom_toBottomOf="@+id/levelLabel"/>

            <TextView
                style="@style/TextGrey_c0c0c0.Bold"
                android:id="@+id/rangeLabel"
                android:layout_marginStart="@dimen/dp32"
                android:layout_marginBottom="@dimen/dp32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:text="출제 범위 :"
                android:textSize="@dimen/sp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/levelLabel"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                style="@style/TextBlack_4c4c4c.Bold"
                android:id="@+id/rangeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:layout_marginStart="8dp"
                android:text="선행 단원 함께"
                app:layout_constraintStart_toEndOf="@+id/rangeLabel"
                app:layout_constraintTop_toTopOf="@+id/rangeLabel"
                app:layout_constraintBottom_toBottomOf="@+id/rangeLabel"/>

            <ImageButton
                android:id="@+id/settingBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_gear"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8_round"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
            style="@style/TextRed_fe7b67.Bold"
            android:id="@+id/timerGuideTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이 시간이 지나면 풀 수 없어요!"
            android:layout_marginTop="@dimen/dp64"
            android:layout_marginBottom="@dimen/dp12"
            android:textSize="@dimen/sp16"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/startBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/settingContainerCl"
            app:layout_constraintVertical_chainStyle="packed"/>


        <com.freewheelin.pulley.views.buttons.PrimaryButton
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp56"
            android:text="시작하기"
            android:visibility="invisible"
            app:buttonTheme="blue"
            app:ButtonTextSize="@dimen/sp18"
            app:layout_constraintTop_toBottomOf="@+id/timerGuideTv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>