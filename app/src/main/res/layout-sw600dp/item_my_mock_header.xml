<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_shadow_top">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp32"
            android:paddingStart="@dimen/dp36"
            android:paddingEnd="@dimen/dp32"
            app:layout_constraintTop_toTopOf="parent">

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/dateSl"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="@dimen/dp64"
                android:layout_height="wrap_content"
                app:label="날짜"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/gradeSl"
                android:layout_width="@dimen/dp56"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                app:label="학년"
                app:layout_constraintTop_toTopOf="@+id/dateSl"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintStart_toEndOf="@+id/dateSl" />

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/typeSl"
                android:layout_width="@dimen/dp56"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                app:label="계열"
                app:layout_constraintTop_toTopOf="@+id/dateSl"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintStart_toEndOf="@+id/gradeSl" />

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/examTitleSl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                app:label="제목"
                app:layout_constraintTop_toTopOf="@+id/dateSl"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintStart_toEndOf="@+id/typeSl"/>

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/percentSl"
                android:layout_width="@dimen/dp80"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp16"
                app:label="정답률"
                app:layout_constraintTop_toTopOf="@+id/dateSl"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintEnd_toStartOf="@+id/scoreSl"/>

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/scoreSl"
                android:layout_width="@dimen/dp64"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp16"
                app:label="점수"
                app:layout_constraintTop_toTopOf="@+id/dateSl"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintEnd_toStartOf="@+id/percentageSl"/>

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/percentageSl"
                android:layout_width="@dimen/dp64"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp16"
                app:label="백분위"
                app:layout_constraintTop_toTopOf="@+id/ratingSl"
                app:layout_constraintBottom_toBottomOf="@+id/ratingSl"
                app:layout_constraintEnd_toStartOf="@+id/ratingSl"/>

            <com.freewheelin.pulley.views.textViews.SortableTextView
                android:id="@+id/ratingSl"
                android:layout_width="@dimen/dp64"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp16"
                app:label="등급"
                android:textColor="@color/grey_818181"
                app:layout_constraintTop_toTopOf="@+id/dateSl"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintEnd_toStartOf="@+id/reportContainer"/>

            <View
                android:id="@+id/reportContainer"
                android:layout_width="90dp"
                android:layout_height="@dimen/dp36"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintEnd_toStartOf="@+id/reviewContainer"
                app:layout_constraintTop_toTopOf="@+id/dateSl" />

            <View
                android:id="@+id/reviewContainer"
                android:layout_width="90dp"
                android:layout_height="@dimen/dp36"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintTop_toTopOf="@+id/dateSl"
                app:layout_constraintBottom_toBottomOf="@+id/dateSl"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            style="@style/Border_Grey_e8e8e8_Horizontal"
            android:layout_marginStart="@dimen/dp32"
            android:layout_marginEnd="@dimen/dp32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>