<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/dp32"
    android:background="@drawable/bg_gray_100_round_ripple"
    android:clickable="true"
    android:focusable="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number8Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="8"
        android:textSize="@dimen/sp24"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toRightOf="@+id/number7Btn"
        app:layout_constraintRight_toLeftOf="@+id/number9Btn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/number5Btn"/>

    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number5Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="5"
        android:textSize="@dimen/sp24"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/number8Btn"
        app:layout_constraintRight_toRightOf="@+id/number8Btn"
        app:layout_constraintTop_toBottomOf="@+id/number8Btn"
        app:layout_constraintBottom_toTopOf="@+id/number2Btn"/>

    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number2Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="2"
        android:textSize="@dimen/sp24"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/number8Btn"
        app:layout_constraintRight_toRightOf="@+id/number8Btn"
        app:layout_constraintTop_toBottomOf="@+id/number5Btn"
        app:layout_constraintBottom_toTopOf="@+id/deleteBtn"/>

    <ImageButton
        style="@style/Keypad_btn"
        android:id="@+id/deleteBtn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_keypad_delete"
        app:layout_constraintLeft_toLeftOf="@+id/number3Btn"
        app:layout_constraintRight_toRightOf="@+id/number3Btn"
        app:layout_constraintTop_toBottomOf="@+id/number2Btn"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number7Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="7"
        android:textSize="@dimen/sp24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/number8Btn"
        app:layout_constraintTop_toTopOf="@+id/number8Btn"
        app:layout_constraintBottom_toBottomOf="@+id/number8Btn" />

    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number4Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="4"
        android:textSize="@dimen/sp24"
        app:layout_constraintLeft_toLeftOf="@+id/number7Btn"
        app:layout_constraintRight_toRightOf="@+id/number7Btn"
        app:layout_constraintTop_toTopOf="@+id/number5Btn"
        app:layout_constraintBottom_toBottomOf="@+id/number5Btn" />



    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number1Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="1"
        android:textSize="@dimen/sp24"
        app:layout_constraintLeft_toLeftOf="@+id/number7Btn"
        app:layout_constraintRight_toRightOf="@+id/number7Btn"
        app:layout_constraintTop_toTopOf="@+id/number2Btn"
        app:layout_constraintBottom_toBottomOf="@+id/number2Btn" />

    <ImageButton
        style="@style/Keypad_btn"
        android:id="@+id/plusMinusBtn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_minus_plus"
        app:layout_constraintLeft_toLeftOf="@+id/number1Btn"
        app:layout_constraintRight_toRightOf="@+id/number1Btn"
        app:layout_constraintTop_toTopOf="@+id/deleteBtn"
        app:layout_constraintBottom_toBottomOf="@+id/deleteBtn"/>


    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number0Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textSize="@dimen/sp24"
        app:layout_constraintLeft_toLeftOf="@+id/number8Btn"
        app:layout_constraintRight_toRightOf="@+id/number8Btn"
        app:layout_constraintTop_toTopOf="@+id/deleteBtn"
        app:layout_constraintBottom_toBottomOf="@+id/deleteBtn" />

    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number9Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="9"
        android:textSize="@dimen/sp24"
        app:layout_constraintLeft_toRightOf="@+id/number8Btn"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/number8Btn"
        app:layout_constraintBottom_toBottomOf="@+id/number8Btn" />

    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number6Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="6"
        android:textSize="@dimen/sp24"
        app:layout_constraintLeft_toLeftOf="@+id/number9Btn"
        app:layout_constraintRight_toRightOf="@+id/number9Btn"
        app:layout_constraintTop_toTopOf="@+id/number5Btn"
        app:layout_constraintBottom_toBottomOf="@+id/number5Btn" />


    <Button
        style="@style/Keypad_btn"
        android:id="@+id/number3Btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="3"
        android:textSize="@dimen/sp24"
        app:layout_constraintLeft_toLeftOf="@+id/number6Btn"
        app:layout_constraintRight_toRightOf="@+id/number6Btn"
        app:layout_constraintTop_toTopOf="@+id/number2Btn"
        app:layout_constraintBottom_toBottomOf="@+id/number2Btn" />

</androidx.constraintlayout.widget.ConstraintLayout>