<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.freewheelin.pulley.activities.learning.tabFragment.analysis.StudyHistoryActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp64"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_black_left"
                android:padding="@dimen/dp32"
                android:background="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <TextView
                style="@style/TextGray_800.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp18"
                android:text="학습 내역"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <View
                style="@style/Border_Gray_300_Horizontal"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shadow_clear"
            android:layout_margin="@dimen/dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBar">

            <com.freewheelin.pulley.views.DaebakTabRadio
                android:id="@+id/categoryTab"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp42"
                android:layout_marginTop="@dimen/dp48"
                android:layout_marginStart="@dimen/dp48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabWidth="@dimen/dp96" />

            <com.freewheelin.pulley.views.DaebakTabRadio
                android:id="@+id/ingTab"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp42"
                android:layout_marginStart="@dimen/dp32"
                app:layout_constraintStart_toEndOf="@+id/categoryTab"
                app:layout_constraintTop_toTopOf="@+id/categoryTab"
                app:layout_constraintBottom_toBottomOf="@+id/categoryTab"
                app:tabWidth="@dimen/dp96" />


            <LinearLayout
                android:id="@+id/topHeaderView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:layout_marginStart="@dimen/dp48"
                android:layout_marginEnd="@dimen/dp48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/categoryTab">

                <TextView
                    style="@style/TextGray_600.Bold"
                    android:layout_width="@dimen/dp72"
                    android:layout_height="@dimen/dp56"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:textSize="@dimen/sp16"
                    android:text="날짜" />

                <TextView
                    style="@style/TextGray_600.Bold"
                    android:layout_width="@dimen/dp60"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginStart="@dimen/dp16"
                    android:gravity="center"
                    android:text="분류"
                    android:textSize="@dimen/sp16" />

                <TextView
                    style="@style/TextGray_600.Bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="제목"
                    android:layout_weight="1"
                    android:textSize="@dimen/sp16"
                    android:layout_marginStart="@dimen/dp16"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/problemCntContainer"
                    android:layout_width="@dimen/dp144"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/dp16">

                    <TextView
                        android:id="@+id/problemCntLabel"
                        style="@style/TextGray_600.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="푼 문제/전체 문제"
                        android:textSize="@dimen/sp16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    style="@style/TextGray_600.Bold"
                    android:layout_width="@dimen/dp64"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="정답률"
                    android:textSize="@dimen/sp16" />

                <View
                    android:layout_width="@dimen/dp36"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/dp16"/>

                <View
                    android:layout_width="@dimen/dp120"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/dp16"/>
            </LinearLayout>

            <View
                android:id="@+id/view3"
                style="@style/Border_Gray_300_Horizontal"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="@+id/topHeaderView"
                app:layout_constraintStart_toStartOf="@+id/topHeaderView"
                app:layout_constraintTop_toBottomOf="@+id/topHeaderView" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingStart="@dimen/dp48"
                android:paddingEnd="@dimen/dp48"
                app:layout_constraintTop_toBottomOf="@+id/topHeaderView"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                style="@style/TextGray_500.Bold"
                android:id="@+id/emptyGuideTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:lineSpacingExtra="8sp"
                android:gravity="center"
                android:text="학습 데이터가 없습니다.\n&lt;테스트&gt; &lt;유형학습&gt; &lt;모의고사&gt; 탭에서 학습을 진행할 수 있어요."
                app:layout_constraintStart_toStartOf="@+id/recyclerView"
                app:layout_constraintEnd_toEndOf="@+id/recyclerView"
                app:layout_constraintBottom_toBottomOf="@+id/recyclerView"
                app:layout_constraintTop_toTopOf="@+id/recyclerView"/>

            <View
                android:id="@+id/viewShadow"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:background="@drawable/gradient_shadow_under_list_header"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="@+id/topHeaderView"
                app:layout_constraintStart_toStartOf="@+id/topHeaderView"
                app:layout_constraintTop_toBottomOf="@+id/view3" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>