<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp64"
    android:background="@drawable/bg_shadow_middle">

    <TextView
        android:id="@+id/yearTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp64"
        android:layout_height="match_parent"
        android:layout_marginStart="36dp"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2021년" />

    <TextView
        android:id="@+id/monthTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp56"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp16"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/yearTv"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12월" />


    <TextView
        android:id="@+id/gradeTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp56"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp16"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/monthTv"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="고1" />


    <TextView
        android:id="@+id/typeTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="@dimen/dp56"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp16"
        android:gravity="center"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gradeTv"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="계열" />


    <TextView
        android:id="@+id/titleTv"
        style="@style/TextBlack_4c4c4c.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp20"
        android:textSize="@dimen/sp16"
        app:layout_constraintBottom_toBottomOf="@+id/typeTv"
        app:layout_constraintStart_toEndOf="@+id/typeTv"
        app:layout_constraintTop_toTopOf="@+id/typeTv"
        tools:text="제목" />


    <TextView
        android:id="@+id/updateTag"
        style="@style/TextWhite_ffffff.ExtraBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_red_fe7b67_capsule"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="신규"
        android:textColor="@color/color_white_ffffff"
        android:textSize="@dimen/sp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/titleTv"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/horizontalBorder"
        style="@style/Border_Grey_e8e8e8_Horizontal"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.freewheelin.pulley.views.buttons.PrimaryButton
        android:id="@+id/testBtn"
        android:layout_width="@dimen/primaryBtn_width_96dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/dp40"
        android:text="풀기"
        android:textSize="16sp"
        app:buttonTheme="blue"
        app:layout_constraintBottom_toBottomOf="@id/yearTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/yearTv" />

</androidx.constraintlayout.widget.ConstraintLayout>