<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_white_fafafa_round"
        android:layout_width="792dp"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topContainerCl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp80"
            android:background="@drawable/bg_white_ffffff_round_top_only"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>


    <!--    <com.freewheelin.pulley.views.CalendarPickerViews.RangeRadioButton-->
    <!--        android:id="@+id/selectRangeBtn"-->
    <!--        style="@style/TextBlack_4c4c4c.Bold"-->
    <!--        android:layout_width="96dp"-->
    <!--        android:layout_height="36dp"-->
    <!--        android:layout_marginEnd="26dp"-->
    <!--        android:padding="0dp"-->
    <!--        android:text="기간 선택"-->
    <!--        android:textSize="@dimen/sp18"-->
    <!--        app:layout_constraintBottom_toBottomOf="@+id/topContainerCl"-->
    <!--        app:layout_constraintEnd_toStartOf="@+id/aWeekRangeBtn"-->
    <!--        app:layout_constraintHorizontal_chainStyle="packed"-->
    <!--        app:layout_constraintStart_toStartOf="@+id/topContainerCl"-->
    <!--        app:layout_constraintTop_toTopOf="@+id/topContainerCl" />-->

        <com.freewheelin.pulley.views.calendarPickerViews.RangeRadioButton
            android:id="@+id/aWeekRangeBtn"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="96dp"
            android:layout_height="36dp"
            android:layout_marginEnd="26dp"
            android:padding="0dp"
            android:text="최근 7일"
            android:textSize="@dimen/sp18"
            app:layout_constraintBottom_toBottomOf="@+id/topContainerCl"
            app:layout_constraintEnd_toStartOf="@+id/twoWeeksRangeBtn"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/topContainerCl"
            app:layout_constraintTop_toTopOf="@+id/topContainerCl" />

        <com.freewheelin.pulley.views.calendarPickerViews.RangeRadioButton
            android:id="@+id/twoWeeksRangeBtn"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="96dp"
            android:layout_height="36dp"
            android:layout_marginEnd="26dp"
            android:padding="0dp"
            android:text="최근 14일"
            android:textSize="@dimen/sp18"
            app:layout_constraintBottom_toBottomOf="@+id/topContainerCl"
            app:layout_constraintEnd_toStartOf="@+id/aMonthBtn"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/aWeekRangeBtn"
            app:layout_constraintTop_toTopOf="@+id/topContainerCl" />

        <com.freewheelin.pulley.views.calendarPickerViews.RangeRadioButton
            android:id="@+id/aMonthBtn"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="96dp"
            android:layout_height="36dp"
            android:layout_marginEnd="26dp"
            android:padding="0dp"
            android:text="최근 30일"
            android:textSize="@dimen/sp18"
            app:layout_constraintBottom_toBottomOf="@+id/topContainerCl"
            app:layout_constraintEnd_toStartOf="@+id/selectRangeBtn"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/twoWeeksRangeBtn"
            app:layout_constraintTop_toTopOf="@+id/topContainerCl" />

        <com.freewheelin.pulley.views.calendarPickerViews.RangeRadioButton
            android:id="@+id/selectRangeBtn"
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="96dp"
            android:layout_height="36dp"
            android:padding="0dp"
            android:text="기간 선택"
            android:textSize="@dimen/sp18"
            app:layout_constraintBottom_toBottomOf="@+id/topContainerCl"
            app:layout_constraintEnd_toEndOf="@+id/topContainerCl"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/aMonthBtn"
            app:layout_constraintTop_toTopOf="@+id/topContainerCl" />

        <View
            style="@style/Border_Grey_e8e8e8_Horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/topContainerCl"
            app:layout_constraintEnd_toEndOf="@+id/topContainerCl"
            app:layout_constraintStart_toStartOf="@+id/topContainerCl" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/fromCalendar"
            app:layout_constraintEnd_toEndOf="@+id/fromCalendar"
            app:layout_constraintStart_toStartOf="@+id/fromCalendar" />



        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:id="@+id/fromCalendarHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp32"
            android:layout_marginBottom="@dimen/dp16"
            android:text="시작 날짜 선택"
            android:textSize="@dimen/sp18"
            app:layout_constraintTop_toBottomOf="@+id/topContainerCl"
            app:layout_constraintEnd_toEndOf="@+id/fromCalendar"
            app:layout_constraintStart_toStartOf="@+id/fromCalendar" />

        <com.freewheelin.pulley.views.calendarPickerViews.DaebakCalendar
            android:id="@+id/fromCalendar"
            android:layout_width="0dp"
            android:layout_height="322dp"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
            app:layout_constraintEnd_toStartOf="@+id/toCalendar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fromCalendarHeader"/>

        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp32"
            android:layout_marginBottom="@dimen/dp16"
            android:text="마지막 날짜 선택"
            android:textSize="@dimen/sp18"
            app:layout_constraintTop_toBottomOf="@+id/topContainerCl"
            app:layout_constraintBottom_toTopOf="@+id/toCalendar"
            app:layout_constraintEnd_toEndOf="@+id/toCalendar"
            app:layout_constraintStart_toStartOf="@+id/toCalendar" />

        <com.freewheelin.pulley.views.calendarPickerViews.DaebakCalendar
            android:id="@+id/toCalendar"
            android:layout_width="0dp"
            android:layout_height="322dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_white_ffffff_stroke_grey_e8e8e8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/fromCalendar"
            app:layout_constraintTop_toTopOf="@+id/fromCalendar"/>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomContainerCl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp80"
            android:background="@color/white_ffffff"
            android:layout_marginTop="@dimen/dp32"
            app:layout_constraintTop_toBottomOf="@+id/toCalendar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                style="@style/Border_Grey_e8e8e8_Horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/rangeGuideTv"
                style="@style/TextGrey_c0c0c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:textSize="@dimen/sp14"
                android:text="2018.07.10 - 2018.08.23"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cancelBtn"
                app:layout_constraintTop_toTopOf="parent" />

            <com.freewheelin.pulley.views.buttons.PrimaryButton
                android:id="@+id/updateBtn"
                style="@style/Btn_Blue.Primary.L"
                android:layout_width="160dp"
                android:layout_height="@dimen/dp48"
                android:layout_marginEnd="32dp"
                android:text="업데이트"
                android:textSize="16sp"
                app:buttonTheme="blue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.freewheelin.pulley.views.buttons.SecondaryButton
                android:id="@+id/cancelBtn"
                style="@style/Btn_Grey.Secondary.L"
                android:layout_width="104dp"
                android:layout_height="@dimen/dp48"
                android:layout_marginEnd="8dp"
                android:text="취소"
                android:textSize="16sp"
                app:buttonTheme="grey"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/updateBtn"
                app:layout_constraintTop_toTopOf="parent" />'

        </androidx.constraintlayout.widget.ConstraintLayout>


        <com.freewheelin.pulley.views.DaebakToastView
            android:id="@+id/toastView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="88dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>