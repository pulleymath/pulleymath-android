<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerCl"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:id="@+id/clearGuideTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp16"
            android:text="전체 n문제 중 n개 클리어"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            style="@style/TextBlack_4c4c4c.Bold"
            android:id="@+id/problemCntTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="@dimen/sp24"
            android:text="56개의 문제가 있습니다."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clearGuideTv"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/columnView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/dp32"
            android:background="@drawable/bg_grey_f2f2f2_stroke_grey_e8e8e8_round"
            app:layout_constraintTop_toBottomOf="@+id/problemCntTv">

            <CheckBox
                android:id="@+id/checkBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:button="@drawable/checkbox_blue_white_bg"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                style="@style/TextBlack_4c4c4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="@dimen/sp16"
                android:text="전체 선택"
                app:layout_constraintTop_toTopOf="@+id/checkBox"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox"
                app:layout_constraintStart_toEndOf="@+id/checkBox"/>

            <Button
                style="@style/TextBlack_4c4c4c"
                android:id="@+id/levelOrder"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:padding="0dp"
                android:textSize="@dimen/sp16"
                android:text="난이도순"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"/>
            <View
                style="@style/Border_Grey_e8e8e8_Vertical"
                android:layout_height="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/levelOrder"/>

            <Button
                style="@style/TextBlack_4c4c4c"
                android:id="@+id/subjectOrder"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:padding="0dp"
                android:textSize="@dimen/sp16"
                android:text="과목순"
                app:layout_constraintEnd_toStartOf="@+id/levelOrder"/>

            <View
                style="@style/Border_Grey_e8e8e8_Vertical"
                android:layout_height="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/subjectOrder"/>

            <Button
                style="@style/TextBlack_4c4c4c"
                android:id="@+id/oldOrder"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:padding="0dp"
                android:textSize="@dimen/sp16"
                android:text="오래된순"
                app:layout_constraintEnd_toStartOf="@+id/subjectOrder"/>

            <View
                style="@style/Border_Grey_e8e8e8_Vertical"
                android:layout_height="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/oldOrder"/>

            <Button
                style="@style/TextBlack_4c4c4c"
                android:id="@+id/recentOrder"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:padding="0dp"
                android:textSize="@dimen/sp16"
                android:text="최신순"
                app:layout_constraintEnd_toStartOf="@+id/oldOrder"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/guideView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/columnView"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/guideIv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/guide_empty_wrong"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/guideTv"
                app:layout_constraintVertical_chainStyle="packed"/>

            <TextView
                style="@style/TextGrey_c0c0c0.Bold"
                android:id="@+id/guideTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp16"
                android:layout_marginTop="@dimen/dp24"
                android:gravity="center"
                android:text="즐겨찾기한 문제가 이곳에 모여요!\n다시 보고 싶거나, 중요하다고 생각한 문제를 모아보세요 :)"
                android:lineSpacingExtra="8sp"
                app:layout_constraintTop_toBottomOf="@+id/guideIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>